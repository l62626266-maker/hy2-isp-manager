# ---------------- 节点生命周期 ----------------
# 0.2 版只有创建/改端口/删除，节点起不来或被人手动停掉后没有任何恢复入口。
node_service_state() { systemctl is-active "$1" 2>/dev/null || true; }

start_node() {
  load_manager; local id=${1:-}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  if [[ $(node_service_state "$SERVICE") == active ]]; then ok "$NAME 已在运行。"; return 0; fi
  start_checked "$SERVICE" "$LISTEN_PORT" || die "启动失败，已输出最近日志。"
  ok "$NAME 已启动。"
}

stop_node() {
  load_manager; local id=${1:-}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  if [[ $(node_service_state "$SERVICE") != active ]]; then ok "$NAME 本来就没在运行。"; return 0; fi
  confirm "停止 $NAME？已连接的客户端会立即断连。" || return 0
  systemctl stop "$SERVICE" || die "停止失败。"
  ok "$NAME 已停止；服务仍是开机自启状态，重启后会重新启动。"
}

restart_node() {
  load_manager; local id=${1:-}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  start_checked "$SERVICE" "$LISTEN_PORT" || die "重启失败，已输出最近日志。"
  ok "$NAME 已重启。"
}

# ---------------- 交互层：单屏面板 ----------------
# 约束：
#   * 只用 bash 内建 + ANSI；中文对齐借用 python3（本脚本本来已依赖 python3）。
#   * 非 TTY、TERM=dumb、窗口过小、或 HY2M_UI=plain 时，一律退回原有数字菜单，行为逐字节不变。
UI_MIN_COLS=70
UI_MIN_ROWS=14
UI_CERT_TEXT=""

ui_requested() {
  [[ ${HY2M_UI:-tui} == tui ]] || return 1
  is_tty || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  [[ ${TERM:-dumb} != dumb ]] || return 1
  local cols rows
  cols=$(tput cols 2>/dev/null || printf 80)
  rows=$(tput lines 2>/dev/null || printf 24)
  [[ $cols =~ ^[0-9]+$ && $rows =~ ^[0-9]+$ ]] || return 1
  (( cols >= UI_MIN_COLS && rows >= UI_MIN_ROWS ))
}

ui_init_colors() {
  if [[ -n ${NO_COLOR:-} || ${TERM:-dumb} == dumb ]]; then
    C_RESET=""; C_BLUE=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_DIM=""; C_BOLD=""
  else
    C_RESET=$'\033[0m'; C_BLUE=$'\033[1;34m'; C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  fi
}

# 画框：argv1=内宽 argv2=标题；stdin 为逐行 "T<TAB>正文" 或 "R<TAB>列1<TAB>列2…"。
# 宽度计算跳过 ANSI 序列，中文按双宽处理，超宽按显示宽度截断。
ui_box() {
  python3 -c '
import sys, io, re, unicodedata
sys.stdin = io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="replace")
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
ANSI = re.compile("\x1b\\[[0-9;]*m")
width = int(sys.argv[1]); title = sys.argv[2]
def cw(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
def dw(s):
    return sum(cw(c) for c in ANSI.sub("", s))
def cut(s, n):
    out, acc, i = [], 0, 0
    while i < len(s):
        m = ANSI.match(s, i)
        if m:
            out.append(m.group(0)); i = m.end(); continue
        w = cw(s[i])
        if acc + w > n:
            break
        out.append(s[i]); acc += w; i += 1
    return "".join(out), acc
rows = []
for raw in sys.stdin.read().split("\n"):
    if raw == "":
        continue
    rows.append(raw.split("\t"))
colw = []
for parts in rows:
    if parts[0] != "R":
        continue
    for i, c in enumerate(parts[1:]):
        while len(colw) <= i:
            colw.append(0)
        colw[i] = max(colw[i], dw(c))
t = "─ " + title + " "
fill = max(0, width + 2 - dw(t))
out = ["┌" + t + "─" * fill + "┐"]
for parts in rows:
    kind, cells = parts[0], parts[1:]
    if kind == "R":
        line = ""
        for i, c in enumerate(cells):
            if i:
                line += "  "
            line += c + " " * max(0, colw[i] - dw(c))
    else:
        line = cells[0] if cells else ""
    body, _ = cut(line, width)
    out.append("│ " + body + " " * max(0, width - dw(body)) + " │")
out.append("└" + "─" * (width + 2) + "┘")
sys.stdout.write("\n".join(out) + "\n")
' "$1" "$2"
}

ui_enter_screen() { [[ -t 1 ]] || return 0; tput smcup 2>/dev/null || true; tput civis 2>/dev/null || true; ui_home; }
