# 读单键；方向键归一成 up/down/left/right，Esc 归一成 esc，回车归一成 enter。
ui_readkey() {
  local k k2 k3
  IFS= read -rsn1 k || { printf 'quit'; return 0; }
  if [[ $k == $'\033' ]]; then
    k2=""
    IFS= read -rsn1 -t 0.05 k2 || true
    if [[ $k2 == '[' ]]; then
      k3=""
      IFS= read -rsn1 -t 0.05 k3 || true
      case $k3 in A) printf 'up' ;; B) printf 'down' ;; C) printf 'right' ;; D) printf 'left' ;; *) printf 'esc' ;; esac
      return 0
    fi
    printf 'esc'
    return 0
  fi
  if [[ -z $k || $k == $'\r' || $k == $'\n' ]]; then printf 'enter'; return 0; fi
  printf '%s' "$k"
}

