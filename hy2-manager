}
menu_action() { run_menu_action "$@"; pause_menu; }

service_label() {
  local state
  state=$(systemctl is-active "$1" 2>/dev/null) || true
  case $state in active) printf '运行中' ;; activating) printf '启动中' ;; failed) printf '故障' ;; inactive) printf '已停止' ;; *) printf '未知' ;; esac
}
node_brief() (
  # Isolate state variables from the caller and never print authentication data.
  # shellcheck disable=SC1090
  source "$1"
  printf '%s | %s | UDP %s' "$NAME" "$(service_label "$SERVICE")" "$PUBLIC_PORT"
)
certificate_summary() {
  if command -v hy2-cert-guard >/dev/null 2>&1; then
    hy2-cert-guard status 2>/dev/null || true
  elif [[ -r $TLS_DIR/fullchain.pem ]]; then
    printf '证书到期：'; openssl x509 -in "$TLS_DIR/fullchain.pem" -noout -enddate 2>/dev/null || true
    printf '未安装证书守护；可在证书菜单查看续期定时器。\n'
  else printf '证书：尚无可读状态\n'; fi
}
dashboard() {
  local f count=0
  printf 'HY2 中文管理面板 | %s\n' "$APP_VERSION"
  if load_manager_optional; then printf '域名：%s | 网络：%s\n' "$DOMAIN" "$NETWORK_MODE"; fi
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do node_brief "$f"; printf '\n'; count=$((count+1)); done
  if [[ ! -r $NODE_DIR/direct.env ]] && legacy_direct_available; then
    printf '现有直连（只读兼容） | %s\n' "$(service_label "$LEGACY_SERVICE")"
    count=$((count+1))
  fi
