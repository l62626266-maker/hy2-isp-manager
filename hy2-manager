}

initial_install() {
  [[ ! -e $MANAGER_STATE ]] || die "已经安装，请使用管理菜单。"
  os_check; require_systemd
  log "安装依赖……"; install_packages; ensure_layout; install_hysteria
  local mode="" domain="" public_ip="" cert_mode="" email="" token="" resumed=0
  if [[ -r $INSTALL_SESSION ]] && confirm "检测到未完成的安装进度，是否从域名/证书步骤继续？"; then
    # shellcheck disable=SC1090
    source "$INSTALL_SESSION"
    mode=${INSTALL_MODE:-}; domain=${INSTALL_DOMAIN:-}; public_ip=${INSTALL_PUBLIC_IP:-}; cert_mode=${INSTALL_CERT_MODE:-}; email=${INSTALL_EMAIL:-}
    if [[ $mode =~ ^(normal|nat)$ ]] && valid_domain "$domain" && valid_ipv4 "$public_ip" && [[ $cert_mode =~ ^(http|cloudflare)$ ]] && check_dns "$domain" "$public_ip"; then
      resumed=1; ok "已恢复非敏感安装进度；Token 等秘密不会写入断点文件。"
    else
      warn "保存的进度已失效，将重新填写。"; rm -f "$INSTALL_SESSION"
    fi
  fi
  if ((resumed == 0)); then
    while true; do
      mode=$(choose "网络类型" "请选择 VPS 类型" normal "普通公网 VPS" nat "NAT / 端口映射 VPS") || return $?
      [[ $mode == normal || $mode == nat ]] && break
      warn "网络类型无效，请重新选择。"
    done
    while true; do
      domain=$(ask_valid_domain "域名" "HY2 域名（Cloudflare 必须灰云）" "") || return $?
      if [[ $mode == normal ]]; then
        if ! public_ip=$(get_public_ipv4); then warn "无法获取公网 IPv4。"; confirm "是否重试域名和公网 IP 步骤？" && continue || return 0; fi
      else
        public_ip=$(ask_valid_ipv4 "NAT 公网 IP" "服务商控制台显示的绑定公网 IPv4" "") || return $?
      fi
      if check_dns "$domain" "$public_ip"; then break; fi
      confirm "DNS 检查失败，是否重新填写域名和公网 IP？选择否将返回主菜单。" || return 0
    done
    while true; do
      cert_mode=$(choose "证书" "请选择证书验证方式" http "HTTP-01（需要公网 80→内部80）" cloudflare "Cloudflare DNS-01（适合 NAT）") || return $?
      [[ $cert_mode == http || $cert_mode == cloudflare ]] && break
      warn "证书方式无效，请重新选择。"
    done
    email=$(ask "证书" "Let's Encrypt 邮箱（可以留空）" "") || return $?
    write_env "$INSTALL_SESSION" INSTALL_MODE "$mode" INSTALL_DOMAIN "$domain" INSTALL_PUBLIC_IP "$public_ip" INSTALL_CERT_MODE "$cert_mode" INSTALL_EMAIL "$email"
    ok "已保存非敏感安装进度；失败后可继续，断点文件不保存 Token。"
  fi
  make_backup; configure_network
  if certificate_valid "$domain"; then
    ok "检测到 30 天以上有效期的现有证书，将安全复用。"
  elif [[ $cert_mode == http ]]; then
    while true; do
      if [[ $mode != normal ]] && ! confirm "NAT 模式必须确认公网 TCP 80 → 内部 TCP 80，是否继续？"; then return 0; fi
      certificate_http "$domain" "$email" && break
      confirm "HTTP-01 失败，是否在当前步骤重试？选择否将保留进度并返回主菜单。" || return 0
    done
  elif [[ $cert_mode == cloudflare ]]; then
    while true; do
      token=$(ask_secret "Cloudflare" "请输入仅含 Zone.DNS Edit 权限的 API Token") || return $?
      if [[ -z $token ]]; then warn "Token 不能为空，请重新输入。"; continue; fi
      if certificate_cloudflare "$domain" "$email" "$token"; then unset token; break; fi
      unset token
      confirm "DNS-01 失败，是否重新输入 Token？选择否将保留进度并返回主菜单。" || return 0
    done
  fi
  copy_certificate "$domain"
  write_env "$MANAGER_STATE" INSTALLED_VERSION "$APP_VERSION" DOMAIN "$domain" PUBLIC_IP "$public_ip" NETWORK_MODE "$mode" CERT_MODE "$cert_mode"
  rm -f "$INSTALL_SESSION"
  log "创建 HY2 直连节点……"; create_direct
  if confirm "现在添加 ISP SOCKS5 全局节点？"; then create_isp; fi
  ok "安装完成。运行 hy2 查看菜单（旧命令 hy2-manager 仍可使用）。"
}

install_self() {
  require_root
  local shortcut
  for shortcut in "$SBIN_DIR/hy2" "$BIN_DIR/hy2"; do
