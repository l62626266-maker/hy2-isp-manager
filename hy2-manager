# ---------------- 节点生命周期 ----------------
# 0.2 版只有创建/改端口/删除，节点起不来或被人手动停掉后没有任何恢复入口。
node_service_state() { systemctl is-active "$1" 2>/dev/null || true; }

start_node() {
  load_manager; local id=${1:-}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  if [[ $(node_service_state "$SERVICE") == active ]]; then ok "$NAME 已在运行。"; return 0; fi
  start_checked "$SERVICE" "$LISTEN_PORT" || die "启动失败，已输出最近日志。"
  ok "$NAME 已启动。"
}

stop_node() {
  load_manager; local id=${1:-}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  if [[ $(node_service_state "$SERVICE") != active ]]; then ok "$NAME 本来就没在运行。"; return 0; fi
  confirm "停止 $NAME？已连接的客户端会立即断连。" || return 0
  systemctl stop "$SERVICE" || die "停止失败。"
  ok "$NAME 已停止；服务仍是开机自启状态，重启后会重新启动。"
}

restart_node() {
  load_manager; local id=${1:-}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  start_checked "$SERVICE" "$LISTEN_PORT" || die "重启失败，已输出最近日志。"
  ok "$NAME 已重启。"
}

# 供事务回滚等场景调用的静默重启：不交互、不打印成功信息，也不改变开机自启状态。
restart_node_now() {
  local id=$1 f="$NODE_DIR/$1.env" service port
  [[ -r $f ]] || return 1
  service=$(env_get "$f" SERVICE)
  port=$(env_get "$f" LISTEN_PORT)
  [[ -n $service && -n $port ]] || return 1
  restart_unit_checked "$service" "$port"
}

node_log() {
  load_manager; local id=${1:-} lines=${2:-60}
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  printf '\n%s 最近 %s 行日志（%s）：\n\n' "$NAME" "$lines" "$SERVICE"
  journalctl -u "$SERVICE" -n "$lines" --no-pager || true
  printf '\n只看错误：journalctl -u %s -p err -n 50 --no-pager\n' "$SERVICE"
}

# 流量取 systemd 的累计计数，单位字节；读不到时退回运行时长。
node_traffic() {
  load_manager; local id=${1:-} service active since rx tx
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"
  service=$SERVICE
  active=$(systemctl is-active "$service" 2>/dev/null || true)
  since=$(systemctl show "$service" -p ActiveEnterTimestamp --value 2>/dev/null || true)
  rx=$(systemctl show "$service" -p IPIngressBytes --value 2>/dev/null || true)
  tx=$(systemctl show "$service" -p IPEgressBytes --value 2>/dev/null || true)
  printf '\n%s（%s）\n  状态：%s\n' "$NAME" "$service" "$(service_label "$service")"
  [[ -z $since ]] || printf '  本次启动：%s\n' "$since"
  if [[ $rx =~ ^[0-9]+$ && $tx =~ ^[0-9]+$ && $rx != 18446744073709551615 && $tx != 18446744073709551615 ]]; then
    printf '  累计入站：%s\n  累计出站：%s\n' "$(human_bytes "${rx:-0}")" "$(human_bytes "${tx:-0}")"
  else
    printf '  流量：当前 systemd 未提供计数（需要 v244+ 且开启 IP accounting）。\n'
  fi
  printf '  说明：systemd 计数自本次启动累计，重启服务会清零；这不是运营商账单。\n'
}

human_bytes() {
  local v=${1:-0}
  [[ $v =~ ^[0-9]+$ ]] || { printf '%s' "$v"; return; }
  awk -v b="$v" 'BEGIN{s="B KB MB GB TB PB"; n=split(s,u," "); i=1; while(b>=1024 && i<n){b/=1024; i++} printf (i==1?"%d %s\n":"%.1f %s\n"), b, u[i]}'
}

rename_node() {
  load_manager; local id=${1:-} f new
  [[ -n $id ]] || id=$(select_node) || return $?
  load_node "$id"; f="$NODE_DIR/$id.env"
  new=$(ask_valid_name "重命名 $NAME" "新名称（只影响显示，不改变链接）" "$NAME") || return $?
  [[ $new != "$NAME" ]] || { ok "名称未改变。"; return 0; }
  local tmp; tmp=$(mktemp); cleanup_files+=("$tmp")
  sed "s|^NAME=.*|NAME=$(printf '%q' "$new")|" "$f" >"$tmp"
  install -o root -g root -m 600 "$tmp" "$f"
  # URI 里的 #fragment 是客户端显示名，跟着改，密码和域名不动。
  if [[ -r ${URI_FILE:-} ]]; then
    local utmp; utmp=$(mktemp); cleanup_files+=("$utmp")
    python3 - "$URI_FILE" "$new" >"$utmp" <<'PY'
from pathlib import Path
import sys
from urllib.parse import urlsplit, urlunsplit, quote
path, name = Path(sys.argv[1]), sys.argv[2]
uri = urlsplit(path.read_text(encoding='utf-8').strip())
print(urlunsplit(uri._replace(fragment=name)), end='')
PY
    install -o root -g root -m 600 "$utmp" "$URI_FILE"
  fi
  ok "已重命名为 $new；HY2 链接的密码、端口和域名保持不变。"
}

# ---------------- 交互层：单屏面板 ----------------
# 约束：
#   * 只用 bash 内建 + ANSI；中文对齐借用 python3（本脚本本来已依赖 python3）。
#   * 非 TTY、TERM=dumb、窗口过小、或 HY2M_UI=plain 时，一律退回原有数字菜单，行为逐字节不变。
UI_MIN_COLS=70
UI_MIN_ROWS=14
UI_CERT_TEXT=""
UI_REFRESH_AT=-1
declare -A UI_NODE_CACHE=()

# Both frames reserve eight lines for borders/header/help, plus the last terminal
# row to avoid scrolling. Re-read geometry on every frame and before actions.
ui_dimensions() {
  UI_COLS=$(tput cols 2>/dev/null || printf 80)
  UI_ROWS=$(tput lines 2>/dev/null || printf 24)
  [[ $UI_COLS =~ ^[0-9]{1,6}$ ]] || UI_COLS=1
  [[ $UI_ROWS =~ ^[0-9]{1,6}$ ]] || UI_ROWS=1
  UI_COLS=$((10#$UI_COLS)); UI_ROWS=$((10#$UI_ROWS))
  (( UI_COLS > 0 )) || UI_COLS=1
  (( UI_ROWS > 0 )) || UI_ROWS=1
  UI_WIDTH=$((UI_COLS - 6))
  (( UI_WIDTH <= 72 )) || UI_WIDTH=72
  (( UI_WIDTH >= 0 )) || UI_WIDTH=0
  UI_PAGE_SIZE=$((UI_ROWS - 9))
  (( UI_PAGE_SIZE > 0 )) || UI_PAGE_SIZE=1
}

ui_requested() {
  [[ ${HY2M_UI:-tui} == tui ]] || return 1
  is_tty || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  [[ ${TERM:-dumb} != dumb ]] || return 1
  ui_dimensions
  (( UI_COLS >= UI_MIN_COLS && UI_ROWS >= UI_MIN_ROWS ))
}

ui_viewport() {
  local sel=$1 count=$2
  UI_FIRST=$((sel / UI_PAGE_SIZE * UI_PAGE_SIZE))
  UI_LAST=$((UI_FIRST + UI_PAGE_SIZE))
  (( UI_LAST <= count )) || UI_LAST=$count
}

ui_draw_small() {
  local hint="q/Esc: exit; resize to ${UI_MIN_COLS}x${UI_MIN_ROWS}"
  ui_home
  if (( UI_ROWS > 1 )); then printf '%s\n' "${hint:0:UI_COLS-1}" >&2; fi
}

ui_init_colors() {
  if [[ -n ${NO_COLOR:-} || ${TERM:-dumb} == dumb ]]; then
    C_RESET=""; C_BLUE=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_DIM=""; C_BOLD=""
  else
    C_RESET=$'\033[0m'; C_BLUE=$'\033[1;34m'; C_GREEN=$'\033[1;32m'
    C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  fi
}

# 画框：argv1=内宽 argv2=标题；stdin 为逐行 "T<TAB>正文" 或 "R<TAB>列1<TAB>列2…"。
# 宽度计算跳过 ANSI 序列，中文按双宽处理，超宽按显示宽度截断。
ui_box() {
  python3 -c '
import sys, io, re, unicodedata
sys.stdin = io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="replace")
sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding="utf-8", errors="replace")
ANSI = re.compile("\x1b\\[[0-9;]*m")
width = int(sys.argv[1]); title = sys.argv[2]
def cw(ch):
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
def dw(s):
    return sum(cw(c) for c in ANSI.sub("", s))
def cut(s, n):
    out, acc, i = [], 0, 0
    while i < len(s):
        m = ANSI.match(s, i)
        if m:
            out.append(m.group(0)); i = m.end(); continue
        w = cw(s[i])
        if acc + w > n:
            break
        out.append(s[i]); acc += w; i += 1
    return "".join(out), acc
rows = []
for raw in sys.stdin.read().split("\n"):
    if raw == "":
        continue
    rows.append(raw.split("\t"))
colw = []
for parts in rows:
    if parts[0] != "R":
        continue
    for i, c in enumerate(parts[1:]):
        while len(colw) <= i:
            colw.append(0)
        colw[i] = max(colw[i], dw(c))
t, _ = cut("─ " + title + " ", width + 2)
fill = max(0, width + 2 - dw(t))
out = ["┌" + t + "─" * fill + "┐"]
for parts in rows:
    kind, cells = parts[0], parts[1:]
    if kind == "R":
        line = ""
        for i, c in enumerate(cells):
            if i:
                line += "  "
            line += c + " " * max(0, colw[i] - dw(c))
    else:
        line = cells[0] if cells else ""
    body, _ = cut(line, width)
    out.append("│ " + body + " " * max(0, width - dw(body)) + " │")
out.append("└" + "─" * (width + 2) + "┘")
sys.stdout.write("\n".join(out) + "\n")
' "$1" "$2"
}

ui_enter_screen() { is_tty || return 0; tput smcup >&2 2>/dev/null || true; tput civis >&2 2>/dev/null || true; ui_home; }
ui_leave_screen() { is_tty || return 0; tput cnorm >&2 2>/dev/null || true; tput rmcup >&2 2>/dev/null || true; }
ui_home() { printf '\033[H\033[2J' >&2; }

# 读单键；方向键、PgUp/PgDn、Esc、回车归一化。空闲时检查尺寸，
# 仅在窗口变化时要求重画，不把 read 超时误当成 EOF 或回车。
ui_readkey() {
  local k k2 k3 k4 rc cols=${UI_COLS:-} rows=${UI_ROWS:-}
  while true; do
    if IFS= read -rsn1 -t 0.25 k; then break; else rc=$?; fi
    if (( rc <= 128 )); then printf 'quit'; return 0; fi
    ui_dimensions
    if [[ $cols != "$UI_COLS" || $rows != "$UI_ROWS" ]]; then printf 'resize'; return 0; fi
  done
  if [[ $k == $'\033' ]]; then
    k2=""
    IFS= read -rsn1 -t 0.05 k2 || true
    if [[ $k2 == '[' ]]; then
      k3=""
      IFS= read -rsn1 -t 0.05 k3 || true
      case $k3 in
        A) printf 'up' ;; B) printf 'down' ;; C) printf 'right' ;; D) printf 'left' ;;
        5|6)
          k4=""
          IFS= read -rsn1 -t 0.05 k4 || true
          if [[ $k4 != '~' ]]; then printf 'esc'
          elif [[ $k3 == 5 ]]; then printf 'pageup'
          else printf 'pagedown'; fi
          ;;
        *) printf 'esc' ;;
      esac
      return 0
    fi
    printf 'esc'
    return 0
  fi
  if [[ -z $k || $k == $'\r' || $k == $'\n' ]]; then printf 'enter'; return 0; fi
  printf '%s' "$k"
}

ui_node_ids() {
  local f id
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    id=${f##*/}; id=${id%.env}
    [[ $id =~ ^(direct|isp[0-9]+)$ ]] || continue
    printf '%s\n' "$id"
  done
}

# 输出 name<TAB>类型<TAB>状态<TAB>内部端口<TAB>公网端口；在子 shell 中读取，避免污染调用方状态。
ui_node_cells() {
  if [[ -n ${UI_NODE_CACHE[$1]+x} ]]; then printf '%s\n' "${UI_NODE_CACHE[$1]}"; return 0; fi
  local f="$NODE_DIR/$1.env"
  [[ -r $f ]] || return 1
  (
    unset NAME TYPE SERVICE LISTEN_PORT PUBLIC_PORT
    # shellcheck disable=SC1090
    source "$f"
    printf '%s\t%s\t%s\t%s\t%s\n' "${NAME:-$1}" "${TYPE:-unknown}" \
      "$(service_label "${SERVICE:-}")" "${LISTEN_PORT:-?}" "${PUBLIC_PORT:-?}"
  )
}

ui_refresh_status() {
  local now=$SECONDS id cells
  if ((UI_REFRESH_AT >= 0 && now - UI_REFRESH_AT < 2)); then return 0; fi
  UI_NODE_CACHE=()
  ui_cert_text
  while IFS= read -r id; do
    cells=$(ui_node_cells "$id") || continue
    UI_NODE_CACHE[$id]=$cells
  done < <(ui_node_ids)
  UI_REFRESH_AT=$now
}

ui_cert_text() {
  local f="$TLS_DIR/fullchain.pem" end epoch now days
  if [[ -r $f ]]; then
    end=$(openssl x509 -in "$f" -noout -enddate 2>/dev/null) || end=""
    epoch=$(date -d "${end#notAfter=}" +%s 2>/dev/null) || epoch=""
    if [[ $epoch =~ ^[0-9]+$ ]]; then
      now=$(date +%s); days=$(( (epoch - now) / 86400 ))
      if (( epoch <= now )); then UI_CERT_TEXT="${C_RED}证书已过期${C_RESET}"
      elif (( days < 14 )); then UI_CERT_TEXT="${C_YELLOW}证书 ${days} 天${C_RESET}"
      else UI_CERT_TEXT="${C_GREEN}证书 ${days} 天${C_RESET}"; fi
      return 0
    fi
  fi
  UI_CERT_TEXT="${C_DIM}证书 未知${C_RESET}"
}

ui_status_color() {
  case $1 in
    *运行中*) printf '%s● %s%s' "$C_GREEN" "$1" "$C_RESET" ;;
    *故障*) printf '%s● %s%s' "$C_RED" "$1" "$C_RESET" ;;
    *启动中*) printf '%s● %s%s' "$C_YELLOW" "$1" "$C_RESET" ;;
    *) printf '%s○ %s%s' "$C_DIM" "$1" "$C_RESET" ;;
  esac
}

ui_width() { ui_dimensions; printf '%s' "$UI_WIDTH"; }

ui_draw_panel() {
  local sel=$1; shift
  local -a ids=("$@") body=()
  local i id mark name type state listen public first=0
  ui_init_colors
  ui_dimensions
  if (( UI_COLS < UI_MIN_COLS || UI_ROWS < UI_MIN_ROWS )); then ui_draw_small; return 0; fi
  ui_viewport "$sel" "${#ids[@]}"
  body+=("T	${C_BOLD}HY2 ISP Manager $APP_VERSION${C_RESET}")
  body+=("T	域名 ${DOMAIN:-未设置}   网络 ${NETWORK_MODE:-未设置}   $UI_CERT_TEXT")
  body+=("R	#	节点	状态	内部/公网	类型")
  for ((i = UI_FIRST; i < UI_LAST; i++)); do
    id=${ids[i]}
    IFS=$'\t' read -r name type state listen public < <(ui_node_cells "$id") || continue
    mark=' '; (( i == sel )) && mark='>'
    body+=("R	${mark}$((i + 1))	${name}	$(ui_status_color "$state")	${listen}/${public}	${type}")
  done
  if ((${#ids[@]})); then first=$((UI_FIRST + 1))
  else body+=("T	${C_DIM}尚未创建节点，按 a 添加。${C_RESET}"); fi
  body+=("T	${C_DIM}${first}-${UI_LAST} / ${#ids[@]} 节点${C_RESET}")
  body+=("T	${C_DIM}↑↓ 选择  PgUp/PgDn 翻页  Enter 进入${C_RESET}")
  body+=("T	${C_DIM}a 添加  c 证书  d 诊断  s 设置  q 退出${C_RESET}")
  ui_home
  printf '%s\n' "${body[@]}" | ui_box "$UI_WIDTH" "HY2 管理面板" >&2
}

ui_draw_menu() {
  local title=$1 prompt=$2 sel=$3; shift 3
  local -a labels=("$@") body=()
  local i mark first=0
  ui_init_colors
  ui_dimensions
  if (( UI_COLS < UI_MIN_COLS || UI_ROWS < UI_MIN_ROWS )); then ui_draw_small; return 0; fi
  ui_viewport "$sel" "${#labels[@]}"
  body+=("T	${C_BOLD}${title}${C_RESET}")
  body+=("T	${C_DIM}${prompt}${C_RESET}")
  body+=("T	")
  for ((i = UI_FIRST; i < UI_LAST; i++)); do
    mark='  '; (( i == sel )) && mark="${C_GREEN}>${C_RESET} "
    body+=("T	${mark}${labels[i]}")
  done
  ((${#labels[@]} == 0)) || first=$((UI_FIRST + 1))
  body+=("T	${C_DIM}${first}-${UI_LAST} / ${#labels[@]} 项${C_RESET}")
  body+=("T	${C_DIM}↑↓ 移动  PgUp/PgDn 翻页${C_RESET}")
  body+=("T	${C_DIM}Enter 确定  Esc/q 返回${C_RESET}")
  ui_home
  printf '%s\n' "${body[@]}" | ui_box "$UI_WIDTH" "$APP_NAME" >&2
}

# ui_menu <标题> <说明> "键|说明" …；选中返回键，Esc/q 返回 20。
ui_menu() {
  local title=$1 prompt=$2; shift 2
  local -a entries=("$@") keys=() labels=()
  local e sel=0 key i
  for e in "${entries[@]}"; do
    keys+=("${e%%|*}")
    labels+=("${e#*|}")
  done
  ((${#keys[@]})) || return 20
  while true; do
    ui_draw_menu "$title" "$prompt" "$sel" "${labels[@]}"
    key=$(ui_readkey)
    case $key in esc|quit|q|Q) return 20 ;; esac
    ui_dimensions
    if (( UI_COLS < UI_MIN_COLS || UI_ROWS < UI_MIN_ROWS )); then continue; fi
    case $key in
      up|k) if (( sel > 0 )); then sel=$((sel - 1)); fi ;;
      down|j) if (( sel < ${#keys[@]} - 1 )); then sel=$((sel + 1)); fi ;;
      pageup) sel=$((sel - UI_PAGE_SIZE)); (( sel >= 0 )) || sel=0 ;;
      pagedown) sel=$((sel + UI_PAGE_SIZE)); (( sel < ${#keys[@]} )) || sel=$(( ${#keys[@]} - 1 )) ;;
      enter) printf '%s' "${keys[sel]}"; return 0 ;;
      resize) continue ;;
      *)
        for ((i = 0; i < ${#keys[@]}; i++)); do
          if [[ $key == "${keys[i]}" ]]; then printf '%s' "${keys[i]}"; return 0; fi
        done
        ;;
    esac
  done
}

# 离开面板执行动作，输出完整可见，按键后回到面板。
ui_run() {
  ui_leave_screen
  run_menu_action "$@"
  UI_REFRESH_AT=-1; UI_NODE_CACHE=()
  if is_tty; then printf '\n按任意键返回面板……' >&2; IFS= read -rsn1 _ || true; fi
  # Actions run in a subshell; domain changes/restores update disk, not our vars.
  if [[ -r $MANAGER_STATE ]]; then load_manager; ui_cert_text; fi
  ui_enter_screen
}

ui_node_actions() {
  local id=$1 choice name type
  local -a items
  while [[ -r $NODE_DIR/$id.env ]]; do
    IFS=$'\t' read -r name type _ < <(ui_node_cells "$id") || { name=$id; type=unknown; }
    items=("1|查看详情、链接 / 二维码" "2|启动节点" "3|停止节点" "4|重启节点" "5|修改端口" "6|查看日志" "7|运行时长与流量" "8|重命名")
    [[ $type != isp ]] || items+=("9|更换 ISP（保留 HY2 链接）")
    items+=("e|导出 Clash/Mihomo YAML" "x|删除此节点" "0|返回节点列表")
    choice=$(ui_menu "管理 $name" "选择要执行的操作" "${items[@]}") || return 0
    case $choice in
      0) return 0 ;;
      1) ui_run show_managed_node "$NODE_DIR/$id.env" ;;
      2) ui_run start_node "$id" ;;
      3) ui_run stop_node "$id" ;;
      4) ui_run restart_node "$id" ;;
      5) ui_run change_node_port "$id" ;;
      6) ui_run node_log "$id" ;;
      7) ui_run node_traffic "$id" ;;
      8) ui_run rename_node "$id" ;;
      9) ui_run replace_isp "$id" ;;
      e) ui_run show_clash_export "$id" ;;
      x) ui_run remove_node "$id" ;;
    esac
  done
  return 0
}

