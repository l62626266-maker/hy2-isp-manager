uninstall_all() {
  [[ -r $MANAGER_STATE ]] || die "未检测到安装状态。"
  load_manager
  confirm "完整卸载本管理器创建的节点？SSH 和其他服务不会被修改。" || return 0
  # 证书和网络优化会波及其他程序，默认不动，只在用户额外确认后清理。
  local purge=0
  confirm "同时删除本管理器申请的系统证书和网络优化（sysctl）吗？选否将保留，避免影响其他程序。" && purge=1
  make_backup; local f
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    unset SERVICE CONFIG URI_FILE LISTEN_PORT
    # shellcheck disable=SC1090
    source "$f"
    systemctl disable --now "$SERVICE" >/dev/null 2>&1 || die "停止节点失败，保留配置。"
    close_firewall "$LISTEN_PORT" udp || die "防火墙清理失败，保留配置和记录。"
    rm -f "$SERVICE_DIR/$SERVICE" "$CONFIG" "$URI_FILE"
  done
  if [[ -r $FIREWALL_STATE ]]; then while IFS=/ read -r port proto; do close_firewall "$port" "$proto" || die "防火墙清理失败，保留归属记录。"; done < <(cp "$FIREWALL_STATE" /dev/stdout); fi
  systemctl daemon-reload; rm -rf "$STATE_DIR" "$HYSTERIA_DIR" "$EXPORT_DIR"; rm -f /etc/letsencrypt/renewal-hooks/deploy/hy2-manager-copy.sh
  if ((purge)); then
    [[ -z ${DOMAIN:-} ]] || certbot delete --cert-name "$DOMAIN" --non-interactive >/dev/null 2>&1 || warn "证书删除失败，可稍后手动执行 certbot delete --cert-name $DOMAIN。"
    [[ ! -r $SYSCTL_FILE ]] || rm -f "$SYSCTL_FILE"
    warn "网络优化文件已删除；已生效的内核参数保持到重启为止，重启后回到系统默认值。"
  fi
  local shortcut
  for shortcut in "$SBIN_DIR/hy2" "$BIN_DIR/hy2"; do
    if [[ -L $shortcut && $(readlink "$shortcut") == "$APP_DIR/hy2-manager" ]]; then rm -f "$shortcut"; fi
  done
  rm -f "$SBIN_DIR/hy2-manager" "$BIN_DIR/hy2-manager"; rm -rf "$APP_DIR"
  if ((purge)); then ok "卸载完成，证书和网络优化已一并清理；备份保留在 $BACKUP_DIR。"
  else ok "卸载完成。系统证书账户、网络优化和备份被保留，避免影响其他程序。"; fi
}

# Deployment plus the installation record. The enclosing certificate transaction
# restores certificates, the renewal hook, the timer and the firewall record if
# any step fails, so installation is never reported as complete while half done.
_install_publish() {
  local domain=$1 public_ip=$2 mode=$3 cert_mode=$4
  copy_certificate "$domain" || { warn "证书部署失败。"; return 1; }
  write_env "$MANAGER_STATE" INSTALLED_VERSION "$APP_VERSION" DOMAIN "$domain" PUBLIC_IP "$public_ip" NETWORK_MODE "$mode" CERT_MODE "$cert_mode" ||
    { warn "写入安装状态失败。"; return 1; }
}
# Issuance and deployment must share one transaction. Issuing in its own
# transaction would commit the temporary HTTP-01 firewall rule, so a later copy,
# hook, timer or install-record failure would leave TCP 80 open for good.
_install_certificate() {
  local domain=$1 public_ip=$2 mode=$3 cert_mode=$4 email=$5 token=${6:-} rc
  # Capture the status before any negation: `if ! cmd; then rc=$?` would record
  # the status of `!`, which is always 0 and hides every failure.
  if [[ $cert_mode == http ]]; then
    certificate_http "$domain" "$email"; rc=$?
    if ((rc != 0)); then warn "HTTP-01 证书签发失败。"; return "$rc"; fi
  else
    certificate_cloudflare "$domain" "$email" "$token"; rc=$?
    if ((rc != 0)); then warn "DNS-01 证书签发失败。"; return "$rc"; fi
  fi
  _install_publish "$domain" "$public_ip" "$mode" "$cert_mode"
}
initial_install() {
  [[ ! -e $MANAGER_STATE ]] || die "已经安装，请使用管理菜单。"
  os_check; require_systemd
  log "安装依赖……"; install_packages; ensure_layout; install_hysteria
  local mode="" domain="" public_ip="" cert_mode="" email="" token="" resumed=0 rc=0
  if [[ -r $INSTALL_SESSION ]] && confirm "检测到未完成的安装进度，是否从域名/证书步骤继续？"; then
    # shellcheck disable=SC1090
    source "$INSTALL_SESSION"
    mode=${INSTALL_MODE:-}; domain=${INSTALL_DOMAIN:-}; public_ip=${INSTALL_PUBLIC_IP:-}; cert_mode=${INSTALL_CERT_MODE:-}; email=${INSTALL_EMAIL:-}
    if [[ $mode =~ ^(normal|nat)$ ]] && valid_domain "$domain" && valid_ipv4 "$public_ip" && [[ $cert_mode =~ ^(http|cloudflare)$ ]] && check_dns "$domain" "$public_ip"; then
      resumed=1; ok "已恢复非敏感安装进度；Token 等秘密不会写入断点文件。"
    else
      warn "保存的进度已失效，将重新填写。"; rm -f "$INSTALL_SESSION"
    fi
  fi
  if ((resumed == 0)); then
    while true; do
      mode=$(choose "网络类型" "请选择 VPS 类型" normal "普通公网 VPS" nat "NAT / 端口映射 VPS") || return $?
      [[ $mode == normal || $mode == nat ]] && break
      warn "网络类型无效，请重新选择。"
    done
    while true; do
      domain=$(ask_valid_domain "域名" "HY2 域名（Cloudflare 必须灰云）" "") || return $?
      if [[ $mode == normal ]]; then
        if ! public_ip=$(get_public_ipv4); then warn "无法获取公网 IPv4。"; confirm "是否重试域名和公网 IP 步骤？" && continue || return 0; fi
      else
        public_ip=$(ask_valid_ipv4 "NAT 公网 IP" "服务商控制台显示的绑定公网 IPv4" "") || return $?
      fi
      if check_dns "$domain" "$public_ip"; then break; fi
      confirm "DNS 检查失败，是否重新填写域名和公网 IP？选择否将返回主菜单。" || return 0
    done
    while true; do
      cert_mode=$(choose "证书" "请选择证书验证方式" http "HTTP-01（需要公网 80→内部80）" cloudflare "Cloudflare DNS-01（适合 NAT）") || return $?
      [[ $cert_mode == http || $cert_mode == cloudflare ]] && break
      warn "证书方式无效，请重新选择。"
    done
    email=$(ask "证书" "Let's Encrypt 邮箱（可以留空）" "") || return $?
    write_env "$INSTALL_SESSION" INSTALL_MODE "$mode" INSTALL_DOMAIN "$domain" INSTALL_PUBLIC_IP "$public_ip" INSTALL_CERT_MODE "$cert_mode" INSTALL_EMAIL "$email"
    ok "已保存非敏感安装进度；失败后可继续，断点文件不保存 Token。"
  fi
  make_backup; configure_network
  if certificate_valid "$domain"; then
    ok "检测到 30 天以上有效期的现有证书，将安全复用。"
    certificate_transaction _install_publish "$domain" "$public_ip" "$mode" "$cert_mode" ||
      die "证书部署失败，安装未完成；修正后重新运行安装即可继续。"
  else
    while true; do
      if [[ $cert_mode == http ]]; then
        if [[ $mode != normal ]] && ! confirm "NAT 模式必须确认公网 TCP 80 → 内部 TCP 80，是否继续？"; then return 0; fi
      else
        token=$(ask_secret "Cloudflare" "请输入仅含 Zone.DNS Edit 权限的 API Token") || return $?
        if [[ -z $token ]]; then warn "Token 不能为空，请重新输入。"; continue; fi
      fi
      # Issuance, deployment and the install record commit or roll back together,
      # so a failed copy, hook or timer never leaves the temporary HTTP-01 rule
      # committed on the firewall.
      if certificate_transaction _install_certificate "$domain" "$public_ip" "$mode" "$cert_mode" "$email" "$token"; then
        unset token; break
      else
        rc=$?
      fi
      unset token
      # A signal must return its status instead of asking for a retry, otherwise
      # an interrupted install looks like a declined retry.
      ((rc < 128)) || return "$rc"
      # Declining a retry returns to the menu but must not report a completed
      # install: the resumable checkpoint stays, and the status stays nonzero.
      if [[ $cert_mode == http ]]; then
        confirm "HTTP-01 失败，是否在当前步骤重试？选择否将保留进度并返回主菜单。" || return 1
      else
        confirm "DNS-01 失败，是否重新输入 Token？选择否将保留进度并返回主菜单。" || return 1
      fi
    done
  fi
  rm -f "$INSTALL_SESSION"
  log "创建 HY2 直连节点……"
  # A cancelled or failed node creation must not end with a success banner, and
  # its status (including 128+ from a signal) has to reach the caller.
  create_direct; rc=$?
  ((rc == 0)) || return "$rc"
  if confirm "现在添加 ISP SOCKS5 全局节点？"; then create_isp; rc=$?; ((rc == 0)) || return "$rc"; fi
  ok "安装完成。运行 hy2 查看菜单（旧命令 hy2-manager 仍可使用）。"
}

install_self() {
  require_root
  local shortcut
  for shortcut in "$SBIN_DIR/hy2" "$BIN_DIR/hy2"; do
    if [[ -e $shortcut || -L $shortcut ]]; then
      [[ -L $shortcut && $(readlink "$shortcut") == "$APP_DIR/hy2-manager" ]] || die "$shortcut 已被其他程序占用，未覆盖。"
    fi
  done
  install -d -o root -g root -m 755 "$APP_DIR" "$SBIN_DIR" "$BIN_DIR"
  if [[ ! $0 -ef $APP_DIR/hy2-manager ]]; then install -o root -g root -m 755 "$0" "$APP_DIR/hy2-manager"; fi
  ln -sfn "$APP_DIR/hy2-manager" "$SBIN_DIR/hy2-manager"
  ln -sfn "$APP_DIR/hy2-manager" "$BIN_DIR/hy2-manager"
  ln -sfn "$APP_DIR/hy2-manager" "$SBIN_DIR/hy2"
  ln -sfn "$APP_DIR/hy2-manager" "$BIN_DIR/hy2"
  ok "管理器已安装：输入 hy2 即可打开，旧命令仍有效。"
}

