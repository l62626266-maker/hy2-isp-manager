ui_cert_text() {
  local f="$TLS_DIR/fullchain.pem" end epoch now days
  if [[ -r $f ]]; then
    end=$(openssl x509 -in "$f" -noout -enddate 2>/dev/null) || end=""
    epoch=$(openssl x509 -in "$f" -noout -checkend 0 >/dev/null 2>&1 && date -d "${end#notAfter=}" +%s 2>/dev/null) || epoch=""
    if [[ $epoch =~ ^[0-9]+$ ]]; then
      now=$(date +%s); days=$(( (epoch - now) / 86400 ))
      if (( days < 0 )); then UI_CERT_TEXT="${C_RED}证书已过期${C_RESET}"
      elif (( days < 14 )); then UI_CERT_TEXT="${C_YELLOW}证书 ${days} 天${C_RESET}"
      else UI_CERT_TEXT="${C_GREEN}证书 ${days} 天${C_RESET}"; fi
      return 0
    fi
  fi
  UI_CERT_TEXT="${C_DIM}证书 未知${C_RESET}"
}

ui_status_color() {
  case $1 in
    *运行中*) printf '%s● %s%s' "$C_GREEN" "$1" "$C_RESET" ;;
    *故障*) printf '%s● %s%s' "$C_RED" "$1" "$C_RESET" ;;
    *启动中*) printf '%s● %s%s' "$C_YELLOW" "$1" "$C_RESET" ;;
    *) printf '%s○ %s%s' "$C_DIM" "$1" "$C_RESET" ;;
  esac
}

ui_width() {
  local cols
  cols=$(tput cols 2>/dev/null || printf 80)
  [[ $cols =~ ^[0-9]+$ ]] || cols=80
  local w=$(( cols - 6 ))
  (( w > 72 )) && w=72
  (( w < 40 )) && w=40
  printf '%s' "$w"
}

ui_draw_panel() {
  local sel=$1; shift
  local -a ids=("$@") body=()
  local i id mark name type state listen public w
  ui_init_colors
  w=$(ui_width)
  body+=("T	${C_BOLD}HY2 ISP Manager $APP_VERSION${C_RESET}")
  body+=("T	域名 ${DOMAIN:-未设置}   网络 ${NETWORK_MODE:-未设置}   $UI_CERT_TEXT")
  body+=("T	")
  body+=("R	#	节点	状态	内部/公网	类型")
  for ((i = 0; i < ${#ids[@]}; i++)); do
    id=${ids[i]}
    IFS=$'\t' read -r name type state listen public < <(ui_node_cells "$id") || continue
    mark=' '; (( i == sel )) && mark='>'
    body+=("R	${mark}$((i + 1))	${name}	$(ui_status_color "$state")	${listen}/${public}	${type}")
  done
  ((${#ids[@]})) || body+=("T	${C_DIM}尚未创建节点，按 a 添加。${C_RESET}")
  body+=("T	")
  body+=("T	${C_DIM}↑↓ 选择   Enter 进入   a 添加   c 证书   d 诊断   s 设置   q 退出${C_RESET}")
  ui_home
  printf '%s\n' "${body[@]}" | ui_box "$w" "HY2 管理面板" >&2
}

ui_draw_menu() {
  local title=$1 prompt=$2 sel=$3; shift 3
  local -a labels=("$@") body=()
  local i mark w
  ui_init_colors
  w=$(ui_width)
  body+=("T	${C_BOLD}${title}${C_RESET}")
  body+=("T	${C_DIM}${prompt}${C_RESET}")
  body+=("T	")
  for ((i = 0; i < ${#labels[@]}; i++)); do
    mark='  '; (( i == sel )) && mark="${C_GREEN}>${C_RESET} "
    body+=("T	${mark}${labels[i]}")
  done
  body+=("T	")
  body+=("T	${C_DIM}↑↓ 移动   Enter 确定   Esc 返回${C_RESET}")
  ui_home
  printf '%s\n' "${body[@]}" | ui_box "$w" "$APP_NAME" >&2
}

# ui_menu <标题> <说明> "键|说明" …；选中返回键，Esc/q 返回 20。
ui_menu() {
  local title=$1 prompt=$2; shift 2
  local -a entries=("$@") keys=() labels=()
  local e sel=0 key i
  for e in "${entries[@]}"; do
    keys+=("${e%%|*}")
    labels+=("${e#*|}")
  done
  ((${#keys[@]})) || return 20
  while true; do
    ui_draw_menu "$title" "$prompt" "$sel" "${labels[@]}"
    key=$(ui_readkey)
    case $key in
      up|k) if (( sel > 0 )); then sel=$((sel - 1)); fi ;;
      down|j) if (( sel < ${#keys[@]} - 1 )); then sel=$((sel + 1)); fi ;;
      enter) printf '%s' "${keys[sel]}"; return 0 ;;
      esc|quit|q|Q) return 20 ;;
      *)
        for ((i = 0; i < ${#keys[@]}; i++)); do
          if [[ $key == "${keys[i]}" ]]; then printf '%s' "${keys[i]}"; return 0; fi
        done
        ;;
    esac
  done
}

# 离开面板执行动作，输出完整可见，按键后回到面板。
ui_run() {
  ui_leave_screen
  run_menu_action "$@"
  if is_tty; then printf '\n按任意键返回面板……' >&2; IFS= read -rsn1 _ || true; fi
  ui_enter_screen
}

ui_node_actions() {
  local id=$1 choice name type
  local -a items
  while [[ -r $NODE_DIR/$id.env ]]; do
    IFS=$'\t' read -r name type _ < <(ui_node_cells "$id") || { name=$id; type=unknown; }
    items=("1|查看详情、链接 / 二维码" "2|启动节点" "3|停止节点" "4|重启节点" "5|修改端口")
    [[ $type != isp ]] || items+=("6|更换 ISP（保留 HY2 链接）")
    items+=("0|返回节点列表")
    choice=$(ui_menu "管理 $name" "选择要执行的操作" "${items[@]}") || return 0
    case $choice in
      0) return 0 ;;
      1) ui_run show_managed_node "$NODE_DIR/$id.env" ;;
      2) ui_run start_node "$id" ;;
      3) ui_run stop_node "$id" ;;
      4) ui_run restart_node "$id" ;;
      5) ui_run change_node_port "$id" ;;
      6) ui_run replace_isp "$id" ;;
    esac
  done
  return 0
}

ui_add_menu() {
  local c
  c=$(ui_menu "添加节点" "先有直连，再添加 ISP；现有节点不会重建" \
    "1|添加 ISP 节点" "2|创建 / 补建直连节点" "0|返回") || return 0
  case $c in
    1) ui_run create_isp ;;
    2) ui_run create_direct ;;
    0) return 0 ;;
  esac
}

ui_cert_menu() {
  local c
  while true; do
    c=$(ui_menu "域名与证书" "共用一套证书；查看状态不会执行续期" \
      "1|查看证书 / 续期计划" "2|查看最近续期日志" "0|返回") || return 0
    case $c in
      0) return 0 ;;
      1) ui_run certificate_details ;;
      2) ui_run journalctl -u certbot.service -u hy2-cert-guard.service -n 60 --no-pager ;;
    esac
  done
}

ui_diag_menu() {
  local c
  c=$(ui_menu "诊断与备份" "诊断只读，不自动修改系统" \
    "1|检查节点、证书与网络" "2|备份配置" "0|返回") || return 0
  case $c in
    1) ui_run diagnose ;;
    2) ui_run make_backup ;;
    0) return 0 ;;
  esac
}

ui_advanced_menu() {
  local c
  c=$(ui_menu "高级设置" "卸载前会备份配置；不会修改 SSH" \
    "1|查看版本与命令帮助" "2|卸载本管理器及其节点" "0|返回") || return 0
  case $c in
    1) ui_run usage ;;
    2) ui_run uninstall_all ;;
    0) return 0 ;;
  esac
}

ui_main_loop() {
  local -a ids=()
  local sel=0 key id i
  ui_init_colors
  load_manager
  ui_cert_text
  ui_enter_screen
  trap 'ui_leave_screen' EXIT
  trap 'ui_leave_screen; exit 130' INT
  trap 'ui_leave_screen; exit 143' TERM
  while true; do
    ids=()
    while IFS= read -r id; do ids+=("$id"); done < <(ui_node_ids)
    if ((${#ids[@]})) && (( sel >= ${#ids[@]} )); then sel=$(( ${#ids[@]} - 1 )); fi
    if (( sel < 0 )); then sel=0; fi
    ui_draw_panel "$sel" ${ids[@]+"${ids[@]}"}
    key=$(ui_readkey)
    case $key in
      q|Q|quit) break ;;
      up|k) if (( sel > 0 )); then sel=$((sel - 1)); fi ;;
      down|j) if (( sel < ${#ids[@]} - 1 )); then sel=$((sel + 1)); fi ;;
      enter)
        if ((${#ids[@]})); then ui_node_actions "${ids[sel]}"; fi
        ui_cert_text
        ;;
      a|A) ui_add_menu ;;
      c|C) ui_cert_menu; ui_cert_text ;;
      d|D) ui_diag_menu ;;
      s|S) ui_advanced_menu ;;
      [1-9])
        i=$((key - 1))
        if (( i < ${#ids[@]} )); then sel=$i; ui_node_actions "${ids[sel]}"; fi
        ui_cert_text
        ;;
    esac
    [[ -r $MANAGER_STATE ]] || break
  done
  ui_leave_screen
  trap - EXIT INT TERM
  trap cleanup EXIT
  return 0
}

main_menu() {
  local c prompt
  if [[ -r $MANAGER_STATE ]] && ui_requested; then
    ui_main_loop
    return 0
  fi
  while true; do
    if [[ ! -r $MANAGER_STATE ]] && ! legacy_direct_available; then
      c=$(choose "$APP_NAME $APP_VERSION" "尚未安装：系统检查 → 自定义域名 → 证书 → 直连 → 可选 ISP" 1 "开始全新安装" 0 "退出") || return 0
      case $c in 1) menu_action initial_install ;; 0) return 0 ;; *) warn "无效选择。" ;; esac
      continue
    fi
    prompt=$(dashboard)
    if [[ ! -r $MANAGER_STATE ]]; then
      c=$(choose "现有节点（只读兼容）" "$prompt" 1 "查看现有节点" 2 "域名与证书" 0 "退出") || return 0
      case $c in 1) menu_action show_nodes ;; 2) certificate_menu ;; 0) return 0 ;; *) warn "无效选择。" ;; esac
      continue
    fi
    c=$(choose "HY2 管理面板" "$prompt" 1 "管理节点" 2 "添加节点" 3 "域名与证书" 4 "诊断与备份" 5 "高级设置" 0 "退出") || return 0
    case $c in
      1) node_menu ;; 2) add_node_menu ;; 3) certificate_menu ;; 4) maintenance_menu ;; 5) advanced_menu ;; 0) return 0 ;; *) warn "无效选择。" ;;
    esac
    [[ -r $MANAGER_STATE ]] || return 0;
  done
}

usage() {
  cat <<EOF
$APP_NAME $APP_VERSION
用法（hy2 为快捷入口，普通用户自动请求 sudo 权限）：
  hy2
  hy2 status
  hy2 change-port
  sudo bash hy2-manager install-self
  sudo hy2-manager install
  sudo hy2-manager create-direct
  sudo hy2-manager add-isp
  sudo hy2-manager replace-isp
  sudo hy2-manager show
  sudo hy2-manager status
  sudo hy2-manager diagnose
  sudo hy2-manager backup
  sudo hy2-manager remove-node
  sudo hy2-manager uninstall
  sudo hy2-manager menu
EOF
}

main() {
  local cmd=${1:-menu}
  case $cmd in -h|--help|help) usage; return ;; version|--version) printf '%s\n' "$APP_VERSION"; return ;; esac
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    require_cmd sudo
    exec sudo -- bash "$0" "$@"
  fi
  case $cmd in
    install-self) install_self ;; install) initial_install ;; create-direct) create_direct ;; add-isp) create_isp ;; replace-isp) replace_isp "${2:-}" ;; change-port) change_node_port "${2:-}" ;; show) show_nodes ;; status) status_all ;; diagnose) diagnose ;; backup) make_backup ;; remove-node) remove_node "${2:-}" ;; uninstall) uninstall_all ;; menu) main_menu ;; *) usage; exit 2 ;;
  esac
}

if [[ ${HY2M_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
