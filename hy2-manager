  ok "直连节点已创建。"
}

# Parse pasted credentials as data, never as shell code; the argument is a file path.
parse_socks_file() {
  local parsed
  parsed=$(python3 - "$1" <<'PY'
import ipaddress, re, sys
from urllib.parse import urlsplit, unquote
sys.stdout.reconfigure(newline='\n')
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        raw = f.read().rstrip('\n')
    if not raw.isprintable():
        raise ValueError()
    if '://' in raw:
        u = urlsplit(raw)
        if u.scheme not in ('socks5', 'socks5h') or u.path not in ('', '/') or u.query or u.fragment:
            raise ValueError()
        if re.search(r'%(?![0-9a-fA-F]{2})', raw):
            raise ValueError()
        host, port = u.hostname, u.port
        user = unquote(u.username or '', errors='strict')
        password = unquote(u.password or '', errors='strict')
    else:
        host, port, user, password = raw.split(':', 3)
        port = int(port)
    if not host or not port or not 1 <= port <= 65535:
        raise ValueError()
    try:
        ipaddress.ip_address(host)
    except ValueError:
        if len(host) > 253 or not all(re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', s) for s in host.split('.')):
            raise ValueError()
    if ':' in user or not all(v and v.isprintable() and len(v.encode('utf-8')) <= 255 for v in (user, password)):
        raise ValueError()
    print(host, port, user, password, sep='\n')
except (ValueError, TypeError, OSError):
    # Never include input credentials in errors.
    sys.exit(1)
PY
  ) || return 1
  local fields=()
  mapfile -t fields <<<"$parsed"
  ((${#fields[@]} == 4)) || return 1
  SOCKS_HOST=${fields[0]}; SOCKS_PORT=${fields[1]}; SOCKS_USER=${fields[2]}; SOCKS_PASS=${fields[3]}
}

read_socks() {
  local mode raw tmp
  while true; do
    mode=$(choose "添加 / 更换 ISP" "选择输入方式；代理信息不会出现在首页" 1 "粘贴整条代理信息（隐藏输入）" 2 "分别填写地址、端口、账号和密码" 0 "返回") || return $?
    case $mode in
      0) return 20 ;;
      2) read_socks_fields; return $? ;;
      1)
        tmp=$(mktemp); cleanup_files+=("$tmp")
        while true; do
          raw=$(ask_secret "粘贴 ISP" "支持 socks5://用户:密码@地址:端口 或 地址:端口:用户:密码；URL 特殊字符需百分号编码") || return $?
          printf '%s' "$raw" >"$tmp"; unset raw
          if parse_socks_file "$tmp"; then rm -f "$tmp"; return 0; fi
          warn "格式无效，需要有效地址、端口及非空账号密码；也可返回后分别填写。"
        done ;;
      *) warn "请选择列出的选项。" ;;
    esac
  done
}

read_socks_fields() {
  SOCKS_HOST=$(ask_valid_host "ISP SOCKS5" "SOCKS5 地址（IP 或域名）" "") || return $?
  SOCKS_PORT=$(ask_valid_port "ISP SOCKS5" "SOCKS5 端口" "") || return $?
  while true; do
    SOCKS_USER=$(ask "ISP SOCKS5" "用户名" "") || return $?
    if [[ -n $SOCKS_USER && $SOCKS_USER != *:* ]]; then break; fi
    warn "用户名不能为空且不能包含冒号，请重新输入。"
  done
  while true; do
    SOCKS_PASS=$(ask_secret "ISP SOCKS5" "密码（输入时不显示）") || return $?
    [[ -n $SOCKS_PASS ]] && break
    warn "密码不能为空，请重新输入。"
  done
}
probe_socks_udp() {
  local cred
  cred=$(mktemp); cleanup_files+=("$cred")
  printf '%s\n%s\n%s\n%s\n' "$SOCKS_HOST" "$SOCKS_PORT" "$SOCKS_USER" "$SOCKS_PASS" >"$cred"; chmod 600 "$cred"
  python3 - "$cred" <<'PY'
import socket, struct, sys
with open(sys.argv[1], 'r', encoding='utf-8') as f:
    h, port, user, password = f.read().splitlines()
p,u,w=int(port),user.encode(),password.encode()
def rx(s,n):
 d=b''
 while len(d)<n:
  c=s.recv(n-len(d))
  if not c: raise OSError('EOF')
  d+=c
 return d
try:
 with socket.create_connection((h,p),8) as s:
  s.sendall(b'\x05\x01\x02'); v,m=rx(s,2)
  if (v,m)!=(5,2): print('unsupported'); raise SystemExit
  s.sendall(b'\x01'+bytes([len(u)])+u+bytes([len(w)])+w)
  if rx(s,2)[1]!=0: print('auth_failed'); raise SystemExit
  s.sendall(b'\x05\x03\x00\x01\x00\x00\x00\x00\x00\x00'); r=rx(s,4)
  print('supported' if r[:2]==b'\x05\x00' else 'unsupported')
except Exception: print('probe_failed')
PY
}
verify_socks() {
  local cfg exit_ip
  cfg=$(mktemp); cleanup_files+=("$cfg")
  printf 'socks5-hostname = %s\nproxy-user = %s\n' "$(yaml_quote "$(host_port "$SOCKS_HOST" "$SOCKS_PORT")")" "$(yaml_quote "$SOCKS_USER:$SOCKS_PASS")" >"$cfg"; chmod 600 "$cfg"
  if ! exit_ip=$(curl --config "$cfg" -4fsS --max-time 20 https://api.ipify.org); then
    warn "SOCKS5 TCP、认证或上游出口测试失败。"; return 1
  fi
  SOCKS_EXIT_IP=$exit_ip; SOCKS_UDP=$(probe_socks_udp)
  if [[ $SOCKS_UDP == auth_failed ]]; then warn "SOCKS5 UDP 探测认证失败。"; return 1; fi
  ok "SOCKS5 出口：$SOCKS_EXIT_IP；UDP：$SOCKS_UDP"
}

render_isp_config() {
  local port=$1 auth=$2 outbound=$3
  write_common_config "$port" "$auth"
  printf '\noutbounds:\n  - name: %s\n    type: socks5\n    socks5:\n      addr: %s\n      username: %s\n      password: %s\n\n' "$outbound" "$(yaml_quote "$(host_port "$SOCKS_HOST" "$SOCKS_PORT")")" "$(yaml_quote "$SOCKS_USER")" "$(yaml_quote "$SOCKS_PASS")"
  printf 'acl:\n  inline:\n    - %s(all)\n' "$outbound"
}

next_isp_slot() { local i; for i in $(seq 1 20); do [[ -e $NODE_DIR/isp$i.env ]] || { printf '%s' "$i"; return; }; done; die "ISP 节点已达到上限。"; }
create_isp() {
  load_manager
  [[ -r $NODE_DIR/direct.env ]] || legacy_direct_available || die "必须先存在HY2直连节点，才能添加ISP节点。"
  local index id name listen_default listen_port public_port mode auth config service uri_file tmp outbound
  index=$(next_isp_slot); id="isp$index"; name="HY2-ISP-Full-$index"; [[ $index == 1 ]] && name=HY2-ISP-Full
  mode=$NETWORK_MODE; listen_default=$((7443 + index * 1000))
  while true; do
    listen_port=$(ask_valid_port "ISP 全局节点" "VPS 内部 UDP 监听端口" "$listen_default") || return $?
    if port_free "$listen_port" udp; then break; fi
    warn "UDP $listen_port 已占用，请重新输入。"
  done
  if [[ $mode == nat ]]; then
    while true; do
      public_port=$(ask_valid_port "NAT 映射" "服务商控制台的公网 UDP 端口" "") || return $?
      if public_port_free "$public_port"; then break; fi
      warn "公网端口 $public_port 已被其他节点记录，请重新输入。"
    done
  else public_port=$listen_port; fi
  name=$(ask_valid_name "ISP 全局节点" "节点名称" "$name") || return $?
  while true; do
    read_socks || return $?
    if verify_socks; then break; fi
    unset SOCKS_PASS
    confirm "SOCKS5 测试失败，是否重新输入 SOCKS5 信息？选择否将返回主菜单。" || return 0
  done
  auth=$(openssl rand -hex 24); config="$HYSTERIA_DIR/$id.yaml"; service="hy2m-$id.service"; uri_file="$EXPORT_DIR/hy2-$id.txt"; outbound="isp_all_$index"
  tmp=$(mktemp); cleanup_files+=("$tmp")
  render_isp_config "$listen_port" "$auth" "$outbound" >"$tmp"
  install -o root -g hysteria -m 640 "$tmp" "$config"
  printf 'hysteria2://%s@%s:%s/?sni=%s&insecure=0#%s\n' "$auth" "$DOMAIN" "$public_port" "$DOMAIN" "$name" >"$uri_file"; chmod 600 "$uri_file"
  write_service "$service" "HY2 Manager ISP Full Node $index" "$config"; open_firewall "$listen_port" udp
  if ! start_checked "$service" "$listen_port"; then systemctl disable --now "$service" >/dev/null 2>&1 || true; rm -f "$config" "$SERVICE_DIR/$service" "$uri_file"; close_firewall "$listen_port" udp; die "ISP 节点启动失败，已回滚。"; fi
  save_node "$id" isp "$name" "$listen_port" "$public_port" "$service" "$config" "$uri_file" "$mode"
  printf 'SOCKS_EXIT_IP=%q\nSOCKS_UDP=%q\n' "$SOCKS_EXIT_IP" "$SOCKS_UDP" >>"$NODE_DIR/$id.env"
  if [[ $mode == nat ]]; then warn "请确认服务商控制台已有：公网 UDP $public_port → 内部 UDP $listen_port"; fi
  [[ $SOCKS_UDP == supported ]] || warn "该 ISP SOCKS5 不支持 UDP；网页 TCP/HTTPS 通常可用，必须使用 UDP 的应用可能失败。"
  ok "ISP 全局节点已创建；配置只定义 ISP outbound，不会故障回退到 VPS。"
  unset SOCKS_PASS
}

replace_isp() {
  load_manager
  local id=${1:-} f old_name old_listen old_public old_service old_config old_uri old_mode auth outbound tmp backup
  [[ -n $id ]] || id=$(select_node isp) || return $?
  [[ $id =~ ^isp[0-9]+$ && -r $NODE_DIR/$id.env ]] || die "只能选择已存在的 ISP 节点。"
  f="$NODE_DIR/$id.env"
  # shellcheck disable=SC1090
  source "$f"
  old_name=$NAME; old_listen=$LISTEN_PORT; old_public=$PUBLIC_PORT; old_service=$SERVICE; old_config=$CONFIG; old_uri=$URI_FILE; old_mode=$NETWORK_MODE
  auth=$(awk -F'"' '/^[[:space:]]*password:/{print $2; exit}' "$old_config")
  [[ $auth =~ ^[0-9a-f]{48}$ ]] || die "无法安全读取现有 HY2 认证信息。"
  while true; do
    read_socks || return $?
    if verify_socks; then break; fi
    unset SOCKS_PASS
    confirm "SOCKS5 测试失败，是否重新输入？选择否将返回主菜单。" || return 0
  done
  outbound="isp_all_${id#isp}"; tmp=$(mktemp); backup=$(mktemp); cleanup_files+=("$tmp" "$backup")
  render_isp_config "$old_listen" "$auth" "$outbound" >"$tmp"; cp -a "$old_config" "$backup"
  install -o root -g hysteria -m 640 "$tmp" "$old_config"
  if ! start_checked "$old_service" "$old_listen"; then
    warn "新 ISP 配置启动失败，恢复旧配置。"; install -o root -g hysteria -m 640 "$backup" "$old_config"; systemctl restart "$old_service" || true; die "更换失败，旧配置已恢复。"
  fi
  save_node "$id" isp "$old_name" "$old_listen" "$old_public" "$old_service" "$old_config" "$old_uri" "$old_mode"
  printf 'SOCKS_EXIT_IP=%q\nSOCKS_UDP=%q\n' "$SOCKS_EXIT_IP" "$SOCKS_UDP" >>"$f"
  unset SOCKS_PASS
  ok "$old_name 已更换 ISP；HY2 链接和密码保持不变。"
}

recorded_port_free() {
  local port=$1 field=$2 except=${3:-} f
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    [[ $f != "$NODE_DIR/$except.env" ]] || continue
    if grep -Fxq "$field=$port" "$f"; then return 1; fi
  done
  return 0
}

change_node_port() (
  load_manager
  # Subshell-scoped (not function-local): Bash may unwind locals before an
  # EXIT trap caused by errexit, and rollback must still see this state.
  id=${1:-}; new_listen=""; new_public=""; old_listen=""; old_public=""; work=""
  changed=0; committed=0; new_rule=0
  [[ -n $id ]] || id=$(select_node) || return $?
  [[ $id =~ ^(direct|isp[0-9]+)$ ]] || die "无效节点。"
  load_node "$id"
  [[ $CONFIG == "$HYSTERIA_DIR/$id.yaml" && $URI_FILE == "$EXPORT_DIR/hy2-$id.txt" ]] || die "仅支持管理器标准路径下的节点，未修改配置。"
  old_listen=$LISTEN_PORT; old_public=$PUBLIC_PORT
  while true; do
    new_listen=$(ask_valid_port "修改 $NAME" "内部 UDP 端口" "$old_listen") || return $?
    if [[ $new_listen == "$old_listen" ]] || { port_free "$new_listen" udp && recorded_port_free "$new_listen" LISTEN_PORT "$id"; }; then break; fi
    warn "该端口被服务或其他节点占用。"
  done
  new_public=$new_listen
  if [[ $NETWORK_MODE == nat ]]; then
    while true; do
      new_public=$(ask_valid_port "NAT 映射" "公网 UDP 端口（还需手动修改服务商映射）" "$old_public") || return $?
      recorded_port_free "$new_public" PUBLIC_PORT "$id" && break
      warn "该公网端口已被其他节点记录。"
    done
  fi
  if [[ $new_listen == "$old_listen" && $new_public == "$old_public" ]]; then ok "端口未改变。"; return 0; fi
  confirm "将 $NAME 端口 $old_listen/$old_public 改为 $new_listen/$new_public（内部/公网）？可能短暂断连，客户端需更新链接。" || return 0
  work=$(mktemp -d "$STATE_DIR/.port-change.XXXXXX")
  # Called by EXIT/INT/TERM rather than a direct function invocation.
  # shellcheck disable=SC2317
  port_change_cleanup() {
    local rc=$? restored=1
    trap - EXIT INT TERM
    if ((changed && !committed)); then
      install -o root -g hysteria -m 640 "$work/config.before" "$CONFIG" || restored=0
      install -o root -g root -m 600 "$work/uri.before" "$URI_FILE" || restored=0
      install -o root -g root -m 600 "$work/state.before" "$NODE_DIR/$id.env" || restored=0
      if [[ $new_listen != "$old_listen" ]]; then start_checked "$SERVICE" "$old_listen" || restored=0; fi
      if ((new_rule)); then close_firewall "$new_listen" udp || restored=0; fi
      if ((restored)); then warn "修改未完成，已恢复旧配置和端口。"; else warn "自动恢复未完成，保留备份：$work"; rc=1; fi
    fi
    if ((restored)); then rm -rf -- "$work"; fi
    cleanup
    exit "$rc"
  }
  trap port_change_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  cp -p "$CONFIG" "$work/config.before"
  cp -p "$URI_FILE" "$work/uri.before"
  cp -p "$NODE_DIR/$id.env" "$work/state.before"
  python3 - "$work" "$old_listen" "$new_listen" "$new_public" <<'PY'
from pathlib import Path
import re, sys
from urllib.parse import urlsplit, urlunsplit
root, old, new, public = Path(sys.argv[1]), *sys.argv[2:]
config = (root / 'config.before').read_text(encoding='utf-8')
config, count = re.subn(r'^listen: :' + re.escape(old) + r'[ \t]*$', 'listen: :' + new, config, flags=re.M)
if count != 1:
    raise SystemExit('不支持的监听配置，未修改原文件')
uri = urlsplit((root / 'uri.before').read_text(encoding='utf-8').strip())
if uri.scheme != 'hysteria2' or not uri.hostname or not uri.username:
    raise SystemExit('无法识别节点链接，未修改原文件')
authority = uri.netloc.rsplit(':', 1)[0] + ':' + public
state = (root / 'state.before').read_text(encoding='utf-8')
for field, value in [('LISTEN_PORT', new), ('PUBLIC_PORT', public)]:
    state, count = re.subn(r'^' + field + r'=.*$', field + '=' + value, state, flags=re.M)
    if count != 1:
        raise SystemExit('节点状态字段无效，未修改原文件')
(root / 'config.new').write_text(config, encoding='utf-8', newline='\n')
(root / 'uri.new').write_text(urlunsplit(uri._replace(netloc=authority)) + '\n', encoding='utf-8', newline='\n')
(root / 'state.new').write_text(state, encoding='utf-8', newline='\n')
PY
  changed=1
  if [[ $new_listen != "$old_listen" ]]; then
    if ! grep -Fxq "$new_listen/udp" "$FIREWALL_STATE" 2>/dev/null; then new_rule=1; fi
    open_firewall "$new_listen" udp
  fi
  install -o root -g hysteria -m 640 "$work/config.new" "$CONFIG"
  install -o root -g root -m 600 "$work/uri.new" "$URI_FILE"
  if [[ $new_listen != "$old_listen" ]]; then
    start_checked "$SERVICE" "$new_listen" || die "新端口启动检查失败。"
  fi
  install -o root -g root -m 600 "$work/state.new" "$NODE_DIR/$id.env"
  committed=1
  if [[ $new_listen != "$old_listen" ]]; then close_firewall "$old_listen" udp || warn "旧防火墙规则清理失败，请检查。"; fi
  [[ $NETWORK_MODE != nat ]] || warn "请修改服务商映射：公网 UDP $new_public → 内部 UDP $new_listen。"
  ok "端口已更新，密码及 ISP 凭据保持不变，请重新导入节点链接。"
)

show_managed_node() {
  local f=$1 uri
  unset ID TYPE NAME LISTEN_PORT PUBLIC_PORT SERVICE URI_FILE SOCKS_EXIT_IP SOCKS_UDP
  # shellcheck disable=SC1090
  source "$f"
  printf '\n%s\n  内部 UDP: %s  公网 UDP: %s  服务: %s\n' "$NAME" "$LISTEN_PORT" "$PUBLIC_PORT" "$SERVICE"
  [[ -z ${SOCKS_EXIT_IP:-} ]] || printf '  ISP 出口: %s  SOCKS UDP: %s\n' "$SOCKS_EXIT_IP" "${SOCKS_UDP:-unknown}"
  if [[ -r ${URI_FILE:-} ]] && confirm "显示 $NAME 的完整敏感导入链接和二维码？"; then
    uri=$(<"$URI_FILE"); printf '%s\n' "$uri"
    if command -v qrencode >/dev/null && is_tty; then printf '%s' "$uri" | qrencode -t ANSIUTF8 || true; fi
  fi
}

show_legacy_direct() {
