    done
  else public_port=$listen_port; fi
  auth=$(openssl rand -hex 24); config="$HYSTERIA_DIR/direct.yaml"; service=hy2m-direct.service; uri_file="$EXPORT_DIR/hy2-direct.txt"
  tmp=$(mktemp); cleanup_files+=("$tmp"); write_common_config "$listen_port" "$auth" >"$tmp"
