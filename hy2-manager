    2) ui_run create_direct ;;
    0) return 0 ;;
  esac
}

ui_cert_menu() {
  local c
  while true; do
    c=$(ui_menu "域名与证书" "共用一套证书；查看状态不会执行续期" \
      "1|查看证书 / 续期计划" "2|查看最近续期日志" "3|更换域名（重建全部链接）" "0|返回") || return 0
    case $c in
      0) return 0 ;;
      1) ui_run certificate_details ;;
      2) ui_run journalctl -u certbot.service -u hy2-cert-guard.service -n 60 --no-pager ;;
      3) ui_run change_domain ;;
    esac
  done
}

ui_diag_menu() {
  local c
  c=$(ui_menu "诊断与备份" "诊断只读，不自动修改系统" \
    "1|检查节点、证书与网络" "2|备份配置" "3|列出备份" "4|还原备份" "0|返回") || return 0
  case $c in
    1) ui_run diagnose ;;
    2) ui_run make_backup ;;
    3) ui_run list_backups ;;
    4) ui_run restore_backup ;;
    0) return 0 ;;
  esac
}

ui_advanced_menu() {
  local c
  c=$(ui_menu "高级设置" "卸载前会备份配置；不会修改 SSH" \
    "1|查看版本与命令帮助" "2|卸载本管理器及其节点" "0|返回") || return 0
  case $c in
    1) ui_run usage ;;
    2) ui_run uninstall_all ;;
    0) return 0 ;;
  esac
}

# Screen traps belong to this subshell; caller cleanup/signal traps stay intact.
ui_main_loop() (
  local -a ids=()
  local sel=0 key id i choice
  ui_init_colors
  trap 'ui_leave_screen' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  ui_enter_screen
  while true; do
    if [[ ! -r $MANAGER_STATE ]]; then
      choice=$(ui_menu "$APP_NAME $APP_VERSION" "尚未安装：系统检查 → 域名 → 证书 → 直连 → ISP" \
        "1|开始全新安装" "0|退出") || break
      case $choice in 1) ui_run initial_install ;; 0) break ;; esac
      continue
    fi
    load_manager
    ui_refresh_status
    ids=()
    while IFS= read -r id; do ids+=("$id"); done < <(ui_node_ids)
    if (( sel >= ${#ids[@]} )); then sel=$(( ${#ids[@]} - 1 )); fi
    if (( sel < 0 )); then sel=0; fi
    ui_draw_panel "$sel" ${ids[@]+"${ids[@]}"}
    key=$(ui_readkey)
    case $key in q|Q|quit|esc) break ;; esac
    ui_dimensions
    if (( UI_COLS < UI_MIN_COLS || UI_ROWS < UI_MIN_ROWS )); then continue; fi
    case $key in
      up|k) if (( sel > 0 )); then sel=$((sel - 1)); fi ;;
      down|j) if (( sel < ${#ids[@]} - 1 )); then sel=$((sel + 1)); fi ;;
      pageup) sel=$((sel - UI_PAGE_SIZE)); (( sel >= 0 )) || sel=0 ;;
      pagedown) sel=$((sel + UI_PAGE_SIZE)); (( sel < ${#ids[@]} )) || sel=$(( ${#ids[@]} - 1 )) ;;
      enter) if ((${#ids[@]})); then ui_node_actions "${ids[sel]}"; fi ;;
      a|A) ui_add_menu ;;
      c|C) ui_cert_menu ;;
      d|D) ui_diag_menu ;;
      s|S) ui_advanced_menu ;;
      [1-9])
        i=$((key - 1))
        if (( i < ${#ids[@]} )); then sel=$i; ui_node_actions "${ids[sel]}"; fi
        ;;
    esac
    [[ -r $MANAGER_STATE ]] || break
  done
  return 0
)

main_menu() {
  local c prompt
  if ui_requested && { [[ -r $MANAGER_STATE ]] || ! legacy_direct_available; }; then
    ui_main_loop
    return 0
  fi
  while true; do
    if [[ ! -r $MANAGER_STATE ]] && ! legacy_direct_available; then
      c=$(choose "$APP_NAME $APP_VERSION" "尚未安装：系统检查 → 自定义域名 → 证书 → 直连 → 可选 ISP" 1 "开始全新安装" 0 "退出") || return 0
      case $c in 1) menu_action initial_install ;; 0) return 0 ;; *) warn "无效选择。" ;; esac
      continue
    fi
    prompt=$(dashboard)
    if [[ ! -r $MANAGER_STATE ]]; then
      c=$(choose "现有节点（只读兼容）" "$prompt" 1 "查看现有节点" 2 "域名与证书" 0 "退出") || return 0
      case $c in 1) menu_action show_nodes ;; 2) certificate_menu ;; 0) return 0 ;; *) warn "无效选择。" ;; esac
      continue
    fi
    c=$(choose "HY2 管理面板" "$prompt" 1 "管理节点" 2 "添加节点" 3 "域名与证书" 4 "诊断与备份" 5 "高级设置" 0 "退出") || return 0
    case $c in
      1) node_menu ;; 2) add_node_menu ;; 3) certificate_menu ;; 4) maintenance_menu ;; 5) advanced_menu ;; 0) return 0 ;; *) warn "无效选择。" ;;
    esac
    [[ -r $MANAGER_STATE ]] || return 0;
  done
}

usage() {
  cat <<EOF
$APP_NAME $APP_VERSION
用法（hy2 为快捷入口，普通用户自动请求 sudo 权限）：
  hy2
  hy2 status
  hy2 change-port
  hy2 change-domain
  hy2 rename-node
  hy2 node-log
  hy2 traffic
  hy2 start-node
  hy2 stop-node
  hy2 restart-node
  sudo bash hy2-manager install-self
  sudo hy2-manager install
  sudo hy2-manager create-direct
  sudo hy2-manager add-isp
  sudo hy2-manager replace-isp
  sudo hy2-manager show
  sudo hy2-manager export-clash [direct|isp1|...]  # stdout 为完整敏感 YAML
  sudo hy2-manager status
  sudo hy2-manager diagnose
  sudo hy2-manager backup
  sudo hy2-manager backups
  sudo hy2-manager restore-backup
  sudo hy2-manager remove-node
  sudo hy2-manager uninstall
  sudo hy2-manager menu
EOF
}

main() {
  local cmd=${1:-menu}
  case $cmd in -h|--help|help) usage; return ;; version|--version) printf '%s\n' "$APP_VERSION"; return ;; esac
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    require_cmd sudo
    exec sudo -- bash "$0" "$@"
  fi
  case $cmd in
    renew-certificate) with_mutation_lock --wait renew_certificate ;; install-self) with_mutation_lock install_self ;; install) with_mutation_lock initial_install ;; create-direct) with_mutation_lock create_direct ;; add-isp) with_mutation_lock create_isp ;; replace-isp) with_mutation_lock replace_isp "${2:-}" ;; change-port) with_mutation_lock change_node_port "${2:-}" ;; change-domain) with_mutation_lock change_domain ;; rename-node) with_mutation_lock rename_node "${2:-}" ;; node-log) node_log "${2:-}" "${3:-60}" ;; traffic) node_traffic "${2:-}" ;; start-node) with_mutation_lock start_node "${2:-}" ;; stop-node) with_mutation_lock stop_node "${2:-}" ;; restart-node) with_mutation_lock restart_node "${2:-}" ;; show) show_nodes ;; export-clash) export_clash "${2:-}" ;; status) status_all ;; diagnose) diagnose ;; backup) with_mutation_lock make_backup ;; backups) list_backups ;; restore-backup) with_mutation_lock restore_backup "${2:-}" ;; remove-node) with_mutation_lock remove_node "${2:-}" ;; uninstall) with_mutation_lock uninstall_all ;; menu) main_menu ;; *) usage; exit 2 ;;
  esac
}

if [[ ${HY2M_SOURCE_ONLY:-0} != 1 ]]; then
  main "$@"
fi
