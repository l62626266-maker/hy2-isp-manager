    unset NAME SERVICE LISTEN_PORT PUBLIC_PORT
    # shellcheck disable=SC1090
    source "$f"
    printf '%-28s active=%-8s enabled=%-8s 内部/公网 UDP=%s/%s\n' "$NAME" "$(systemctl is-active "$SERVICE" 2>/dev/null || true)" "$(systemctl is-enabled "$SERVICE" 2>/dev/null || true)" "$LISTEN_PORT" "$PUBLIC_PORT"
    found=$((found + 1))
  done
  if [[ ! -r $NODE_DIR/direct.env ]] && legacy_direct_available; then
    port=$(legacy_direct_port)
    printf '%-28s active=%-8s enabled=%-8s 内部/公网 UDP=%s/%s\n' "HY2-Direct（现有兼容节点）" "$(systemctl is-active "$LEGACY_SERVICE" 2>/dev/null || true)" "$(systemctl is-enabled "$LEGACY_SERVICE" 2>/dev/null || true)" "$port" "$port"
    found=$((found + 1))
  fi
  ((found > 0)) || die "没有节点。"
}

diagnose() {
  local cert_file="$TLS_DIR/fullchain.pem" domain=""
  status_all
  [[ -r $cert_file ]] || cert_file=$LEGACY_TLS_CERT
  printf '\nTLS:\n'; if [[ -r $cert_file ]]; then openssl x509 -in "$cert_file" -noout -subject -issuer -dates || true; else warn "未找到可读证书。"; fi
  printf '\n网络优化:\n'; sysctl net.ipv4.tcp_congestion_control net.core.default_qdisc net.core.rmem_max net.core.wmem_max 2>/dev/null || true; swapon --show || true
  printf '\n监听:\n'; ss -lunp | grep hysteria || true
  domain=${DOMAIN:-}; [[ -n $domain ]] || domain=$(legacy_domain || true)
  printf '\nDNS:\n'; if [[ -n $domain ]]; then dig +short A "$domain" || true; else warn "没有可用域名记录。"; fi
  printf '\n注意：NAT 公网 UDP 映射必须从 VPS 外部用真实客户端验证，VPS 内部检查不能证明运营商映射可达。\n'
}

remove_node() {
  load_manager; local id=${1:-} f
  [[ -n $id ]] || id=$(select_node) || return $?
  [[ $id =~ ^(direct|isp[0-9]+)$ ]] || die "无效节点。"
  f="$NODE_DIR/$id.env"; [[ -r $f ]] || die "节点不存在。"
  if [[ $id == direct ]]; then
    shopt -s nullglob
    local isp_nodes=("$NODE_DIR"/isp*.env)
    ((${#isp_nodes[@]} == 0)) || die "仍有ISP节点依赖Direct，请先逐个删除ISP节点。"
  fi
  unset SERVICE CONFIG URI_FILE LISTEN_PORT
  # shellcheck disable=SC1090
  source "$f"
  confirm "确定删除 ${NAME:-$id}（$id，公网端口 $PUBLIC_PORT）？此节点链接将失效，不影响 SSH。" || return 0
  systemctl disable --now "$SERVICE" || die "停止节点失败，未删除配置。"
  rm -f "$SERVICE_DIR/$SERVICE" "$CONFIG" "$URI_FILE" "$f"; close_firewall "$LISTEN_PORT" udp; systemctl daemon-reload
  ok "节点 $id 已删除。"
}

uninstall_all() {
  [[ -r $MANAGER_STATE ]] || die "未检测到安装状态。"; confirm "完整卸载本管理器创建的节点？SSH 和其他服务不会被修改。" || return 0
  make_backup; local f
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    unset SERVICE CONFIG URI_FILE LISTEN_PORT
    # shellcheck disable=SC1090
    source "$f"
    systemctl disable --now "$SERVICE" >/dev/null 2>&1 || true; rm -f "$SERVICE_DIR/$SERVICE" "$CONFIG" "$URI_FILE"; close_firewall "$LISTEN_PORT" udp
  done
  if [[ -r $FIREWALL_STATE ]]; then while IFS=/ read -r port proto; do close_firewall "$port" "$proto"; done < <(cp "$FIREWALL_STATE" /dev/stdout); fi
  systemctl daemon-reload; rm -rf "$STATE_DIR" "$HYSTERIA_DIR" "$EXPORT_DIR"; rm -f /etc/letsencrypt/renewal-hooks/deploy/hy2-manager-copy.sh
  local shortcut
  for shortcut in "$SBIN_DIR/hy2" "$BIN_DIR/hy2"; do
    if [[ -L $shortcut && $(readlink "$shortcut") == "$APP_DIR/hy2-manager" ]]; then rm -f "$shortcut"; fi
  done
