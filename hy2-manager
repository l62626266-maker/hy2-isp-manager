      [[ -L $shortcut && $(readlink "$shortcut") == "$APP_DIR/hy2-manager" ]] || die "$shortcut 已被其他程序占用，未覆盖。"
    fi
  done
  install -d -o root -g root -m 755 "$APP_DIR" "$SBIN_DIR" "$BIN_DIR"
