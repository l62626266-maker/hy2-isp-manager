}

status_all() {
  ensure_inventory_dependencies
  local f found=0 port domain=""; shopt -s nullglob
  if load_manager_optional; then printf '%s %s\n域名: %s\n网络类型: %s\n\n' "$APP_NAME" "$APP_VERSION" "$DOMAIN" "$NETWORK_MODE"
  else domain=$(legacy_domain || true); printf '%s %s\n%s\n\n' "$APP_NAME" "$APP_VERSION" "现有兼容节点视图${domain:+；域名: $domain}"; fi
