select_node() {
  local filter=${1:-all} f id selected i
  local ids=() options=()
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    id=${f##*/}; id=${id%.env}
    [[ $id =~ ^(direct|isp[0-9]+)$ ]] || continue
    [[ $filter == all || $id == isp* ]] || continue
    ids+=("$id"); options+=("${#ids[@]}" "$(node_brief "$f")")
  done
  ((${#ids[@]})) || { warn "没有可管理的节点。"; return 20; }
  options+=(0 "返回")
  while true; do
    selected=$(choose "选择节点" "选择节点，无需手输 ID" "${options[@]}") || return $?
    [[ $selected != 0 ]] || return 20
    for ((i=0; i<${#ids[@]}; i++)); do
      if [[ $selected == "$((i+1))" ]]; then printf '%s' "${ids[i]}"; return 0; fi
    done
    warn "请选择列表中的编号。"
  done
}
node_menu() {
  local id c prompt
  local options=()
  while true; do
    id=$(select_node) || return 0
    while [[ -r $NODE_DIR/$id.env ]]; do
      load_node "$id"
      prompt=$(node_brief "$NODE_DIR/$id.env")
      options=(1 "查看详情、链接 / 二维码" 2 "修改端口" 3 "启动 / 停止 / 重启" 4 "查看日志" 5 "运行时长与流量" 6 "重命名")
      [[ $TYPE != isp ]] || options+=(7 "更换 ISP（保留 HY2 链接）")
      options+=(8 "删除此节点" 9 "导出 Clash/Mihomo YAML" 0 "返回节点列表")
      c=$(choose "管理 $NAME" "$prompt" "${options[@]}") || break
      case $c in
        0) break ;;
        1) menu_action show_managed_node "$NODE_DIR/$id.env" ;;
        2) menu_action change_node_port "$id" ;;
        3) node_power_menu "$id" ;;
        4) menu_action node_log "$id" ;;
        5) menu_action node_traffic "$id" ;;
        6) menu_action rename_node "$id" ;;
        7) if [[ $TYPE == isp ]]; then menu_action replace_isp "$id"; else warn "直连节点没有 ISP 凭据。"; fi ;;
        8) menu_action remove_node "$id" ;;
        9) menu_action show_clash_export "$id" ;;
        *) warn "请选择列出的选项。" ;;
      esac
    done
  done
}
