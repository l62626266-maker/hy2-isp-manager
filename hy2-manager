#!/usr/bin/env bash
# shellcheck disable=SC2034
set -Eeuo pipefail
umask 077

readonly APP_NAME="HY2 ISP Manager"
readonly APP_VERSION="0.3.0-dev"
readonly APP_DIR="${HY2M_APP_DIR:-/opt/hy2-isp-manager}"
readonly STATE_DIR="${HY2M_STATE_DIR:-/etc/hy2-isp-manager}"
readonly NODE_DIR="$STATE_DIR/nodes"
readonly SERVICE_DIR="${HY2M_SERVICE_DIR:-/etc/systemd/system}"
readonly SBIN_DIR="${HY2M_SBIN_DIR:-/usr/local/sbin}"
readonly BIN_DIR="${HY2M_BIN_DIR:-/usr/local/bin}"
readonly EXPORT_DIR="${HY2M_EXPORT_DIR:-/root/hy2-export}"
readonly HYSTERIA_DIR="${HY2M_HYSTERIA_DIR:-/etc/hysteria-hy2m}"
readonly TLS_DIR="$HYSTERIA_DIR/tls"
readonly BACKUP_DIR="${HY2M_BACKUP_DIR:-/root/hy2-manager-backups}"
readonly HYSTERIA_VERSION="${HY2M_HYSTERIA_VERSION:-v2.12.2}"
readonly HYSTERIA_BIN="${HY2M_HYSTERIA_BIN:-$APP_DIR/bin/hysteria}"
readonly MANAGER_STATE="$STATE_DIR/manager.env"
readonly CF_CREDENTIALS="$STATE_DIR/cloudflare.ini"
readonly LETSENCRYPT_DIR="${HY2M_LETSENCRYPT_DIR:-/etc/letsencrypt}"
readonly RENEWAL_HOOK="$LETSENCRYPT_DIR/renewal-hooks/deploy/hy2-manager-copy.sh"
readonly SYSCTL_FILE="${HY2M_SYSCTL_FILE:-/etc/sysctl.d/99-hy2-manager.conf}"
readonly SWAP_FILE="${HY2M_SWAP_FILE:-/swapfile-hy2m}"
readonly FIREWALL_STATE="$STATE_DIR/firewall.rules"
readonly INSTALL_SESSION="$STATE_DIR/install-session.env"
readonly LEGACY_CONFIG="${HY2M_LEGACY_CONFIG:-/etc/hysteria/config.yaml}"
readonly LEGACY_MANAGER_CONFIG="${HY2M_LEGACY_MANAGER_CONFIG:-/etc/hysteria/manager.conf}"
readonly LEGACY_URI_FILE="${HY2M_LEGACY_URI_FILE:-/root/hy2-direct-node.txt}"
readonly LEGACY_SERVICE="${HY2M_LEGACY_SERVICE:-hysteria-server.service}"
readonly LEGACY_TLS_CERT="${HY2M_LEGACY_TLS_CERT:-/etc/hysteria/tls/fullchain.pem}"

C_RESET='\033[0m'; C_BLUE='\033[1;34m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'
# Values loaded from root-owned state files. Declarations also document the state schema.
# shellcheck disable=SC2034
DOMAIN=""; PUBLIC_IP=""; NETWORK_MODE=""; CERT_MODE=""
# shellcheck disable=SC2034
ID=""; TYPE=""; NAME=""; LISTEN_PORT=""; PUBLIC_PORT=""; SERVICE=""; CONFIG=""; URI_FILE=""; SOCKS_EXIT_IP=""; SOCKS_UDP=""
SOCKS_HOST=""; SOCKS_PORT=""; SOCKS_USER=""; SOCKS_PASS=""
log() { printf "${C_BLUE}[信息]${C_RESET} %s\n" "$*"; }
ok() { printf "${C_GREEN}[成功]${C_RESET} %s\n" "$*"; }
warn() { printf "${C_YELLOW}[注意]${C_RESET} %s\n" "$*" >&2; }
die() { printf "${C_RED}[错误]${C_RESET} %s\n" "$*" >&2; exit 1; }

cleanup_files=()
cleanup() { local f; for f in "${cleanup_files[@]:-}"; do [[ -z "$f" ]] || rm -f -- "$f"; done; }
trap cleanup EXIT

require_root() { [[ ${HY2M_TESTING:-0} == 1 || ${EUID:-$(id -u)} -eq 0 ]] || die "请使用 root 运行：sudo hy2-manager"; }
require_systemd() { if ! command -v systemctl >/dev/null || [[ ! -d /run/systemd/system ]]; then die "需要正在运行的 systemd。"; fi; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "缺少命令：$1"; }

valid_port() { [[ $1 =~ ^[0-9]{1,5}$ ]] && (( 10#$1 >= 1 && 10#$1 <= 65535 )); }
valid_domain() { [[ $1 =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; }
valid_ipv4() { local IFS=. p n=0; read -r -a p <<<"$1"; ((${#p[@]} == 4)) || return 1; for n in "${p[@]}"; do [[ $n =~ ^[0-9]{1,3}$ ]] && ((10#$n <= 255)) || return 1; done; }
valid_host() { [[ -n $1 && $1 != *[[:space:]/]* ]]; }
valid_name() { [[ $1 =~ ^[A-Za-z0-9._-]{1,48}$ ]]; }
host_port() { if [[ $1 == *:* && $1 != \[*\] ]]; then printf '[%s]:%s' "$1" "$2"; else printf '%s:%s' "$1" "$2"; fi; }
yaml_quote() { local v=$1; v=${v//\\/\\\\}; v=${v//\"/\\\"}; v=${v//$'\t'/\\t}; printf '"%s"' "$v"; }
uri_encode() { python3 - "$1" <<'PY'
import sys, urllib.parse
print(urllib.parse.quote(sys.argv[1], safe=''))
PY
}

# stdout is captured by $(ask/choose); dialogs use stderr.
is_tty() { [[ -t 0 && -t 2 ]]; }
has_whiptail() { is_tty && command -v whiptail >/dev/null 2>&1; }
ask() {
  local title=$1 prompt=$2 default=${3:-} out
  if has_whiptail; then
    out=$(whiptail --title "$title" --ok-button "确定" --cancel-button "返回" --inputbox "$prompt" 0 0 "$default" 3>&1 1>&2 2>&3) || return 20
  else
    read -r -p "$prompt${default:+ [$default]}（:menu 返回）: " out || return 20
    [[ -n $out ]] || out=$default
  fi
  if [[ $out == :menu ]]; then warn "已取消当前操作，返回主菜单。"; return 20; fi
  printf '%s' "$out"
}
ask_valid() {
  local title=$1 prompt=$2 default=$3 validator=$4 error_text=$5 out
  while true; do
    out=$(ask "$title" "$prompt" "$default") || return $?
    if "$validator" "$out"; then printf '%s' "$out"; return 0; fi
    warn "$error_text 请重新输入，或输入 :menu 返回主菜单。"
  done
}
ask_valid_port() { local port; port=$(ask_valid "$1" "$2" "$3" valid_port "端口必须是 1-65535 的整数。") || return $?; printf '%d' "$((10#$port))"; }
ask_valid_domain() { ask_valid "$1" "$2" "$3" valid_domain "域名格式无效。"; }
ask_valid_ipv4() { ask_valid "$1" "$2" "$3" valid_ipv4 "IPv4 格式无效。"; }
ask_valid_host() { ask_valid "$1" "$2" "$3" valid_host "地址格式无效。"; }
ask_valid_name() { ask_valid "$1" "$2" "$3" valid_name "名称只允许字母、数字、点、下划线和短横线，最长 48 个字符。"; }
ask_secret() {
  local title=$1 prompt=$2 out
  if has_whiptail; then
    out=$(whiptail --title "$title" --ok-button "确定" --cancel-button "返回" --passwordbox "$prompt" 0 0 3>&1 1>&2 2>&3) || return 20
  else
    read -r -s -p "$prompt（:menu 返回）: " out || return 20
    printf '\n' >&2
  fi
  [[ $out != :menu ]] || return 20
  printf '%s' "$out"
}
# One persistent lock inode, outside trees replaced by restore/uninstall.
# The same protocol is used by the standalone guard and generated renewal hook.
with_mutation_lock() (
  local lock_file="${HY2_LOCK_FILE:-/run/lock/hy2-isp-manager.lock}" lock_fd
  local -a lock_args=(-n)
  if [[ ${1:-} == --wait ]]; then lock_args=(-w 300); shift; fi
  command -v flock >/dev/null 2>&1 || { printf '缺少 flock，拒绝无锁修改。\n' >&2; return 1; }
  [[ -d ${lock_file%/*} && ! -L $lock_file ]] || return 1
  exec {lock_fd}>>"$lock_file" || return 1
  flock "${lock_args[@]}" "$lock_fd" || { printf '另一个 HY2 操作正在执行，请稍后重试。\n' >&2; return 75; }
  "$@"
)
mutation_action() {
  case $1 in
    initial_install|install_self|create_direct|create_isp|replace_isp|change_node_port|change_domain|rename_node|start_node|stop_node|restart_node|remove_node|uninstall_all|make_backup|restore_backup|certificate_http|certificate_cloudflare|copy_certificate|renew_certificate) return 0 ;;
    *) return 1 ;;
  esac
}

run_menu_action() {
  local rc
  set +e
  ( set -Eeuo pipefail; trap cleanup EXIT;
    if mutation_action "$1"; then with_mutation_lock "$@"; else "$@"; fi
  )
  rc=$?
  set -e
  if ((rc != 0 && rc != 20)); then warn "当前操作未完成（错误码 $rc），已返回菜单，请查看上方原因。"; fi
  return 0
}
confirm() {
  local prompt=$1
  if has_whiptail; then whiptail --title "$APP_NAME" --yes-button "确认" --no-button "取消" --defaultno --yesno "$prompt" 0 0; return; fi
  local ans; read -r -p "$prompt [y/N]: " ans || return 1; [[ $ans =~ ^[Yy]$ ]]
}
choose() {
  local title=$1 prompt=$2; shift 2
  if has_whiptail; then
    whiptail --title "$title" --ok-button "确定" --cancel-button "返回" --menu "$prompt" 0 0 0 "$@" 3>&1 1>&2 2>&3 || return 20
    return 0
  fi
  local args=("$@") i
  printf '\n%s\n' "$prompt" >&2
  for ((i=0; i<${#args[@]}; i+=2)); do printf '  %s) %s\n' "${args[i]}" "${args[i+1]}" >&2; done
  local choice; read -r -p "请选择（:menu 返回）: " choice || return 20
  [[ $choice != :menu ]] || return 20
  printf '%s' "$choice"
}

write_env() {
  local path=$1; shift; local tmp key value
  [[ ! -L $path && -d ${path%/*} && $# -gt 0 && $(( $# % 2 )) == 0 ]] || return 1
  tmp=$(mktemp "${path%/*}/.state.XXXXXX") || return 1
  cleanup_files+=("$tmp")
  while (( $# )); do
    key=$1; value=$2; shift 2
    [[ $key =~ ^[A-Z_][A-Z_0-9]*$ ]] || { rm -f -- "$tmp"; return 1; }
    printf '%s=%q\n' "$key" "$value" >>"$tmp" || return 1
  done
  chmod 600 "$tmp" || return 1
  if [[ ${HY2M_TESTING:-0} != 1 ]]; then chown root:root "$tmp" || return 1; fi
  mv -f -- "$tmp" "$path"
}

# 装文件时统一走这里：测试环境没有 root/hysteria 账户，跳过属主设置。
install_owned() {
  local mode=$1 group=$2 src=$3 dst=$4 tmp
  [[ ! -L $dst && ( ! -e $dst || -f $dst ) && -d ${dst%/*} ]] || return 1
  tmp=$(mktemp "${dst%/*}/.install.XXXXXXXX") || return 1
  cleanup_files+=("$tmp")
  if [[ ${HY2M_TESTING:-0} == 1 ]]; then
    install -m "$mode" "$src" "$tmp" || { rm -f -- "$tmp"; return 1; }
  else
    install -o root -g "$group" -m "$mode" "$src" "$tmp" || { rm -f -- "$tmp"; return 1; }
  fi
  if ! mv -f -- "$tmp" "$dst"; then rm -f -- "$tmp"; return 1; fi
}

install_dir() {
  local mode=$1 group=$2 dst=$3
  if [[ ${HY2M_TESTING:-0} == 1 ]]; then mkdir -p "$dst"
  else install -d -o root -g "$group" -m "$mode" "$dst"; fi
}

# write_env quotes values with %q, so a plain awk split would return escaped
# paths. Read one key in a subshell, the same way load_node reads the file.
env_get() (
  local key=$2
  # shellcheck disable=SC1090
  source "$1" >/dev/null 2>&1 || exit 1
  printf '%s' "${!key-}"
)
load_manager() { [[ -r $MANAGER_STATE ]] || die "尚未安装节点，请先运行安装。"
  # beta.3 and older wrote APP_VERSION into manager.env. Ignore that legacy
  # field so it cannot overwrite the manager's readonly runtime version.
  # shellcheck disable=SC1090
  source <(grep -v '^APP_VERSION=' "$MANAGER_STATE" || true)
}
load_node() { local f="$NODE_DIR/$1.env"; [[ -r $f ]] || die "节点不存在：$1"; # shellcheck disable=SC1090
  source "$f"; }
load_manager_optional() {
  [[ -r $MANAGER_STATE ]] || return 1
  # shellcheck disable=SC1090
  source <(grep -v '^APP_VERSION=' "$MANAGER_STATE" || true)
}
legacy_direct_available() { [[ -r $LEGACY_CONFIG ]] && grep -Eq '^[[:space:]]*listen:[[:space:]]*:[0-9]+' "$LEGACY_CONFIG"; }
legacy_direct_port() { awk -F: '/^[[:space:]]*listen:[[:space:]]*:[0-9]+/{gsub(/[[:space:]]/,"",$3); print $3; exit}' "$LEGACY_CONFIG"; }
legacy_domain() {
  local value=""
  if [[ -r $LEGACY_MANAGER_CONFIG ]]; then value=$(awk -F= '$1=="DOMAIN"{sub(/^[^=]*=/,""); print; exit}' "$LEGACY_MANAGER_CONFIG"); fi
  valid_domain "$value" && printf '%s' "$value"
}
ensure_inventory_dependencies() {
  shopt -s nullglob
  local isp_nodes=("$NODE_DIR"/isp*.env)
  if ((${#isp_nodes[@]} > 0)) && [[ ! -r $NODE_DIR/direct.env ]] && ! legacy_direct_available; then
    die "节点状态异常：存在ISP记录但缺少其依赖的Direct节点。请先备份并清理ISP记录。"
  fi
}

os_check() {
  [[ -r /etc/os-release ]] || die "无法识别操作系统。"
  # shellcheck disable=SC1091
  source /etc/os-release
  case "${ID:-}:${VERSION_ID:-}" in
    debian:12|debian:13|ubuntu:22.04|ubuntu:24.04) ;;
    ubuntu:26.04|ubuntu:26.10)
      warn "Ubuntu $VERSION_ID 为实验性兼容，尚未完成真实 VPS 集成验证。"
      confirm "建议先创建 VPS 快照；是否继续实验性安装？" || die "已取消安装，未安装依赖或修改服务。"
      ;;
    *) die "支持 Debian 12/13、Ubuntu 22.04/24.04；26.04/26.10 需确认实验性安装；当前是 ${PRETTY_NAME:-unknown}。" ;;
  esac
  case "$(uname -m)" in x86_64|aarch64|arm64) ;; *) die "不支持的架构：$(uname -m)" ;; esac
}

install_packages() {
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y --no-install-recommends bash ca-certificates certbot curl dnsutils iproute2 jq openssl python3 qrencode whiptail
}

install_hysteria() {
  local installed arch asset base hashes binary expected actual
  if [[ -x $HYSTERIA_BIN ]]; then
    installed=$($HYSTERIA_BIN version 2>/dev/null | awk -F'\t' '/Version:/{print $2; exit}')
    if [[ $installed == "$HYSTERIA_VERSION" ]]; then log "Hysteria $installed 已安装且版本正确。"; return; fi
  fi
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64|arm64) arch=arm64 ;; *) die "不支持的架构。" ;; esac
  asset="hysteria-linux-$arch"; base="https://github.com/apernet/hysteria/releases/download/app/$HYSTERIA_VERSION"
  hashes=$(mktemp); binary=$(mktemp); cleanup_files+=("$hashes" "$binary")
  log "下载并校验 Hysteria $HYSTERIA_VERSION ($arch)……"
  curl -fsSL --proto '=https' --tlsv1.2 --retry 3 "$base/hashes.txt" -o "$hashes"
  curl -fsSL --proto '=https' --tlsv1.2 --retry 3 "$base/$asset" -o "$binary"
  expected=$(awk -v n="build/$asset" '$2==n{print $1; exit}' "$hashes")
  [[ $expected =~ ^[0-9a-f]{64}$ ]] || die "官方 hashes.txt 中找不到 $asset。"
  actual=$(sha256sum "$binary"); actual=${actual%% *}; [[ $actual == "$expected" ]] || die "Hysteria SHA256 校验失败。"
  install -d -o root -g root -m 755 "$(dirname "$HYSTERIA_BIN")"
  install -o root -g root -m 755 "$binary" "$HYSTERIA_BIN"
  ok "Hysteria 已通过官方 SHA256 校验。"
}

ensure_layout() {
  id hysteria >/dev/null 2>&1 || useradd --system --home-dir /var/lib/hysteria --create-home --shell /usr/sbin/nologin hysteria
  install -d -o root -g root -m 700 "$STATE_DIR" "$NODE_DIR" "$EXPORT_DIR" "$BACKUP_DIR"
  install -d -o root -g hysteria -m 750 "$HYSTERIA_DIR" "$TLS_DIR"
  install -d -o hysteria -g hysteria -m 750 /var/lib/hysteria
}

# Versioned relative archives; validate members/state before extraction or use.
# Old incomplete archives require manual recovery, not a guessed full restore.
backup_archive() {
  python3 - "$1" "$2" "${3:-}" "$STATE_DIR" "$HYSTERIA_DIR" "$EXPORT_DIR" "$SERVICE_DIR" "$RENEWAL_HOOK" "$BACKUP_DIR" <<'PY'
import io, json, os, re, shlex, shutil, sys, tarfile
from pathlib import Path, PurePosixPath
from urllib.parse import urlsplit, parse_qs

def native(value):
    if os.name == 'nt' and re.match(r'^/[a-zA-Z]/', value):
        value = value[1] + ':' + value[2:]
    return Path(os.path.abspath(value))

action, archive, dest = sys.argv[1:4]
# Windows text mode would emit CRLF and corrupt TSV plans; force LF everywhere.
for stream in (sys.stdout, sys.stderr):
    stream.reconfigure(newline='\n')
roots = dict(zip(('state', 'hysteria', 'export', 'services'), map(native, sys.argv[4:8])))
hook, backups = map(native, sys.argv[8:10])
unit_re = re.compile(r'hy2m-(direct|isp[0-9]+)\.service\Z')
node_re = re.compile(r'(direct|isp[0-9]+)\.env\Z')
word_re = re.compile(r'''(?:[A-Za-z0-9_./:@%+=,\-]+|\\[^\r\n]|'[^'\r\n]*'|"[^"$`\\\r\n]*")*\Z''')

def fail(message):
    raise ValueError(message)

def within(path, root):
    return path != root and root in path.parents

def check_path(path, root):
    if not within(path, root): fail('state path escapes its managed directory')
    for part in (path, *path.parents):
        if part.is_symlink(): fail('symlinks are not supported in managed paths')
        if part == root: break

def read_env(path, allowed):
    values = {}
    for line in path.read_text(encoding='utf-8').splitlines():
        if not line.strip() or line.startswith('#'): continue
        key, sep, raw = line.partition('=')
        if not sep or key not in allowed or key in values or not word_re.fullmatch(raw):
            fail('invalid or executable state assignment')
        parts = shlex.split(raw, comments=False, posix=True)
        if len(parts) > 1: fail('state assignment is not a single literal value')
        value = parts[0] if parts else ''
        if any(ord(c) < 32 or ord(c) == 127 for c in value): fail('control characters in state')
        values[key] = value
    return values

def inventory(base, strict):
    state = base / 'state' if base else roots['state']
    manager_fields = {'INSTALLED_VERSION','APP_VERSION','DOMAIN','PUBLIC_IP','NETWORK_MODE','CERT_MODE'}
    manager = read_env(state / 'manager.env', manager_fields) if (state / 'manager.env').exists() else {}
    if strict and (not manager.get('DOMAIN') or manager.get('NETWORK_MODE') not in ('normal', 'nat')):
        fail('missing or invalid manager state')
    fields = {'ID','TYPE','NAME','LISTEN_PORT','PUBLIC_PORT','SERVICE','CONFIG','URI_FILE','NETWORK_MODE','SOCKS_EXIT_IP','SOCKS_UDP'}
    result, ports = [], set()
    for file in sorted((state / 'nodes').glob('*.env')):
        if not node_re.fullmatch(file.name): fail('unrecognized node record')
        v = read_env(file, fields); node = file.stem
        if v.get('ID') != node or v.get('SERVICE') != 'hy2m-' + node + '.service': fail('node ID/service mismatch')
        port = v.get('LISTEN_PORT', '')
        if not port.isdecimal() or not 1 <= int(port) <= 65535: fail('invalid listener port')
        if strict:
            if int(port) in ports: fail('duplicate listener port')
            ports.add(int(port))
            if v.get('TYPE') != ('direct' if node == 'direct' else 'isp'): fail('invalid node type')
            public = v.get('PUBLIC_PORT', '')
            if not public.isdecimal() or not 1 <= int(public) <= 65535: fail('invalid public port')
            mapped = {}
            for field, section in (('CONFIG', 'hysteria'), ('URI_FILE', 'export')):
                original = native(v.get(field, '')); check_path(original, roots[section])
                mapped[field] = base / section / original.relative_to(roots[section])
                if not mapped[field].is_file(): fail('backup is missing a referenced config or export')
            uri = urlsplit(mapped['URI_FILE'].read_text(encoding='utf-8').strip())
            if (uri.scheme != 'hysteria2' or not uri.username or uri.hostname != manager['DOMAIN'].lower()
                    or uri.port != int(public) or parse_qs(uri.query).get('sni') != [manager['DOMAIN']]):
                fail('backup export does not match node/manager state')
            if not (base / 'services' / v['SERVICE']).is_file(): fail('backup is missing a managed service')
        result.append((node, v['SERVICE'], str(int(port))))
    if strict and (not result or any(n.startswith('isp') for n, _, _ in result) and not any(n == 'direct' for n, _, _ in result)):
        fail('backup has an incomplete node inventory')
    return result

try:
    trees = list(roots.values()) + [backups]
    for i, root in enumerate(trees):
        if root == Path(root.anchor) or root.is_symlink(): fail('unsafe managed root')
        for other in trees[i+1:]:
            if root == other or within(root, other) or within(other, root): fail('managed roots must not overlap')
    check_path(hook, hook.parent)
    if action == 'inventory':
        for entry in inventory(None, False): print('\t'.join(entry))
    elif action == 'pack':
        files = []
        for section in ('state', 'hysteria', 'export'):
            root = roots[section]
            if root.exists():
                files.append((root, section))
                files.extend((p, section + '/' + p.relative_to(root).as_posix()) for p in sorted(root.rglob('*')))
        files.extend((p, 'services/' + p.name) for p in sorted(roots['services'].glob('hy2m-*.service')) if unit_re.fullmatch(p.name))
        if hook.exists() or hook.is_symlink(): files.append((hook, 'renewal-hook'))
        if not files: fail('nothing to back up')
        if len(files) > 10000 or sum(p.stat().st_size for p, _ in files if p.is_file() and not p.is_symlink()) > 268435456:
            fail('managed backup exceeds safety limits')
        for p, _ in files:
            if p.is_symlink() or not (p.is_dir() or p.is_file()): fail('links and special files are not supported')
        meta = json.dumps({'format': 'hy2-manager-backup', 'version': 1}).encode()
        with tarfile.open(archive, 'w:gz') as out:
            header = tarfile.TarInfo('manifest.json'); header.size = len(meta); header.mode = 0o600
            out.addfile(header, io.BytesIO(meta))
            for path, name in files: out.add(path, arcname=name, recursive=False)
    elif action == 'stage':
        stage = native(dest)
        if stage.exists(): fail('staging destination must not exist')
        with tarfile.open(archive, 'r:gz') as source:
            members, seen, total = [], set(), 0
            for m in source:
                name = m.name.rstrip('/'); parts = PurePosixPath(name).parts
                if (not name or '\\' in name or name.startswith('/') or '..' in parts or '.' in name.split('/')
                        or any(ord(c) < 32 or ord(c) == 127 for c in name) or name in seen):
                    fail('unsafe or duplicate archive member')
                if not (m.isdir() or m.isfile()): fail('archive links/devices are forbidden')
                if parts[0] in ('state', 'hysteria', 'export'): pass
                elif name in ('manifest.json', 'renewal-hook'):
                    if not m.isfile(): fail('invalid metadata/hook type')
                elif parts[0] == 'services' and (len(parts) == 1 and m.isdir() or len(parts) == 2 and m.isfile() and unit_re.fullmatch(parts[1])): pass
                else: fail('unrecognized/old archive layout; manual recovery required')
                total += m.size
                if total > 268435456 or m.size > 67108864 or len(members) >= 10000: fail('archive exceeds safety limits')
                seen.add(name); members.append(m)
            if 'manifest.json' not in seen: fail('old incomplete archive: automatic restore refused')
            meta = json.load(source.extractfile('manifest.json'))
            if meta != {'format': 'hy2-manager-backup', 'version': 1}: fail('unsupported backup format')
            stage.mkdir(mode=0o700)
            for m in members:
                path = stage.joinpath(*PurePosixPath(m.name).parts)
                if m.isdir(): path.mkdir(parents=True, exist_ok=True)
                else:
                    path.parent.mkdir(parents=True, exist_ok=True)
                    with path.open('xb') as out, source.extractfile(m) as inp: shutil.copyfileobj(inp, out)
                    path.chmod(0o600)
        for section in ('state', 'hysteria', 'export'):
            if not (stage / section).is_dir(): fail('backup lacks a managed tree (including exports)')
        plan = inventory(stage, True)
        (stage / 'plan.tsv').write_text(''.join('\t'.join(row) + '\n' for row in plan), encoding='utf-8', newline='\n')
    else: fail('unknown archive operation')
except (OSError, ValueError, KeyError, tarfile.TarError) as exc:
    print('Backup validation failed: ' + str(exc), file=sys.stderr)
    sys.exit(1)
PY
}

make_backup() {
  local stamp target tmp
  [[ ! -L $BACKUP_DIR ]] || { warn "备份目录不能是符号链接。"; return 1; }
  mkdir -p "$BACKUP_DIR" && chmod 700 "$BACKUP_DIR" || return 1
  stamp=$(date +%Y%m%d-%H%M%S) || return 1
  tmp=$(mktemp "$BACKUP_DIR/.hy2m-$stamp.XXXXXX") || return 1
  target="$BACKUP_DIR/hy2m-$stamp-${tmp##*.}.tar.gz"
  if ! backup_archive pack "$tmp" || ! chmod 600 "$tmp"; then
    rm -f -- "$tmp"; warn "备份失败，未生成可还原的备份。"; return 1
  fi
  if [[ -e $target ]] || ! mv -- "$tmp" "$target"; then rm -f -- "$tmp"; return 1; fi
  ok "备份：$target"
}

list_backups() {
  shopt -s nullglob
  local files=("$BACKUP_DIR"/hy2m-*.tar.gz) f
  ((${#files[@]})) || { warn "还没有任何备份：$BACKUP_DIR"; return 1; }
  for f in "${files[@]}"; do printf '%s  %s\n' "$(du -h "$f" | cut -f1)" "${f##*/}"; done
}

managed_service_files() {
  local f; shopt -s nullglob
  for f in "$SERVICE_DIR"/hy2m-*.service; do
    [[ ${f##*/} =~ ^hy2m-(direct|isp[0-9]+)\.service$ ]] && printf '%s\n' "$f"
  done
  return 0
}

# Destinations come only from the validated, non-overlapping managed roots,
# never from archive member paths; the shared systemd directory is not removed.
restore_tree() {
  local src=$1 dst=$2 mode=$3 group=$4
  case $dst in "$STATE_DIR"|"$HYSTERIA_DIR"|"$EXPORT_DIR") ;; *) return 1 ;; esac
  [[ $dst == /* && $dst != / && ! -L $dst ]] || return 1
  rm -rf -- "$dst" || return 1
  [[ -d $src ]] || return 0
  install_dir "$mode" "$group" "$dst" && cp -a "$src/." "$dst/" || return 1
  if [[ ${HY2M_TESTING:-0} != 1 ]]; then
    chown -R "root:$group" "$dst" || return 1
    python3 - "$dst" "$mode" <<'PY'
import sys
from pathlib import Path
root = Path(sys.argv[1]); mode = int(sys.argv[2], 8)
root.chmod(mode)
for p in root.rglob('*'):
    p.chmod(mode if p.is_dir() else (0o640 if mode == 0o750 else 0o600))
PY
  fi
}

restore_files() {
  local src=$1 f
  restore_tree "$src/state" "$STATE_DIR" 700 root || return 1
  restore_tree "$src/hysteria" "$HYSTERIA_DIR" 750 hysteria || return 1
  restore_tree "$src/export" "$EXPORT_DIR" 700 root || return 1
  while IFS= read -r f; do rm -f -- "$f" || return 1; done < <(managed_service_files)
  mkdir -p "$SERVICE_DIR" || return 1
  shopt -s nullglob
  for f in "$src/services"/*.service; do install_owned 644 root "$f" "$SERVICE_DIR/${f##*/}" || return 1; done
  if [[ -f $src/renewal-hook ]]; then
    mkdir -p "${RENEWAL_HOOK%/*}" || return 1
    install_owned 750 root "$src/renewal-hook" "$RENEWAL_HOOK" || return 1
  else
    rm -f -- "$RENEWAL_HOOK" || return 1
  fi
}

# Restart without touching enablement: migration and restore must not make a
# deliberately stopped node start on boot.
restart_unit_checked() {
  local unit=$1 port=$2 i
  systemctl restart "$unit" || return 1
  for ((i=0; i<20; i++)); do
    if systemctl is-active --quiet "$unit" && ss -lunH | awk '{print $4}' | grep -Eq "(^|:)${port}$"; then return 0; fi
    sleep 1
  done
  journalctl -u "$unit" -n 40 --no-pager >&2 || true
  return 1
}

# Subshell-scoped traps retain locals. Explicit status checks also work in
# if/|| contexts, where Bash's errexit option does not protect function bodies.
restore_backup() (
  require_root
  local name=${1:-} target work="" changed=0 committed=0 f section id unit port state enabled
  local -A current_ports=() target_ports=() active_before=() enabled_before=()
  local -a units=()
  if [[ -z $name ]]; then
    list_backups || return 1
    name=$(ask "还原备份" "输入备份文件名（不含路径）" "") || return $?
  fi
  target="$BACKUP_DIR/$name"
  [[ $name =~ ^hy2m-[A-Za-z0-9._-]+\.tar\.gz$ && -f $target && ! -L $target && ! -L $BACKUP_DIR ]] || { warn "找不到安全的备份文件。"; return 1; }
  work=$(mktemp -d "$BACKUP_DIR/.restore.XXXXXX") || return 1
  # shellcheck disable=SC2317
  restore_cleanup() {
    local result=$? good=1 u
    trap - EXIT INT TERM
    if ((changed && !committed)); then
      for u in "${units[@]}"; do systemctl stop "$u" >/dev/null 2>&1 || good=0; done
      restore_files "$work/before" || good=0
      systemctl daemon-reload || good=0
      for u in "${units[@]}"; do
        case ${enabled_before[$u]} in
          enabled) systemctl enable "$u" >/dev/null 2>&1 || good=0 ;;
          disabled) systemctl disable "$u" >/dev/null 2>&1 || good=0 ;;
        esac
        if [[ ${active_before[$u]} == active ]]; then
          restart_unit_checked "$u" "${current_ports[$u]:-${target_ports[$u]:-0}}" || good=0
        fi
      done
      if ((good)); then warn "还原失败，已恢复操作前的文件与服务状态。"
      else warn "还原失败且回滚未完全成功；恢复材料保留在：$work"; fi
      ((result != 0)) || result=1
    fi
    if ((good)); then rm -rf -- "$work"; fi
    exit "$result"
  }
  trap restore_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  backup_archive stage "$target" "$work/new" || return 1
  backup_archive inventory '' >"$work/current.tsv" || return 1
  # Configuration alone cannot safely replay a changed firewall ownership ledger.
  if ! cmp -s <( [[ ! -f $FIREWALL_STATE ]] || sort "$FIREWALL_STATE" ) <( [[ ! -f $work/new/state/firewall.rules ]] || sort "$work/new/state/firewall.rules" ); then
    warn "备份与当前防火墙记录不同，未修改配置；请先人工核对端口规则后再还原。"; return 1
  fi
  while IFS=$'\t' read -r id unit port; do current_ports[$unit]=$port; done <"$work/current.tsv"
  while IFS=$'\t' read -r id unit port; do target_ports[$unit]=$port; done <"$work/new/plan.tsv"
  for unit in "${!current_ports[@]}" "${!target_ports[@]}"; do
    [[ -z ${active_before[$unit]+x} ]] || continue
    units+=("$unit")
    state=$(systemctl is-active "$unit" 2>/dev/null) || true
    enabled=$(systemctl is-enabled "$unit" 2>/dev/null) || true
    case $state in active|inactive|failed|unknown) ;; *) warn "节点服务状态不稳定，未进行还原。"; return 1 ;; esac
    case $enabled in enabled|disabled|static|indirect|not-found|'') ;; *) warn "节点启用状态不支持自动还原，未修改配置。"; return 1 ;; esac
    active_before[$unit]=$state; enabled_before[$unit]=${enabled:-not-found}
  done
  confirm "还原 $name？先备份当前配置；只重启原来运行的节点，新恢复节点保持停止。" || return 0
  make_backup || { warn "安全备份失败，已中止还原；当前配置未修改。"; return 1; }
  mkdir -p "$work/before/services" || return 1
  for section in state hysteria export; do
    case $section in state) f=$STATE_DIR ;; hysteria) f=$HYSTERIA_DIR ;; export) f=$EXPORT_DIR ;; esac
    [[ ! -d $f ]] || cp -a "$f" "$work/before/$section" || return 1
  done
  while IFS= read -r f; do cp -p "$f" "$work/before/services/${f##*/}" || return 1; done < <(managed_service_files)
  [[ ! -f $RENEWAL_HOOK ]] || cp -p "$RENEWAL_HOOK" "$work/before/renewal-hook" || return 1
  changed=1
  for unit in "${units[@]}"; do
    if [[ ${active_before[$unit]} == active ]]; then systemctl stop "$unit" || return 1; fi
    if [[ -z ${target_ports[$unit]+x} ]]; then systemctl disable "$unit" >/dev/null || return 1; fi
  done
  restore_files "$work/new" || return 1
  systemctl daemon-reload || return 1
  local restarted=0
  for unit in "${!target_ports[@]}"; do
    if [[ ${active_before[$unit]} == active && -n ${current_ports[$unit]+x} ]]; then
      restart_unit_checked "$unit" "${target_ports[$unit]}" || return 1
      restarted=$((restarted+1))
    fi
  done
  committed=1
  ok "已还原 $name，重启 $restarted 个原运行节点；原停止及新恢复节点保持停止。"
)

public_port_free() {
  local port=$1 f
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do grep -Fxq "PUBLIC_PORT=$port" "$f" && return 1; done
  return 0
}
node_port_free() { port_free "$1" udp && recorded_port_free "$1" LISTEN_PORT "${2:-}"; }
port_free() {
  local port=$1 proto=$2
  if [[ $proto == udp ]]; then
    if ss -lunH | awk '{print $4}' | grep -Eq "(^|:)${port}$"; then return 1; fi
  else
    if ss -ltnH | awk '{print $4}' | grep -Eq "(^|:)${port}$"; then return 1; fi
  fi
  return 0
}
open_firewall() {
  local port=$1 proto=$2 rule status tmp
  rule="$port/$proto"
  command -v ufw >/dev/null 2>&1 || return 0
  status=$(LC_ALL=C ufw status) || return 1
  grep -q '^Status: active' <<<"$status" || return 0
  if awk '{print $1}' <<<"$status" | grep -Fxq "$rule"; then return 0; fi
  # Persist ownership before mutation: even a partially failing UFW operation
  # remains discoverable and removable by a later retry/uninstall.
  tmp=$(mktemp "$STATE_DIR/.firewall.XXXXXXXX") || return 1
  cleanup_files+=("$tmp")
  if [[ -f $FIREWALL_STATE ]]; then cat "$FIREWALL_STATE" >"$tmp" || return 1; fi
  if ! grep -Fxq "$rule" "$tmp"; then printf '%s\n' "$rule" >>"$tmp" || return 1; fi
  chmod 600 "$tmp" && mv -f -- "$tmp" "$FIREWALL_STATE" || return 1
  if ! ufw allow "$rule" >/dev/null; then
    warn "开放 $rule 失败，正在撤销；清理失败时保留归属记录。"
    close_firewall "$port" "$proto" || true
    return 1
  fi
}
close_firewall() {
  local port=$1 proto=$2 rule tmp status
  rule="$port/$proto"
  [[ -r $FIREWALL_STATE ]] && grep -Fxq "$rule" "$FIREWALL_STATE" || return 0
  command -v ufw >/dev/null 2>&1 || { warn "UFW 不可用，保留 $rule 归属记录。"; return 1; }
  status=$(LC_ALL=C ufw status) || return 1
  # Deleting a persisted rule also matters while UFW is disabled.
  [[ $status == *'Status: active'* || $status == *'Status: inactive'* ]] || return 1
  ufw --force delete allow "$rule" >/dev/null 2>&1 || { warn "删除 $rule 失败，归属记录已保留。"; return 1; }
  tmp=$(mktemp "$STATE_DIR/.firewall.XXXXXX") || return 1
  cleanup_files+=("$tmp")
  local rc=0
  grep -Fxv "$rule" "$FIREWALL_STATE" >"$tmp" || rc=$?
  ((rc <= 1)) || return 1
  chmod 600 "$tmp" && mv -f -- "$tmp" "$FIREWALL_STATE"
}

is_restricted_container() {
  command -v systemd-detect-virt >/dev/null 2>&1 || return 1
  systemd-detect-virt --container >/dev/null 2>&1
}
try_network_sysctl() {
  local key=$1 value=$2 file=$3
  if sysctl -w "$key=$value" >/dev/null 2>&1; then printf '%s = %s\n' "$key" "$value" >>"$file"; return 0; fi
  warn "宿主机不允许修改 $key，已跳过。"; return 1
}
configure_network() {
  local mem_kb swap_mb=0 applied=0 tmp
  if is_restricted_container; then
    rm -f "$SYSCTL_FILE"
    warn "检测到 LXC/LXD/OpenVZ 等受限容器；BBR、net.core 缓冲和真实 Swap 由宿主机管理，已安全跳过网络优化。"
    return 0
  fi
  tmp=$(mktemp); cleanup_files+=("$tmp")
  printf '# Managed by HY2 ISP Manager. Conservative QUIC buffers; no custom kernel.\n' >"$tmp"
  if try_network_sysctl net.core.rmem_max 16777216 "$tmp"; then applied=1; fi
  if try_network_sysctl net.core.wmem_max 16777216 "$tmp"; then applied=1; fi
  if sysctl -n net.ipv4.tcp_available_congestion_control 2>/dev/null | grep -qw bbr; then
    if try_network_sysctl net.core.default_qdisc fq "$tmp"; then applied=1; fi
    if try_network_sysctl net.ipv4.tcp_congestion_control bbr "$tmp"; then applied=1; fi
  else
    warn "当前内核不支持 BBR，已保留原拥塞控制。"
  fi
  if ((applied)); then install -o root -g root -m 644 "$tmp" "$SYSCTL_FILE"; fi
  mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
  if (( mem_kb < 1500000 )) && ! swapon --show=NAME --noheadings | grep -q .; then
    (( mem_kb < 750000 )) && swap_mb=768 || swap_mb=512
    if [[ ! -f $SWAP_FILE ]]; then
      fallocate -l "${swap_mb}M" "$SWAP_FILE" || dd if=/dev/zero of="$SWAP_FILE" bs=1M count="$swap_mb" status=none
      chmod 600 "$SWAP_FILE"; mkswap "$SWAP_FILE" >/dev/null
    fi
    swapon "$SWAP_FILE"
    grep -qF "$SWAP_FILE none swap sw 0 0" /etc/fstab || printf '%s none swap sw 0 0\n' "$SWAP_FILE" >>/etc/fstab
  fi
}

get_public_ipv4() { curl -4fsS --max-time 15 https://api.ipify.org; }
check_dns() {
  local domain=$1 expected=$2 resolved
  resolved=$(dig +short A "$domain" | sort -u)
  if [[ -z $resolved ]]; then warn "域名 $domain 没有 A 记录。"; return 1; fi
  if ! grep -Fxq "$expected" <<<"$resolved"; then warn "域名解析不匹配。期望 $expected，实际：$resolved"; return 1; fi
}

# Transaction snapshots distinguish absent files from failed copies. Never infer
# absence from an incomplete snapshot, including when errexit is disabled by if/||.
transaction_path_safe() {
  python3 - "$@" <<'PY'
from pathlib import Path
import sys
root, *targets = map(Path, sys.argv[1:])
if not root.is_absolute() or root.resolve() != root.absolute():
    raise SystemExit('拒绝不安全的事务根目录')
for target in targets:
    try:
        rel = target.relative_to(root)
    except ValueError:
        raise SystemExit('事务文件不在管理目录内')
    if not rel.parts or '..' in rel.parts:
        raise SystemExit('拒绝不安全的事务路径')
    for i in range(1, len(rel.parts) + 1):
        part = root.joinpath(*rel.parts[:i])
        if part.is_symlink():
            raise SystemExit('拒绝符号链接事务路径')
        if i < len(rel.parts) and part.exists() and not part.is_dir():
            raise SystemExit('事务父路径不是目录')
    if target.exists() and not target.is_file():
        raise SystemExit('事务目标不是普通文件')
PY
}
transaction_snapshot_file() {
  local work=$1 name=$2 target=$3
  if [[ -e $target || -L $target ]]; then
    [[ -f $target && ! -L $target ]] && cp -p -- "$target" "$work/$name.state" || return 1
  else
    : >"$work/$name.absent" || return 1
  fi
}
transaction_restore_file() {
  local work=$1 name=$2 target=$3 mode=$4 group=$5
  if [[ -f $work/$name.state ]]; then
    [[ -f $target ]] && cmp -s -- "$work/$name.state" "$target" && return 0
    install_owned "$mode" "$group" "$work/$name.state" "$target"
  elif [[ -f $work/$name.absent ]]; then
    rm -f -- "$target"
  else
    warn "恢复材料不完整：$work/$name；未覆盖目标文件。"; return 1
  fi
}
certificate_snapshot() {
  local work=$1
  transaction_path_safe "$STATE_DIR" "$CF_CREDENTIALS" "$FIREWALL_STATE" "$MANAGER_STATE" &&
    transaction_path_safe "$HYSTERIA_DIR" "$TLS_DIR/fullchain.pem" "$TLS_DIR/privkey.pem" &&
    transaction_path_safe "$LETSENCRYPT_DIR" "$RENEWAL_HOOK" || return 1
  transaction_snapshot_file "$work" manager.env "$MANAGER_STATE" &&
    transaction_snapshot_file "$work" fullchain.pem "$TLS_DIR/fullchain.pem" &&
    transaction_snapshot_file "$work" privkey.pem "$TLS_DIR/privkey.pem" &&
    transaction_snapshot_file "$work" cloudflare.ini "$CF_CREDENTIALS" &&
    transaction_snapshot_file "$work" renewal-hook "$RENEWAL_HOOK" &&
    transaction_snapshot_file "$work" firewall.rules "$FIREWALL_STATE"
}
certificate_rollback() {
  local work=$1 restored=1 firewall_restored=1
  if ((${_domain_http80_added:-0})); then
    if ufw --force delete allow 80/tcp >/dev/null 2>&1; then
      _domain_http80_added=0
    else
      warn "HTTP 80 规则回滚失败，请人工检查 UFW；归属记录保留在 $work/http80.pending。"
      restored=0; firewall_restored=0
      # Keep the live ownership ledger accurate too; the durable pending marker
      # remains authoritative if this write fails (e.g. a read-only filesystem).
      if [[ -f $work/firewall.rules.state ]]; then
        cp -p -- "$work/firewall.rules.state" "$work/firewall.pending" || restored=0
      else : >"$work/firewall.pending" || restored=0; fi
      if ! grep -Fxq '80/tcp' "$work/firewall.pending"; then printf '80/tcp\n' >>"$work/firewall.pending" || restored=0; fi
      install_owned 600 root "$work/firewall.pending" "$FIREWALL_STATE" || restored=0
    fi
  fi
  transaction_restore_file "$work" manager.env "$MANAGER_STATE" 600 root || restored=0
  transaction_restore_file "$work" fullchain.pem "$TLS_DIR/fullchain.pem" 640 hysteria || restored=0
  transaction_restore_file "$work" privkey.pem "$TLS_DIR/privkey.pem" 640 hysteria || restored=0
  transaction_restore_file "$work" cloudflare.ini "$CF_CREDENTIALS" 600 root || restored=0
  transaction_restore_file "$work" renewal-hook "$RENEWAL_HOOK" 750 root || restored=0
  if ((firewall_restored)); then transaction_restore_file "$work" firewall.rules "$FIREWALL_STATE" 600 root || restored=0; fi
  if ((${_certificate_timer_touched:-0})); then
    if [[ $(<"$work/timer.active") == inactive ]]; then systemctl stop certbot.timer >/dev/null 2>&1 || restored=0; fi
    case $(<"$work/timer.enabled") in
      disabled) systemctl disable certbot.timer >/dev/null 2>&1 || restored=0 ;;
      enabled-runtime)
        systemctl disable certbot.timer >/dev/null 2>&1 || restored=0
        systemctl enable --runtime certbot.timer >/dev/null 2>&1 || restored=0 ;;
    esac
    if [[ $(<"$work/timer.active") == active ]]; then systemctl start certbot.timer >/dev/null 2>&1 || restored=0; fi
  fi
  ((restored))
}
certificate_enable_timer() {
  local enabled active
  enabled=$(systemctl is-enabled certbot.timer 2>/dev/null) || true
  active=$(systemctl is-active certbot.timer 2>/dev/null) || true
  case $enabled in enabled|enabled-runtime|disabled|static) ;; *) warn "无法安全变更 certbot.timer 的启用状态：$enabled"; return 1 ;; esac
  case $active in active|inactive) ;; *) warn "无法安全变更 certbot.timer 的运行状态：$active"; return 1 ;; esac
  printf '%s\n' "$enabled" >"$_certificate_work/timer.enabled" &&
    printf '%s\n' "$active" >"$_certificate_work/timer.active" || return 1
  _certificate_timer_touched=1
  systemctl enable --now certbot.timer >/dev/null 2>&1 || { warn "certbot.timer 启用失败。"; return 1; }
}
certificate_transaction() (
  local work committed=0 ready=0 restored=1
  # Dynamically scoped into synchronous helpers inside this subshell.
  # shellcheck disable=SC2030
  local _certificate_transaction=1 _domain_http80_added=0 _certificate_timer_touched=0
  # Validate before mktemp as well, so a redirected state directory cannot create
  # journals outside the managed tree. The complete snapshot is validated below.
  transaction_path_safe "$STATE_DIR" "$MANAGER_STATE" || return 1
  work=$(mktemp -d "$STATE_DIR/.certificate.XXXXXX") || return 1
  # shellcheck disable=SC2030
  local _certificate_work=$work
  # shellcheck disable=SC2317
  certificate_cleanup() {
    local rc=$?
    trap - EXIT; trap '' INT TERM
    if ((ready && !committed)); then
      certificate_rollback "$work" || restored=0
      if ((restored)); then warn "证书步骤未完成，已恢复管理文件和本次防火墙/定时器改动。"
      else warn "证书步骤未完成，自动恢复未完成；恢复材料保留在：$work"; fi
      warn "Certbot 的账户、日志或已签发证书可能保留；未自动删除 ACME 数据。"
      ((rc >= 128)) || rc=1
    fi
    if ((restored)); then rm -rf -- "$work" || rc=1; fi
    cleanup || rc=1
    exit "$rc"
  }
  trap certificate_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  certificate_snapshot "$work" || { warn "证书快照失败，未开始变更。"; return 1; }
  ready=1
  if "$@"; then committed=1; else return $?; fi
)
certificate_http() {
  # shellcheck disable=SC2031
  if [[ ${_certificate_transaction:-0} == 1 ]]; then _certificate_http "$@"
  else certificate_transaction _certificate_http "$@"; fi
}
# Issuance plus deployment as one unit: a failure while writing the key, hook or
# timer must not leave the old certificate half replaced.
_domain_certificate_stage() {
  certificate_transaction _domain_certificate_stage_impl "$@"
}
_domain_certificate_stage_impl() {
  local domain=$1 cert_mode=$2 email=$3 token=""
  if certificate_valid "$domain"; then
    ok "检测到 30 天以上有效期的现有证书，将安全复用。"
    copy_certificate "$domain" --no-timer
    return $?
  fi
  if [[ $cert_mode == http ]]; then
    certificate_http "$domain" "$email" || { warn "HTTP-01 证书签发失败。"; return 1; }
  else
    token=$(ask_secret "Cloudflare" "请输入仅含 Zone.DNS Edit 权限的 API Token") || return $?
    [[ -n $token ]] || { warn "Token 不能为空。"; return 1; }
    if ! certificate_cloudflare "$domain" "$email" "$token"; then
      unset token; warn "DNS-01 证书签发失败。"; return 1
    fi
    unset token
  fi
  copy_certificate "$domain" --no-timer || { warn "证书部署失败。"; return 1; }
}
_certificate_http() {
  # shellcheck disable=SC2031
  local domain=$1 email=$2 firewall_status tmp="$_certificate_work/firewall.next" rc
  valid_domain "$domain" || return 1
  if ! port_free 80 tcp; then warn "内部 TCP 80 被占用，无法使用 HTTP-01。"; return 1; fi
  if command -v ufw >/dev/null 2>&1; then
    firewall_status=$(LC_ALL=C ufw status) || { warn "无法读取 UFW 状态。"; return 1; }
    # Preserve restricted/deny rules, multiports/ranges and IPv6. An application
    # profile may also include 80: conservatively leave its policy unchanged.
    if grep -q '^Status: active' <<<"$firewall_status" && ! awk '
      /ALLOW|DENY|REJECT|LIMIT/ {
        port=$1
        if (port !~ /^[0-9]/) {found=1; next}
        if (port ~ /\/udp$/) next
        sub(/\/tcp$/, "", port)
        n=split(port, parts, ",")
        for (i=1; i<=n; i++) {
          m=split(parts[i], ends, ":")
          if ((m==1 && ends[1]==80) || (m==2 && ends[1]<=80 && ends[2]>=80)) found=1
        }
      } END {exit !found}' <<<"$firewall_status"; then
      if [[ -e $FIREWALL_STATE ]]; then cp -p -- "$FIREWALL_STATE" "$tmp" || return 1
      else : >"$tmp" || return 1; fi
      if ! grep -Fxq '80/tcp' "$tmp"; then
        [[ ! -s $tmp || -z $(tail -c 1 -- "$tmp") ]] || printf '\n' >>"$tmp" || return 1
        printf '80/tcp\n' >>"$tmp" || return 1
      fi
      chmod 600 "$tmp" || return 1
      # Journal before mutation, including allow failures that partially apply.
      # shellcheck disable=SC2031
      printf '80/tcp\n' >"$_certificate_work/http80.pending" || return 1
      _domain_http80_added=1
      ufw allow 80/tcp >/dev/null || return 1
    fi
  fi
  local args=(certonly --no-directory-hooks --config-dir "$LETSENCRYPT_DIR" --work-dir "$LETSENCRYPT_DIR/work" --logs-dir "$LETSENCRYPT_DIR/logs" --standalone --preferred-challenges http --non-interactive --agree-tos -d "$domain")
  [[ -n $email ]] && args+=(--email "$email") || args+=(--register-unsafely-without-email)
  if certbot "${args[@]}"; then :; else
    rc=$?; warn "HTTP-01 证书签发失败。"; return "$rc"
  fi
  if ((_domain_http80_added)); then
    if [[ ! -f $tmp ]]; then
      if [[ -f $FIREWALL_STATE ]]; then cp -p -- "$FIREWALL_STATE" "$tmp" || return 1; else : >"$tmp" || return 1; fi
      grep -Fxq '80/tcp' "$tmp" || printf '80/tcp\n' >>"$tmp" || return 1
    fi
    mv -f -- "$tmp" "$FIREWALL_STATE" || return 1
  fi
  return 0
}
certificate_valid() {
  local domain=$1 live="$LETSENCRYPT_DIR/live/$1/fullchain.pem"
  valid_domain "$domain" || return 1
  [[ -r $live ]] && openssl x509 -in "$live" -noout -checkend 2592000 >/dev/null 2>&1 &&
    openssl x509 -in "$live" -noout -checkhost "$domain" >/dev/null 2>&1
}
certificate_cloudflare() {
  # shellcheck disable=SC2031
  if [[ ${_certificate_transaction:-0} == 1 ]]; then _certificate_cloudflare "$@"
  else certificate_transaction _certificate_cloudflare "$@"; fi
}
_certificate_cloudflare() {
  local domain=$1 email=$2 token=$3 tmp rc
  valid_domain "$domain" && [[ -n $token && $token != *$'\n'* && $token != *$'\r'* ]] || return 1
  [[ ! -L $STATE_DIR && ! -L $CF_CREDENTIALS ]] || { warn "拒绝符号链接凭据文件。"; return 1; }
  transaction_path_safe "$STATE_DIR" "$CF_CREDENTIALS" || { warn "拒绝不安全的凭据路径。"; return 1; }
  export DEBIAN_FRONTEND=noninteractive
  apt-get install -y --no-install-recommends python3-certbot-dns-cloudflare || { warn "Cloudflare DNS 插件安装失败。"; return 1; }
  tmp=$(mktemp "$STATE_DIR/.cloudflare.XXXXXX") || return 1
  if ! printf 'dns_cloudflare_api_token = %s\n' "$token" >"$tmp" || ! chmod 600 "$tmp" || ! mv -f -- "$tmp" "$CF_CREDENTIALS"; then
    rm -f -- "$tmp"; return 1
  fi
  local args=(certonly --no-directory-hooks --config-dir "$LETSENCRYPT_DIR" --work-dir "$LETSENCRYPT_DIR/work" --logs-dir "$LETSENCRYPT_DIR/logs" --dns-cloudflare --dns-cloudflare-credentials "$CF_CREDENTIALS" --dns-cloudflare-propagation-seconds 30 --non-interactive --agree-tos -d "$domain")
  [[ -n $email ]] && args+=(--email "$email") || args+=(--register-unsafely-without-email)
  certbot "${args[@]}"; rc=$?
  ((rc == 0)) && return 0
  warn "Cloudflare DNS-01 证书签发失败，请检查 Token、Zone 权限和 DNS。"; return "$rc"
}
copy_certificate() {
  # shellcheck disable=SC2031
  if [[ ${_certificate_transaction:-0} == 1 ]]; then _copy_certificate "$@"
  else certificate_transaction _copy_certificate "$@"; fi
}
_copy_certificate() {
  local domain=$1 live cert_key private_key tmp
  valid_domain "$domain" || return 1
  live="$LETSENCRYPT_DIR/live/$domain"
  # ACME live files normally link into archive/. Permit only those source links;
  # managed destinations and their parent directories must not be symlinks.
  if ! python3 - "$LETSENCRYPT_DIR" "$HYSTERIA_DIR" "$TLS_DIR" "$RENEWAL_HOOK" "$live" <<'PY'
from pathlib import Path
import sys
le, hy, tls, hook, live = map(Path, sys.argv[1:])
for root, target in [(hy, tls / 'fullchain.pem'), (hy, tls / 'privkey.pem'), (le, hook)]:
    if not root.is_absolute() or root.resolve() != root.absolute():
        raise SystemExit('拒绝不安全的证书根目录')
    rel = target.relative_to(root)
    for part in [root, *[root.joinpath(*rel.parts[:i]) for i in range(1, len(rel.parts) + 1)]]:
        if part.is_symlink():
            raise SystemExit('拒绝符号链接证书目标')
    if target.exists() and not target.is_file():
        raise SystemExit('证书目标不是普通文件')
for filename in ['fullchain.pem', 'privkey.pem']:
    source = live / filename
    if not source.is_file() or not source.resolve().is_relative_to(le.resolve()):
        raise SystemExit('证书来源不在管理的 ACME 目录中')
PY
  then return 1; fi
  openssl x509 -in "$live/fullchain.pem" -noout -checkend 0 -checkhost "$domain" >/dev/null 2>&1 || { warn "证书无效或域名不匹配。"; return 1; }
  cert_key=$(openssl x509 -in "$live/fullchain.pem" -pubkey -noout) || return 1
  private_key=$(openssl pkey -in "$live/privkey.pem" -pubout) || return 1
  [[ -n $cert_key && $cert_key == "$private_key" ]] || { warn "证书与私钥不匹配。"; return 1; }
  install_dir 750 hysteria "$TLS_DIR" || return 1
  install_owned 640 hysteria "$live/fullchain.pem" "$TLS_DIR/fullchain.pem" || return 1
  install_owned 640 hysteria "$live/privkey.pem" "$TLS_DIR/privkey.pem" || return 1
  install_dir 755 root "${RENEWAL_HOOK%/*}" || return 1
  tmp=$(mktemp "${RENEWAL_HOOK%/*}/.hy2-copy.XXXXXX") || return 1
  if ! {
    printf '#!/usr/bin/env bash\nset -Eeuo pipefail\n'
    printf 'domain=%q\ntls_dir=%q\nle_dir=%q\n' "$domain" "$TLS_DIR" "$LETSENCRYPT_DIR"
    printf 'manager=%q\n' "$APP_DIR/hy2-manager"
    cat <<'HOOK'
# hysteria certificate deployment is serialized and transactional in the manager.
case " ${RENEWED_DOMAINS:-} " in *" $domain "*) ;; *) exit 0 ;; esac
[[ ${RENEWED_LINEAGE:-} == "$le_dir/live/$domain" ]] || exit 1
exec "$manager" renew-certificate
HOOK
  } >"$tmp"; then rm -f -- "$tmp"; return 1; fi
  if ! install_owned 750 root "$tmp" "$RENEWAL_HOOK"; then rm -f -- "$tmp"; return 1; fi
  rm -f -- "$tmp" || return 1
  # Installation retains its one-argument API. Migration must not change timers.
  if [[ ${2:-} != --no-timer ]]; then
    certificate_enable_timer || { warn "证书已复制，但 certbot.timer 启用失败。"; return 1; }
  fi
}

renew_certificate() (
  load_manager
  [[ ${RENEWED_LINEAGE:-} == "$LETSENCRYPT_DIR/live/$DOMAIN" ]] || { warn "续期来源与当前域名不一致。"; return 1; }
  renewal_units=(); renewal_ports=(); renewal_committed=0
  local f unit port state
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    unit=$(env_get "$f" SERVICE); port=$(env_get "$f" LISTEN_PORT)
    state=$(systemctl is-active "$unit" 2>/dev/null) || true
    case $state in
      active) renewal_units+=("$unit"); renewal_ports+=("$port") ;;
      inactive|failed) ;;
      *) warn "服务状态不稳定，暂缓续期部署：$unit"; return 1 ;;
    esac
  done
  # The inner certificate transaction restores files before this EXIT handler
  # restores the running processes. Stopped services are never started.
  # shellcheck disable=SC2317
  renewal_cleanup() {
    local rc=$? i restored=1
    trap - EXIT; trap '' INT TERM
    if ((!renewal_committed)); then
      for ((i=0; i<${#renewal_units[@]}; i++)); do
        restart_unit_checked "${renewal_units[i]}" "${renewal_ports[i]}" || restored=0
      done
      ((restored)) || warn "续期后服务恢复失败，请检查日志及保留的证书快照。"
      ((rc != 0)) || rc=1
    fi
    exit "$rc"
  }
  trap renewal_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  local -a targets=()
  local i
  for ((i=0; i<${#renewal_units[@]}; i++)); do targets+=("${renewal_units[i]}" "${renewal_ports[i]}"); done
  certificate_transaction _renew_certificate_impl "${targets[@]}" || return $?
  renewal_committed=1
)
_renew_certificate_impl() {
  _copy_certificate "$DOMAIN" --no-timer || return 1
  while (($# >= 2)); do
    restart_unit_checked "$1" "$2" || return 1
    shift 2
  done
}

write_service() {
  local service=$1 description=$2 config=$3
  cat >"$SERVICE_DIR/$service" <<EOF
[Unit]
Description=$description
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=hysteria
Group=hysteria
WorkingDirectory=/var/lib/hysteria
Environment=HYSTERIA_LOG_LEVEL=info
ExecStart=$HYSTERIA_BIN server -c $config
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=true
EOF
  if ! is_restricted_container; then
    cat >>"$SERVICE_DIR/$service" <<EOF
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=$HYSTERIA_DIR
ReadWritePaths=/var/lib/hysteria
EOF
  else
    printf '# Filesystem namespace hardening omitted: restricted container blocks CLONE_NEWNS.\n' >>"$SERVICE_DIR/$service"
  fi
  cat >>"$SERVICE_DIR/$service" <<EOF
Nice=-5
LimitNOFILE=1048576
IPAccounting=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
EOF
}

write_common_config() {
  local port=$1 auth=$2
  cat <<EOF
listen: :$port

tls:
  cert: "$TLS_DIR/fullchain.pem"
  key: "$TLS_DIR/privkey.pem"
  sniGuard: strict

auth:
  type: password
  password: $(yaml_quote "$auth")

congestion:
  type: bbr
  bbrProfile: aggressive

quic:
  initStreamReceiveWindow: 26843545
  maxStreamReceiveWindow: 26843545
  initConnReceiveWindow: 67108864
  maxConnReceiveWindow: 67108864

speedTest: true

masquerade:
  type: string
  string:
    content: Welcome
    headers:
      content-type: text/plain
    statusCode: 200
EOF
}

start_checked() {
  local service=$1 port=$2
  systemctl daemon-reload || return 1
  systemctl enable "$service" >/dev/null || return 1
  systemctl restart "$service" || return 1
  local i; for i in $(seq 1 20); do
    if systemctl is-active --quiet "$service" && ss -lunH | awk '{print $4}' | grep -Eq "(^|:)${port}$"; then return 0; fi
    sleep 1
  done
  journalctl -u "$service" -n 40 --no-pager >&2 || true; return 1
}

save_node() {
  local id=$1 type=$2 name=$3 listen_port=$4 public_port=$5 service=$6 config=$7 uri_file=$8 mode=$9
  write_env "$NODE_DIR/$id.env" ID "$id" TYPE "$type" NAME "$name" LISTEN_PORT "$listen_port" PUBLIC_PORT "$public_port" SERVICE "$service" CONFIG "$config" URI_FILE "$uri_file" NETWORK_MODE "$mode"
}

create_direct() {
  load_manager
  [[ ! -e $NODE_DIR/direct.env ]] || die "直连节点已经存在。"
  local listen_port public_port mode auth config service uri_file tmp
  mode=$NETWORK_MODE
  while true; do
    listen_port=$(ask_valid_port "直连节点" "VPS 内部 UDP 监听端口" "443") || return $?
    if node_port_free "$listen_port"; then break; fi
    warn "UDP $listen_port 已占用，请重新输入。"
  done
  if [[ $mode == nat ]]; then
    while true; do
      public_port=$(ask_valid_port "NAT 映射" "服务商控制台的公网 UDP 端口" "") || return $?
      if public_port_free "$public_port"; then break; fi
      warn "公网端口 $public_port 已被其他节点记录，请重新输入。"
    done
  else public_port=$listen_port; fi
  auth=$(openssl rand -hex 24); config="$HYSTERIA_DIR/direct.yaml"; service=hy2m-direct.service; uri_file="$EXPORT_DIR/hy2-direct.txt"
  tmp=$(mktemp); cleanup_files+=("$tmp"); write_common_config "$listen_port" "$auth" >"$tmp"
  install -o root -g hysteria -m 640 "$tmp" "$config"
  printf 'hysteria2://%s@%s:%s/?sni=%s&insecure=0#HY2-Direct\n' "$auth" "$DOMAIN" "$public_port" "$DOMAIN" >"$uri_file"; chmod 600 "$uri_file"
  write_service "$service" "HY2 Manager Direct Node" "$config"; open_firewall "$listen_port" udp
  if ! start_checked "$service" "$listen_port"; then systemctl disable --now "$service" >/dev/null 2>&1 || true; rm -f "$config" "$SERVICE_DIR/$service" "$uri_file"; close_firewall "$listen_port" udp; die "直连节点启动失败，已回滚。"; fi
  save_node direct direct HY2-Direct "$listen_port" "$public_port" "$service" "$config" "$uri_file" "$mode"
  if [[ $mode == nat ]]; then warn "请确认服务商控制台已有：公网 UDP $public_port → 内部 UDP $listen_port"; fi
  ok "直连节点已创建。"
}

# Parse pasted credentials as data, never as shell code; the argument is a file path.
parse_socks_file() {
  local parsed
  parsed=$(python3 - "$1" <<'PY'
import ipaddress, re, sys
from urllib.parse import urlsplit, unquote
sys.stdout.reconfigure(newline='\n')
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        raw = f.read().rstrip('\n')
    if not raw.isprintable():
        raise ValueError()
    if '://' in raw:
        u = urlsplit(raw)
        if u.scheme not in ('socks5', 'socks5h') or u.path not in ('', '/') or u.query or u.fragment:
            raise ValueError()
        if re.search(r'%(?![0-9a-fA-F]{2})', raw):
            raise ValueError()
        host, port = u.hostname, u.port
        user = unquote(u.username or '', errors='strict')
        password = unquote(u.password or '', errors='strict')
    else:
        host, port, user, password = raw.split(':', 3)
        port = int(port)
    if not host or not port or not 1 <= port <= 65535:
        raise ValueError()
    try:
        ipaddress.ip_address(host)
    except ValueError:
        if len(host) > 253 or not all(re.fullmatch(r'[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?', s) for s in host.split('.')):
            raise ValueError()
    if ':' in user or not all(v and v.isprintable() and len(v.encode('utf-8')) <= 255 for v in (user, password)):
        raise ValueError()
    print(host, port, user, password, sep='\n')
except (ValueError, TypeError, OSError):
    # Never include input credentials in errors.
    sys.exit(1)
PY
  ) || return 1
  local fields=()
  mapfile -t fields <<<"$parsed"
  ((${#fields[@]} == 4)) || return 1
  SOCKS_HOST=${fields[0]}; SOCKS_PORT=${fields[1]}; SOCKS_USER=${fields[2]}; SOCKS_PASS=${fields[3]}
}

read_socks() {
  local mode raw tmp
  while true; do
    mode=$(choose "添加 / 更换 ISP" "选择输入方式；代理信息不会出现在首页" 1 "粘贴整条代理信息（隐藏输入）" 2 "分别填写地址、端口、账号和密码" 0 "返回") || return $?
    case $mode in
      0) return 20 ;;
      2) read_socks_fields; return $? ;;
      1)
        tmp=$(mktemp); cleanup_files+=("$tmp")
        while true; do
          raw=$(ask_secret "粘贴 ISP" "支持 socks5://用户:密码@地址:端口 或 地址:端口:用户:密码；URL 特殊字符需百分号编码") || return $?
          printf '%s' "$raw" >"$tmp"; unset raw
          if parse_socks_file "$tmp"; then rm -f "$tmp"; return 0; fi
          warn "格式无效，需要有效地址、端口及非空账号密码；也可返回后分别填写。"
        done ;;
      *) warn "请选择列出的选项。" ;;
    esac
  done
}

read_socks_fields() {
  SOCKS_HOST=$(ask_valid_host "ISP SOCKS5" "SOCKS5 地址（IP 或域名）" "") || return $?
  SOCKS_PORT=$(ask_valid_port "ISP SOCKS5" "SOCKS5 端口" "") || return $?
  while true; do
    SOCKS_USER=$(ask "ISP SOCKS5" "用户名" "") || return $?
    if [[ -n $SOCKS_USER && $SOCKS_USER != *:* ]]; then break; fi
    warn "用户名不能为空且不能包含冒号，请重新输入。"
  done
  while true; do
    SOCKS_PASS=$(ask_secret "ISP SOCKS5" "密码（输入时不显示）") || return $?
    [[ -n $SOCKS_PASS ]] && break
    warn "密码不能为空，请重新输入。"
  done
}
probe_socks_udp() {
  local cred
  cred=$(mktemp); cleanup_files+=("$cred")
  printf '%s\n%s\n%s\n%s\n' "$SOCKS_HOST" "$SOCKS_PORT" "$SOCKS_USER" "$SOCKS_PASS" >"$cred"; chmod 600 "$cred"
  python3 - "$cred" <<'PY'
import socket, struct, sys
with open(sys.argv[1], 'r', encoding='utf-8') as f:
    h, port, user, password = f.read().splitlines()
p,u,w=int(port),user.encode(),password.encode()
def rx(s,n):
 d=b''
 while len(d)<n:
  c=s.recv(n-len(d))
  if not c: raise OSError('EOF')
  d+=c
 return d
try:
 with socket.create_connection((h,p),8) as s:
  s.sendall(b'\x05\x01\x02'); v,m=rx(s,2)
  if (v,m)!=(5,2): print('unsupported'); raise SystemExit
  s.sendall(b'\x01'+bytes([len(u)])+u+bytes([len(w)])+w)
  if rx(s,2)[1]!=0: print('auth_failed'); raise SystemExit
  s.sendall(b'\x05\x03\x00\x01\x00\x00\x00\x00\x00\x00'); r=rx(s,4)
  print('supported' if r[:2]==b'\x05\x00' else 'unsupported')
except Exception: print('probe_failed')
PY
}
verify_socks() {
  local cfg exit_ip
  cfg=$(mktemp); cleanup_files+=("$cfg")
  printf 'socks5-hostname = %s\nproxy-user = %s\n' "$(yaml_quote "$(host_port "$SOCKS_HOST" "$SOCKS_PORT")")" "$(yaml_quote "$SOCKS_USER:$SOCKS_PASS")" >"$cfg"; chmod 600 "$cfg"
  if ! exit_ip=$(curl --config "$cfg" -4fsS --max-time 20 https://api.ipify.org); then
    warn "SOCKS5 TCP、认证或上游出口测试失败。"; return 1
  fi
  SOCKS_EXIT_IP=$exit_ip; SOCKS_UDP=$(probe_socks_udp)
  if [[ $SOCKS_UDP == auth_failed ]]; then warn "SOCKS5 UDP 探测认证失败。"; return 1; fi
  ok "SOCKS5 出口：$SOCKS_EXIT_IP；UDP：$SOCKS_UDP"
}

render_isp_config() {
  local port=$1 auth=$2 outbound=$3
  write_common_config "$port" "$auth"
  printf '\noutbounds:\n  - name: %s\n    type: socks5\n    socks5:\n      addr: %s\n      username: %s\n      password: %s\n\n' "$outbound" "$(yaml_quote "$(host_port "$SOCKS_HOST" "$SOCKS_PORT")")" "$(yaml_quote "$SOCKS_USER")" "$(yaml_quote "$SOCKS_PASS")"
  printf 'acl:\n  inline:\n    - %s(all)\n' "$outbound"
}

next_isp_slot() { local i; for i in $(seq 1 20); do [[ -e $NODE_DIR/isp$i.env ]] || { printf '%s' "$i"; return; }; done; die "ISP 节点已达到上限。"; }
create_isp() {
  load_manager
  [[ -r $NODE_DIR/direct.env ]] || legacy_direct_available || die "必须先存在HY2直连节点，才能添加ISP节点。"
  local index id name listen_default listen_port public_port mode auth config service uri_file tmp outbound
  index=$(next_isp_slot); id="isp$index"; name="HY2-ISP-Full-$index"; [[ $index == 1 ]] && name=HY2-ISP-Full
  mode=$NETWORK_MODE; listen_default=$((7443 + index * 1000))
  while true; do
    listen_port=$(ask_valid_port "ISP 全局节点" "VPS 内部 UDP 监听端口" "$listen_default") || return $?
    if node_port_free "$listen_port"; then break; fi
    warn "UDP $listen_port 已占用，请重新输入。"
  done
  if [[ $mode == nat ]]; then
    while true; do
      public_port=$(ask_valid_port "NAT 映射" "服务商控制台的公网 UDP 端口" "") || return $?
      if public_port_free "$public_port"; then break; fi
      warn "公网端口 $public_port 已被其他节点记录，请重新输入。"
    done
  else public_port=$listen_port; fi
  name=$(ask_valid_name "ISP 全局节点" "节点名称" "$name") || return $?
  while true; do
    read_socks || return $?
    if verify_socks; then break; fi
    unset SOCKS_PASS
    confirm "SOCKS5 测试失败，是否重新输入 SOCKS5 信息？选择否将返回主菜单。" || return 0
  done
  auth=$(openssl rand -hex 24); config="$HYSTERIA_DIR/$id.yaml"; service="hy2m-$id.service"; uri_file="$EXPORT_DIR/hy2-$id.txt"; outbound="isp_all_$index"
  tmp=$(mktemp); cleanup_files+=("$tmp")
  render_isp_config "$listen_port" "$auth" "$outbound" >"$tmp"
  install -o root -g hysteria -m 640 "$tmp" "$config"
  printf 'hysteria2://%s@%s:%s/?sni=%s&insecure=0#%s\n' "$auth" "$DOMAIN" "$public_port" "$DOMAIN" "$name" >"$uri_file"; chmod 600 "$uri_file"
  write_service "$service" "HY2 Manager ISP Full Node $index" "$config"; open_firewall "$listen_port" udp
  if ! start_checked "$service" "$listen_port"; then systemctl disable --now "$service" >/dev/null 2>&1 || true; rm -f "$config" "$SERVICE_DIR/$service" "$uri_file"; close_firewall "$listen_port" udp; die "ISP 节点启动失败，已回滚。"; fi
  save_node "$id" isp "$name" "$listen_port" "$public_port" "$service" "$config" "$uri_file" "$mode"
  printf 'SOCKS_EXIT_IP=%q\nSOCKS_UDP=%q\n' "$SOCKS_EXIT_IP" "$SOCKS_UDP" >>"$NODE_DIR/$id.env"
  if [[ $mode == nat ]]; then warn "请确认服务商控制台已有：公网 UDP $public_port → 内部 UDP $listen_port"; fi
  [[ $SOCKS_UDP == supported ]] || warn "该 ISP SOCKS5 不支持 UDP；网页 TCP/HTTPS 通常可用，必须使用 UDP 的应用可能失败。"
  ok "ISP 全局节点已创建；配置只定义 ISP outbound，不会故障回退到 VPS。"
  unset SOCKS_PASS
}

replace_isp() {
  load_manager
  local id=${1:-} f old_name old_listen old_public old_service old_config old_uri old_mode auth outbound tmp backup
  [[ -n $id ]] || id=$(select_node isp) || return $?
  [[ $id =~ ^isp[0-9]+$ && -r $NODE_DIR/$id.env ]] || die "只能选择已存在的 ISP 节点。"
  f="$NODE_DIR/$id.env"
  # shellcheck disable=SC1090
  source "$f"
  old_name=$NAME; old_listen=$LISTEN_PORT; old_public=$PUBLIC_PORT; old_service=$SERVICE; old_config=$CONFIG; old_uri=$URI_FILE; old_mode=$NETWORK_MODE
  auth=$(awk -F'"' '/^[[:space:]]*password:/{print $2; exit}' "$old_config")
  [[ $auth =~ ^[0-9a-f]{48}$ ]] || die "无法安全读取现有 HY2 认证信息。"
  while true; do
    read_socks || return $?
    if verify_socks; then break; fi
    unset SOCKS_PASS
    confirm "SOCKS5 测试失败，是否重新输入？选择否将返回主菜单。" || return 0
  done
  outbound="isp_all_${id#isp}"; tmp=$(mktemp); backup=$(mktemp); cleanup_files+=("$tmp" "$backup")
  render_isp_config "$old_listen" "$auth" "$outbound" >"$tmp"; cp -a "$old_config" "$backup"
  install -o root -g hysteria -m 640 "$tmp" "$old_config"
  if ! start_checked "$old_service" "$old_listen"; then
    warn "新 ISP 配置启动失败，恢复旧配置。"; install -o root -g hysteria -m 640 "$backup" "$old_config"; systemctl restart "$old_service" || true; die "更换失败，旧配置已恢复。"
  fi
  save_node "$id" isp "$old_name" "$old_listen" "$old_public" "$old_service" "$old_config" "$old_uri" "$old_mode"
  printf 'SOCKS_EXIT_IP=%q\nSOCKS_UDP=%q\n' "$SOCKS_EXIT_IP" "$SOCKS_UDP" >>"$f"
  unset SOCKS_PASS
  ok "$old_name 已更换 ISP；HY2 链接和密码保持不变。"
}

recorded_port_free() {
  local port=$1 field=$2 except=${3:-} f
  shopt -s nullglob
  for f in "$NODE_DIR"/*.env; do
    [[ $f != "$NODE_DIR/$except.env" ]] || continue
    if grep -Fxq "$field=$port" "$f"; then return 1; fi
  done
  return 0
}

change_node_port() (
  load_manager
  # Subshell-scoped (not function-local): Bash may unwind locals before an
  # EXIT trap caused by errexit, and rollback must still see this state.
  id=${1:-}; new_listen=""; new_public=""; old_listen=""; old_public=""; work=""
  changed=0; committed=0; new_rule=0
  [[ -n $id ]] || id=$(select_node) || return $?
  [[ $id =~ ^(direct|isp[0-9]+)$ ]] || die "无效节点。"
  load_node "$id"
  [[ $CONFIG == "$HYSTERIA_DIR/$id.yaml" && $URI_FILE == "$EXPORT_DIR/hy2-$id.txt" ]] || die "仅支持管理器标准路径下的节点，未修改配置。"
  old_listen=$LISTEN_PORT; old_public=$PUBLIC_PORT
  while true; do
    new_listen=$(ask_valid_port "修改 $NAME" "内部 UDP 端口" "$old_listen") || return $?
    if [[ $new_listen == "$old_listen" ]] || { node_port_free "$new_listen" "$id"; }; then break; fi
    warn "该端口被服务或其他节点占用。"
  done
  new_public=$new_listen
  if [[ $NETWORK_MODE == nat ]]; then
    while true; do
      new_public=$(ask_valid_port "NAT 映射" "公网 UDP 端口（还需手动修改服务商映射）" "$old_public") || return $?
      recorded_port_free "$new_public" PUBLIC_PORT "$id" && break
      warn "该公网端口已被其他节点记录。"
    done
  fi
  if [[ $new_listen == "$old_listen" && $new_public == "$old_public" ]]; then ok "端口未改变。"; return 0; fi
  confirm "将 $NAME 端口 $old_listen/$old_public 改为 $new_listen/$new_public（内部/公网）？可能短暂断连，客户端需更新链接。" || return 0
  work=$(mktemp -d "$STATE_DIR/.port-change.XXXXXX")
  # Called by EXIT/INT/TERM rather than a direct function invocation.
  # shellcheck disable=SC2317
  port_change_cleanup() {
    local rc=$? restored=1
    trap - EXIT INT TERM
    if ((changed && !committed)); then
      install -o root -g hysteria -m 640 "$work/config.before" "$CONFIG" || restored=0
      install -o root -g root -m 600 "$work/uri.before" "$URI_FILE" || restored=0
      install -o root -g root -m 600 "$work/state.before" "$NODE_DIR/$id.env" || restored=0
      if [[ $new_listen != "$old_listen" ]]; then start_checked "$SERVICE" "$old_listen" || restored=0; fi
      if ((new_rule)); then close_firewall "$new_listen" udp || restored=0; fi
      if ((restored)); then warn "修改未完成，已恢复旧配置和端口。"; else warn "自动恢复未完成，保留备份：$work"; rc=1; fi
    fi
    if ((restored)); then rm -rf -- "$work"; fi
    cleanup
    exit "$rc"
  }
  trap port_change_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  cp -p "$CONFIG" "$work/config.before"
  cp -p "$URI_FILE" "$work/uri.before"
  cp -p "$NODE_DIR/$id.env" "$work/state.before"
  python3 - "$work" "$old_listen" "$new_listen" "$new_public" <<'PY'
from pathlib import Path
import re, sys
from urllib.parse import urlsplit, urlunsplit
root, old, new, public = Path(sys.argv[1]), *sys.argv[2:]
config = (root / 'config.before').read_text(encoding='utf-8')
config, count = re.subn(r'^listen: :' + re.escape(old) + r'[ \t]*$', 'listen: :' + new, config, flags=re.M)
if count != 1:
    raise SystemExit('不支持的监听配置，未修改原文件')
uri = urlsplit((root / 'uri.before').read_text(encoding='utf-8').strip())
if uri.scheme != 'hysteria2' or not uri.hostname or not uri.username:
    raise SystemExit('无法识别节点链接，未修改原文件')
authority = uri.netloc.rsplit(':', 1)[0] + ':' + public
state = (root / 'state.before').read_text(encoding='utf-8')
for field, value in [('LISTEN_PORT', new), ('PUBLIC_PORT', public)]:
    state, count = re.subn(r'^' + field + r'=.*$', field + '=' + value, state, flags=re.M)
    if count != 1:
        raise SystemExit('节点状态字段无效，未修改原文件')
(root / 'config.new').write_text(config, encoding='utf-8', newline='\n')
(root / 'uri.new').write_text(urlunsplit(uri._replace(netloc=authority)) + '\n', encoding='utf-8', newline='\n')
(root / 'state.new').write_text(state, encoding='utf-8', newline='\n')
PY
  changed=1
  if [[ $new_listen != "$old_listen" ]]; then
    if ! grep -Fxq "$new_listen/udp" "$FIREWALL_STATE" 2>/dev/null; then new_rule=1; fi
    open_firewall "$new_listen" udp
  fi
  install -o root -g hysteria -m 640 "$work/config.new" "$CONFIG"
  install -o root -g root -m 600 "$work/uri.new" "$URI_FILE"
  if [[ $new_listen != "$old_listen" ]]; then
    start_checked "$SERVICE" "$new_listen" || die "新端口启动检查失败。"
  fi
  install -o root -g root -m 600 "$work/state.new" "$NODE_DIR/$id.env"
  committed=1
  if [[ $new_listen != "$old_listen" ]]; then close_firewall "$old_listen" udp || warn "旧防火墙规则清理失败，请检查。"; fi
  [[ $NETWORK_MODE != nat ]] || warn "请修改服务商映射：公网 UDP $new_public → 内部 UDP $new_listen。"
  ok "端口已更新，密码及 ISP 凭据保持不变，请重新导入节点链接。"
)

# ---------------- 域名迁移 ----------------
# 0.2 版把 DOMAIN 写进 manager.env 和每个节点链接，换域名只能重装。
# 这里做一次事务：新证书就位 → 重写全部链接 → 重启全部节点；任一步失败整体回滚。
rewrite_node_domain() {
  local check=0 uri_file
  if [[ ${1:-} == --check ]]; then check=1; shift; fi
  uri_file=$1; local old=$2 new=$3 tmp rc
  tmp=$(mktemp); cleanup_files+=("$tmp")
  python3 - "$uri_file" "$old" "$new" >"$tmp" <<'PY'
from pathlib import Path
import sys
from urllib.parse import urlsplit, urlunsplit, parse_qsl, urlencode
path, old, new = Path(sys.argv[1]), sys.argv[2], sys.argv[3]
uri = urlsplit(path.read_text(encoding='utf-8').strip())
if uri.scheme != 'hysteria2' or not uri.hostname or not uri.username:
    raise SystemExit('无法识别节点链接，未修改原文件')
query = [(k, new if k == 'sni' else v) for k, v in parse_qsl(uri.query, keep_blank_values=True)]
if 'sni' not in dict(query):
    raise SystemExit('节点链接缺少 sni 参数，未修改原文件')
credentials = uri.username or ''
if uri.password is not None:
    credentials += ':' + uri.password
authority = credentials + '@' + new + (':' + str(uri.port) if uri.port else '')
print(urlunsplit(uri._replace(netloc=authority, query=urlencode(query))), end='')
PY
  rc=$?
  # 解析失败时 python3 已把原因写到 stderr，这里必须直接放弃，不能覆盖原链接。
  if ((rc != 0)) || [[ ! -s $tmp ]]; then rm -f "$tmp"; return 1; fi
  ((check)) && { rm -f "$tmp"; return 0; }
  install_owned 600 root "$tmp" "$uri_file"
}

# Subshell-scoped so the rollback trap cannot outlive this function's locals.
change_domain() (
  load_manager
  local old=$DOMAIN new="" public_ip cert_mode email token="" work id f u
  local -a node_files=() node_ids=()
  [[ -n $old ]] || die "当前状态没有记录域名，无法迁移。"
  new=$(ask_valid_domain "更换域名" "新域名（Cloudflare 必须灰云，解析需指向本机）" "") || return $?
  [[ $new != "$old" ]] || { ok "域名未改变。"; return 0; }
  if [[ $NETWORK_MODE == normal ]]; then
    if ! public_ip=$(get_public_ipv4); then warn "无法获取公网 IPv4。"; return 1; fi
  else public_ip=$PUBLIC_IP; fi
  check_dns "$new" "$public_ip" || { confirm "DNS 检查失败，仍要继续吗？选择否将放弃迁移。" || return 0; }
  cert_mode=$(choose "证书" "新域名需要重新签发证书" http "HTTP-01（需要公网 80→内部80）" cloudflare "Cloudflare DNS-01（适合 NAT）") || return $?
  [[ $cert_mode == http || $cert_mode == cloudflare ]] || die "证书方式无效。"
  email=$(ask "证书" "Let's Encrypt 邮箱（可以留空）" "") || return $?

  # 签发证书之前就把所有链接校验一遍：畸形或越界的链接必须在这里失败，
  # 否则会在证书已经换掉之后才中断，留下新旧混用的状态。
  shopt -s nullglob
  node_files=("$NODE_DIR"/*.env)
  local -A was_active=()
  local -a link_paths=()
  for f in "${node_files[@]}"; do
    id=$(basename "$f" .env)
    [[ $id =~ ^(direct|isp[0-9]+)$ ]] || { warn "节点文件 $id 不是本管理器创建的，已中止。"; return 1; }
    u=$(env_get "$f" URI_FILE)
    [[ -n $u ]] || { warn "节点 $id 没有记录链接文件，已中止。"; return 1; }
    [[ -f $u && ! -L $u ]] || { warn "节点 $id 的链接文件缺失或不是普通文件，已中止。"; return 1; }
    # Only manager-created export paths are supported, so rollback can restore
    # the exact file instead of guessing by name or glob.
    [[ $u == "$EXPORT_DIR"/* ]] || { warn "节点 $id 的链接文件不在导出目录内，已中止。"; return 1; }
    transaction_path_safe "$EXPORT_DIR" "$u" || { warn "节点 $id 的链接路径不安全，已中止。"; return 1; }
    rewrite_node_domain --check "$u" "$old" "$new" >/dev/null || { warn "节点 $id 的链接无法安全改写，已中止；未做任何修改。"; return 1; }
    # 记下原始运行状态：回滚只恢复原本运行的服务，不擅自拉起已停止的节点。
    was_active[$id]=$(systemctl is-active "$(env_get "$f" SERVICE)" 2>/dev/null || true)
    node_ids+=("$id")
    link_paths+=("$u")
  done
  confirm "将把域名从 $old 迁移到 $new：重新签发证书、重建所有节点链接并重启节点。客户端需要重新导入链接，SSH 不受影响。" || return 0

  work=$(mktemp -d "$STATE_DIR/.domain-change.XXXXXX") || { warn "无法创建迁移快照目录，已中止。"; return 1; }
  local original snapshot i
  # Every snapshot is checked explicitly: this function may run inside if/||,
  # where errexit is disabled and a failed copy would otherwise go unnoticed.
  for f in "${node_files[@]}"; do
    transaction_snapshot_file "$work" "node.${f##*/}" "$f" || { warn "无法备份节点文件：$f；迁移已中止。"; rm -rf -- "$work"; return 1; }
  done
  transaction_snapshot_file "$work" manager.env "$MANAGER_STATE" || { warn "无法备份管理器状态；迁移已中止。"; rm -rf -- "$work"; return 1; }
  for original in "$TLS_DIR/fullchain.pem" "$TLS_DIR/privkey.pem" "$CF_CREDENTIALS" "$RENEWAL_HOOK"; do
    case $original in
      "$TLS_DIR/fullchain.pem") snapshot=fullchain.pem ;;
      "$TLS_DIR/privkey.pem") snapshot=privkey.pem ;;
      "$CF_CREDENTIALS") snapshot=cloudflare.ini ;;
      "$RENEWAL_HOOK") snapshot=renewal-hook ;;
    esac
    transaction_snapshot_file "$work" "$snapshot" "$original" || {
      warn "无法安全备份原文件：$original；迁移已中止。"; rm -rf -- "$work"; return 1; }
  done
  transaction_snapshot_file "$work" firewall.rules "$FIREWALL_STATE" || { warn "无法安全备份防火墙记录；迁移已中止。"; rm -rf -- "$work"; return 1; }
  for ((i = 0; i < ${#link_paths[@]}; i++)); do
    transaction_snapshot_file "$work" "link.$i" "${link_paths[i]}" || { warn "无法备份链接文件：${link_paths[i]}；迁移已中止。"; rm -rf -- "$work"; return 1; }
    printf '%s\n' "${link_paths[i]}" >"$work/link.$i.path" || { warn "无法记录链接路径；迁移已中止。"; rm -rf -- "$work"; return 1; }
  done
  local committed=0 _domain_http80_added=0
  # The nested certificate transaction owns its own scope, so its HTTP rule
  # flag cannot reach us. Re-derive ownership from the ledger we snapshotted.
  domain_stage_owned_http80() {
    [[ -r $FIREWALL_STATE ]] && grep -Fxq '80/tcp' "$FIREWALL_STATE" || return 1
    [[ ! -f $work/firewall.rules.state ]] || ! grep -Fxq '80/tcp' "$work/firewall.rules.state"
  }
  # Called by EXIT/INT/TERM rather than a direct function invocation.
  # shellcheck disable=SC2317
  domain_change_cleanup() {
    local rc=$? restored=1
    trap - EXIT INT TERM
    if ((committed == 0)); then
      local s base target snapshot mode group
      # Revoke an HTTP rule this transaction opened before restoring its ledger;
      # if UFW refuses, keep the record instead of losing track of the open port.
      if ((_domain_http80_added)); then
        if ufw --force delete allow 80/tcp >/dev/null 2>&1; then
          _domain_http80_added=0
          transaction_restore_file "$work" firewall.rules "$FIREWALL_STATE" 600 root || restored=0
        else
          warn "HTTP 80 规则回滚失败，请人工检查 UFW；归属记录已保留。"
          restored=0
        fi
      else
        transaction_restore_file "$work" firewall.rules "$FIREWALL_STATE" 600 root || restored=0
      fi
      for s in "$work"/*.state "$work"/*.absent; do
        [[ -e $s ]] || continue
        base=${s##*/}; base=${base%.*}
        case $base in
          manager.env) target=$MANAGER_STATE; mode=600; group=root ;;
          fullchain.pem) target=$TLS_DIR/fullchain.pem; mode=640; group=hysteria ;;
          privkey.pem) target=$TLS_DIR/privkey.pem; mode=640; group=hysteria ;;
          cloudflare.ini) target=$CF_CREDENTIALS; mode=600; group=root ;;
          renewal-hook) target=$RENEWAL_HOOK; mode=750; group=root ;;
          firewall.rules) continue ;;
          node.*) target=$NODE_DIR/${base#node.}; mode=600; group=root ;;
          link.*) target=$(<"$work/$base.path"); mode=600; group=root ;;
          *) continue ;;
        esac
        transaction_restore_file "$work" "$base" "$target" "$mode" "$group" || restored=0
      done
      for id in "${node_ids[@]}"; do
        [[ ${was_active[$id]} == active ]] || continue
        restart_node_now "$id" >/dev/null 2>&1 || restored=0
      done
      if ((restored)); then warn "域名迁移未完成，已恢复旧域名、旧证书、旧链接和防火墙规则。"
      else warn "域名迁移未完成，自动恢复未完成；恢复材料保留在：$work"; fi
      # 保留 130/143 等信号退出码，让调用方与 systemd 看到真实原因。
      ((rc >= 128)) || rc=1
    fi
    if ((restored)); then rm -rf -- "$work"; fi
    cleanup
    exit "$rc"
  }
  trap domain_change_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  log "签发 $new 的证书……"
  # Issuance and deployment form their own nested transaction: on failure the
  # certificate files, timer and HTTP rule are restored before this function's
  # rollback handles links, state and services.
  local stage_rc=0
  _domain_certificate_stage "$new" "$cert_mode" "$email" || stage_rc=$?
  if ((stage_rc != 0)); then
    # A failed rollback inside the nested transaction leaves the rule recorded;
    # adopt that ownership so our own cleanup still tries to close the port.
    if domain_stage_owned_http80; then _domain_http80_added=1; fi
    ((stage_rc >= 128)) && exit "$stage_rc"
    die "证书签发或部署失败，未做任何修改。"
  fi
  # The nested transaction committed, so its HTTP rule outlives it: adopt it
  # here, otherwise a later failure leaves 80/tcp open after rollback.
  if domain_stage_owned_http80; then _domain_http80_added=1; fi

  for id in "${node_ids[@]}"; do
    u=$(env_get "$NODE_DIR/$id.env" URI_FILE)
    rewrite_node_domain "$u" "$old" "$new" || die "节点 $id 的链接改写失败。"
  done
  write_env "$MANAGER_STATE" INSTALLED_VERSION "$APP_VERSION" DOMAIN "$new" PUBLIC_IP "$public_ip" NETWORK_MODE "$NETWORK_MODE" CERT_MODE "$cert_mode" || die "写入管理器状态失败。"

  local restarted=0
  for id in "${node_ids[@]}"; do
    [[ ${was_active[$id]} == active ]] || continue
    restart_node_now "$id" || die "节点 $id 重启失败。"
    restarted=$((restarted + 1))
  done
  committed=1
  rm -rf -- "$work"
  ok "域名已切换到 $new，重启 $restarted 个运行中的节点；原停止的节点保持停止。请让客户端重新导入链接。"
)

# Render on demand from the current URI: no cached YAML to become stale after
# a port/domain change, rename, restore or deletion. Never read ISP credentials.
render_clash_config() {
  python3 - "$1" "$2" <<'PY'
import json, re, sys
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlsplit

try:
    raw = Path(sys.argv[1]).read_text(encoding='utf-8').strip()
    if any(ord(c) < 32 or ord(c) == 127 for c in raw) or re.search(r'%(?![0-9a-fA-F]{2})', raw):
        raise ValueError('invalid URI encoding')
    uri = urlsplit(raw)
    auth, separator, _ = uri.netloc.rpartition('@')
    if uri.scheme not in ('hysteria2', 'hy2') or not separator or not uri.hostname or uri.path not in ('', '/'):
        raise ValueError('unsupported URI')
    port = uri.port if uri.port is not None else 443
    if not 1 <= port <= 65535:
        raise ValueError('invalid port')
    query = parse_qs(uri.query, keep_blank_values=True, strict_parsing=True, encoding='utf-8', errors='strict')
    # Manager-generated nodes have no obfuscation/pinning options. Reject rather
    # than silently dropping security/transport options from a modified URI.
    if set(query) - {'sni', 'insecure'} or any(len(v) != 1 for v in query.values()):
        raise ValueError('unsupported or duplicate option')
    if query.get('insecure', ['0']) != ['0']:
        raise ValueError('TLS verification must remain enabled')
    name, server = sys.argv[2], uri.hostname
    password = unquote(auth, encoding='utf-8', errors='strict')
    sni = query.get('sni', [server])[0]
    if any(not value or any(ord(c) < 32 or ord(c) == 127 for c in value)
           for value in (name, server, password, sni)) or any(c.isspace() for c in server + sni):
        raise ValueError('empty or unsafe field')
    # Avoid colliding with Mihomo built-ins or the local selector group.
    if name.upper() in {'DIRECT', 'REJECT', 'REJECT-DROP', 'PASS', 'COMPATIBLE', 'GLOBAL'}:
        name = 'HY2-' + name
    group = 'HY2-PROXY'
    while group == name:
        group += '-OUT'
    def quoted(value):
        # ASCII escapes also preserve YAML-sensitive Unicode line separators.
        return json.dumps(value, ensure_ascii=True)
    lines = [
        '# Sensitive HY2 client profile; do not publish or upload to converters.',
        'mixed-port: 7890', 'allow-lan: false', 'mode: rule', 'log-level: info',
        'proxies:', '  - name: ' + quoted(name), '    type: hysteria2',
        '    server: ' + quoted(server), '    port: ' + str(port),
        '    password: ' + quoted(password), '    sni: ' + quoted(sni),
        '    skip-cert-verify: false',
        'proxy-groups:', '  - name: ' + quoted(group), '    type: select',
        '    proxies:', '      - ' + quoted(name),
        'rules:', '  - ' + quoted('MATCH,' + group),
    ]
except (OSError, UnicodeError, ValueError):
    print('无法安全导出：链接无效、TLS 校验被关闭或含不支持的参数；未输出配置。', file=sys.stderr)
    sys.exit(1)
sys.stdout.reconfigure(encoding='utf-8', newline='\n')
sys.stdout.write('\n'.join(lines) + '\n')
PY
}

