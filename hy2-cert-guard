#!/usr/bin/env bash
set -uo pipefail
umask 077

readonly APP_VERSION="0.1.1-dev"
readonly CONFIG_FILE="${HY2CG_CONFIG:-/etc/hy2-cert-guard.conf}"
readonly STATE_DIR="${HY2CG_STATE_DIR:-/var/lib/hy2-cert-guard}"
readonly STATUS_FILE="$STATE_DIR/status"
readonly ALERT_FILE="${HY2CG_ALERT_FILE:-/root/HY2-CERTIFICATE-ALERT.txt}"
readonly HOOK_FILE="${HY2CG_HOOK_FILE:-/etc/letsencrypt/renewal-hooks/deploy/hy2-cert-guard}"
readonly SERVICE_FILE="${HY2CG_SERVICE_FILE:-/etc/systemd/system/hy2-cert-guard.service}"
readonly TIMER_FILE="${HY2CG_TIMER_FILE:-/etc/systemd/system/hy2-cert-guard.timer}"
readonly PROFILE_FILE="${HY2CG_PROFILE_FILE:-/etc/profile.d/hy2-cert-guard.sh}"

DOMAIN=""; EXPECTED_IPV4=""; LIVE_DIR=""; DEPLOY_CERT=""; DEPLOY_KEY=""
SERVICES=""; UDP_PORTS=""; WARN_DAYS=30; FAIL_DAYS=14
AUTO_DISCOVER_MANAGER=1
CERT_MODE=""
declare -A EXPECTED_STOP_BOOT=() MANAGED_SERVICE_PORT=()
passes=0; warnings=0; failures=0; messages=()

if [[ -t 1 ]]; then C_RESET='\033[0m'; C_GREEN='\033[1;32m'; C_YELLOW='\033[1;33m'; C_RED='\033[1;31m'; C_BLUE='\033[1;34m'; else C_RESET=''; C_GREEN=''; C_YELLOW=''; C_RED=''; C_BLUE=''; fi
pass() { passes=$((passes+1)); printf '%b[PASS]%b %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { warnings=$((warnings+1)); messages+=("WARN: $*"); printf '%b[WARN]%b %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
fail() { failures=$((failures+1)); messages+=("FAIL: $*"); printf '%b[FAIL]%b %s\n' "$C_RED" "$C_RESET" "$*"; }
info() { printf '%b[INFO]%b %s\n' "$C_BLUE" "$C_RESET" "$*"; }
die() { printf '%b[错误]%b %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "该操作需要 root。"; }
valid_domain() { [[ $1 =~ ^([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,63}$ ]]; }
valid_ipv4() { local IFS=. a n; read -r -a a <<<"$1"; ((${#a[@]}==4)) || return 1; for n in "${a[@]}"; do [[ $n =~ ^[0-9]{1,3}$ ]] && ((10#$n<=255)) || return 1; done; }
valid_path() { [[ $1 == /* && $1 != *$'\n'* && $1 != *'/../'* && $1 != */.. ]]; }

# One persistent lock inode, outside trees replaced by restore/uninstall.
# The same protocol is used by the standalone guard and generated renewal hook.
with_mutation_lock() (
  local lock_file="${HY2_LOCK_FILE:-/run/lock/hy2-isp-manager.lock}" lock_fd
  local -a lock_args=(-n)
  if [[ ${1:-} == --wait ]]; then lock_args=(-w 300); shift; fi
  command -v flock >/dev/null 2>&1 || { printf '缺少 flock，拒绝无锁修改。\n' >&2; return 1; }
  [[ -d ${lock_file%/*} && ! -L $lock_file ]] || return 1
  exec {lock_fd}>>"$lock_file" || return 1
  flock "${lock_args[@]}" "$lock_fd" || { printf '另一个 HY2 操作正在执行，请稍后重试。\n' >&2; return 75; }
  "$@"
)

trusted_root_file() {
  local owner mode
  [[ -f $1 && ! -L $1 ]] || return 1
  owner=$(stat -c '%u' "$1") || return 1
  mode=$(stat -c '%a' "$1") || return 1
  [[ $owner == 0 && $mode =~ ^[0-7]+$ ]] && (( (8#$mode & 022) == 0 ))
}
manager_node_target() (
  local file=$1 config_dir=$2 id SERVICE="" LISTEN_PORT="" CONFIG="" DESIRED_STATE=running STOP_BOOT_ID=""
  id=${file##*/}; id=${id%.env}
  [[ $id =~ ^(direct|isp[0-9]+)$ ]] || return 1
  trusted_root_file "$file" || return 1
  # Only root-owned manager state is executable shell data.
  # shellcheck disable=SC1090
  source "$file"
  [[ $SERVICE == "hy2m-$id.service" && $CONFIG == "$config_dir/$id.yaml" ]] || return 1
  [[ $LISTEN_PORT =~ ^[0-9]{1,5}$ ]] && ((10#$LISTEN_PORT >= 1 && 10#$LISTEN_PORT <= 65535)) || return 1
  trusted_root_file "$CONFIG" || return 1
  grep -Fxq "  cert: \"$DEPLOY_CERT\"" "$CONFIG" || return 1
  grep -Fxq "  key: \"$DEPLOY_KEY\"" "$CONFIG" || return 1
  grep -Fxq "listen: :$LISTEN_PORT" "$CONFIG" || return 1
  [[ $DESIRED_STATE == running || $DESIRED_STATE == stopped ]] || return 1
  [[ -z $STOP_BOOT_ID || $STOP_BOOT_ID =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || return 1
  printf '%s %s %s %s\n' "$SERVICE" "$LISTEN_PORT" "$DESIRED_STATE" "${STOP_BOOT_ID:--}"
)
refresh_manager_targets() {
  MANAGER_TARGETS=0
  EXPECTED_STOP_BOOT=(); MANAGED_SERVICE_PORT=()
  [[ $AUTO_DISCOVER_MANAGER == 1 ]] || return 0
  local nodes="${HY2CG_MANAGER_NODE_DIR:-/etc/hy2-isp-manager/nodes}"
  local configs="${HY2CG_MANAGER_CONFIG_DIR:-/etc/hysteria-hy2m}" unit file target port desired boot
  local discovered_services=() discovered_ports=()
  # Manual/mixed deployments keep their explicit configuration untouched.
  [[ -d $nodes && $DEPLOY_CERT == "$configs/tls/fullchain.pem" && $DEPLOY_KEY == "$configs/tls/privkey.pem" ]] || return 0
  for unit in $SERVICES; do [[ $unit =~ ^hy2m-(direct|isp[0-9]+)\.service$ ]] || return 0; done
  for file in "$nodes"/*.env; do
    [[ -e $file ]] || continue
    target=$(manager_node_target "$file" "$configs") || die "管理器节点状态无法验证：${file##*/}；未执行证书部署。"
    read -r unit port desired boot <<<"$target"
    discovered_services+=("$unit"); discovered_ports+=("$port")
    MANAGED_SERVICE_PORT[$unit]=$port
    if [[ $desired == stopped && $boot != - ]]; then EXPECTED_STOP_BOOT[$unit]=$boot; fi
  done
  ((${#discovered_services[@]})) || die "没有可验证的管理器节点，拒绝使用过期服务清单。"
  SERVICES="${discovered_services[*]}"; UDP_PORTS="${discovered_ports[*]}"
  refresh_manager_identity "$nodes"
  # Read by install-cert-guard.sh after sourcing this standalone script.
  # shellcheck disable=SC2034
  MANAGER_TARGETS=1
}

# Managed installations have one identity authority. Read literals, never source
# the manager state: this also avoids legacy readonly APP_VERSION assignments.
refresh_manager_identity() {
  local state="${HY2CG_MANAGER_STATE:-${1%/*}/manager.env}" domain ip mode
  trusted_root_file "$state" || die "无法验证管理器域名状态，拒绝使用旧证书配置。"
  domain=$(awk -F= '$1=="DOMAIN" {sub(/^[^=]*=/, ""); print}' "$state")
  ip=$(awk -F= '$1=="PUBLIC_IP" {sub(/^[^=]*=/, ""); print}' "$state")
  mode=$(awk -F= '$1=="CERT_MODE" {sub(/^[^=]*=/, ""); print}' "$state")
  if ! valid_domain "$domain" || ! valid_ipv4 "$ip"; then die "管理器域名或公网地址无效。"; fi
  [[ $mode == http || $mode == cloudflare ]] || die "管理器证书方式无效。"
  DOMAIN=$domain; EXPECTED_IPV4=$ip; CERT_MODE=$mode
  LIVE_DIR="${HY2CG_LETSENCRYPT_DIR:-/etc/letsencrypt}/live/$DOMAIN"
}
renewal_method() {
  if [[ -n $CERT_MODE ]]; then printf '%s' "$CERT_MODE"; return; fi
  local renewal="${HY2CG_LETSENCRYPT_DIR:-/etc/letsencrypt}/renewal/$DOMAIN.conf" auth
  [[ -r $renewal ]] || { printf unknown; return; }
  auth=$(awk -F= '/^[[:space:]]*authenticator[[:space:]]*=/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$renewal")
  case $auth in standalone) printf http ;; dns-*) printf dns ;; *) printf unknown ;; esac
}
check_challenge_access() {
  case $(renewal_method) in
    cloudflare|dns) info "DNS-01 续期，无需开放 TCP 80"; return 0 ;;
    http) ;;
    *) warn "无法确定续期验证方式，跳过 TCP 80 检查；请核对 Certbot renewal 配置。"; return 0 ;;
  esac
  if ss -H -ltn 2>/dev/null | awk '$4 ~ /:80$/ {found=1} END{exit !found}'; then warn "TCP 80当前被进程占用；standalone续期可能需要pre-hook"; else pass "TCP 80空闲，可供Certbot standalone临时监听"; fi
  if command -v ufw >/dev/null 2>&1 && LC_ALL=C ufw status 2>/dev/null | grep -q '^Status: active'; then
    if LC_ALL=C ufw status 2>/dev/null | awk '$1=="80/tcp" && $2=="ALLOW" {found=1} END{exit !found}'; then pass "UFW允许TCP 80"; else fail "UFW启用但未发现80/tcp允许规则"; fi
  else info "UFW未启用；请由服务商防火墙保证TCP 80可达"; fi
}

load_config() {
  [[ -r $CONFIG_FILE ]] || die "配置不存在：$CONFIG_FILE"
  local owner mode
  owner=$(stat -c '%u' "$CONFIG_FILE" 2>/dev/null) || die "无法读取配置所有者。"
  mode=$(stat -c '%a' "$CONFIG_FILE" 2>/dev/null) || die "无法读取配置权限。"
  [[ $owner == 0 ]] || die "配置必须归 root 所有。"
  (( (8#$mode & 022) == 0 )) || die "配置不能允许组或其他用户写入。"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  valid_domain "$DOMAIN" || die "配置中的 DOMAIN 无效。"
  [[ -z $EXPECTED_IPV4 ]] || valid_ipv4 "$EXPECTED_IPV4" || die "配置中的 EXPECTED_IPV4 无效。"
  if ! valid_path "$LIVE_DIR" || ! valid_path "$DEPLOY_CERT" || ! valid_path "$DEPLOY_KEY"; then die "证书路径无效。"; fi
  [[ $WARN_DAYS =~ ^[0-9]+$ && $FAIL_DAYS =~ ^[0-9]+$ ]] || die "告警天数无效。"
  ((WARN_DAYS > FAIL_DAYS && FAIL_DAYS > 0)) || die "必须满足 WARN_DAYS > FAIL_DAYS > 0。"
  local unit port
  for unit in $SERVICES; do [[ $unit =~ ^[A-Za-z0-9_.@-]+\.service$ ]] || die "服务名无效：$unit"; done
  for port in $UDP_PORTS; do if [[ ! $port =~ ^[0-9]+$ ]] || ((10#$port<1 || 10#$port>65535)); then die "UDP端口无效：$port"; fi; done
  refresh_manager_targets
}

cert_pub_hash() { openssl x509 -in "$1" -pubkey -noout 2>/dev/null | openssl pkey -pubin -outform DER 2>/dev/null | sha256sum | awk '{print $1}'; }
key_pub_hash() { openssl pkey -in "$1" -pubout -outform DER 2>/dev/null | sha256sum | awk '{print $1}'; }
cert_pair_matches() { local a b; a=$(cert_pub_hash "$1") || return 1; b=$(key_pub_hash "$2") || return 1; [[ -n $a && $a == "$b" ]]; }
cert_fingerprint() { openssl x509 -in "$1" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2; }
cert_days_left() { local end now; end=$(openssl x509 -in "$1" -noout -enddate 2>/dev/null | cut -d= -f2-) || return 1; [[ -n $end ]] || return 1; end=$(date -d "$end" +%s 2>/dev/null) || return 1; now=$(date +%s); printf '%d' "$(( (end-now) / 86400 ))"; }
cert_has_domain() {
  local verdict
  verdict=$(LC_ALL=C openssl x509 -in "$1" -noout -checkhost "$2" 2>/dev/null) || return 1
  [[ $verdict == "Hostname $2 does match certificate" ]]
}

write_result() {
  local state=$1 days=$2 expiry=$3 timer=$4 services=$5 service_details=$6 tmp
  install -d -o root -g root -m 755 "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.status.XXXXXX") || return 1
  {
    printf 'STATE=%q\n' "$state"
    printf 'CHECKED_AT=%q\n' "$(date -Is)"
    printf 'DOMAIN=%q\n' "$DOMAIN"
    printf 'DAYS_LEFT=%q\n' "$days"
    printf 'EXPIRES_AT=%q\n' "$expiry"
    printf 'CERTBOT_TIMER=%q\n' "$timer"
    printf 'SERVICES_STATE=%q\n' "$services"
    printf 'SERVICE_DETAILS=%q\n' "$service_details"
    printf 'PASS_COUNT=%q\nWARN_COUNT=%q\nFAIL_COUNT=%q\n' "$passes" "$warnings" "$failures"
  } >"$tmp"
  chmod 644 "$tmp"; mv -f "$tmp" "$STATUS_FILE"
  if [[ $state == FAIL ]]; then
    {
      printf 'HY2 CERTIFICATE ALERT\nChecked: %s\nDomain: %s\nDays left: %s\n\n' "$(date -Is)" "$DOMAIN" "$days"
      printf '%s\n' "${messages[@]}"
      printf '\nRun: hy2-cert-guard check\nLogs: journalctl -u hy2-cert-guard.service\n'
    } >"$ALERT_FILE"
    chmod 600 "$ALERT_FILE"
  else
    rm -f "$ALERT_FILE"
  fi
}

resolve_ipv4() {
  if command -v dig >/dev/null 2>&1; then dig +short A "$1" | sort -u
  else getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}' | sort -u
  fi
}

current_boot_id() {
  local boot
  read -r boot </proc/sys/kernel/random/boot_id || return 1
  [[ $boot =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]] || return 1
  printf '%s' "$boot"
}
service_intentionally_stopped() {
  local boot
  [[ $2 == inactive && -n ${EXPECTED_STOP_BOOT[$1]:-} ]] || return 1
  boot=$(current_boot_id) || return 1
  [[ -n $boot && ${EXPECTED_STOP_BOOT[$1]} == "$boot" ]]
}

check_all() {
  require_root; load_config
  passes=0; warnings=0; failures=0; messages=()
  local live_cert="$LIVE_DIR/fullchain.pem" live_key="$LIVE_DIR/privkey.pem" days="unknown" expiry="unknown" timer_state="unknown" services_state="ok"
  printf 'HY2 Certificate Guard %s\n时间: %s\n\n' "$APP_VERSION" "$(date -Is)"

  if [[ -r $live_cert && -r $live_key ]]; then pass "Let’s Encrypt证书和私钥存在"; else fail "Let’s Encrypt证书或私钥缺失：$LIVE_DIR"; fi
  if [[ -r $live_cert ]]; then
    if cert_has_domain "$live_cert" "$DOMAIN"; then pass "证书包含域名 $DOMAIN"; else fail "证书不包含域名 $DOMAIN"; fi
    days=$(cert_days_left "$live_cert" 2>/dev/null || printf unknown)
    expiry=$(openssl x509 -in "$live_cert" -noout -enddate 2>/dev/null | cut -d= -f2-)
    if [[ $days =~ ^-?[0-9]+$ ]]; then
      if ((days < FAIL_DAYS)); then fail "证书仅剩 $days 天"; elif ((days < WARN_DAYS)); then warn "证书剩余 $days 天；是否到续期时间由 Certbot/CA 决定，此提示不代表续期失败"; else pass "证书剩余 $days 天"; fi
    else fail "无法读取证书有效期"; fi
  fi
  if [[ -r $live_cert && -r $live_key ]] && cert_pair_matches "$live_cert" "$live_key"; then pass "Let’s Encrypt证书与私钥匹配"; else fail "Let’s Encrypt证书与私钥不匹配"; fi
  if [[ -r $DEPLOY_CERT && -r $DEPLOY_KEY ]]; then pass "HY2部署证书和私钥存在"; else fail "HY2部署证书或私钥缺失"; fi
  if id hysteria >/dev/null 2>&1; then
    if runuser -u hysteria -- test -r "$DEPLOY_CERT" && runuser -u hysteria -- test -r "$DEPLOY_KEY"; then pass "hysteria用户可以读取部署证书"; else fail "hysteria用户无法读取部署证书或目录"; fi
  else warn "没有hysteria用户，无法执行证书读取权限检查"; fi
  if [[ -r $DEPLOY_CERT && -r $DEPLOY_KEY ]] && cert_pair_matches "$DEPLOY_CERT" "$DEPLOY_KEY"; then pass "HY2部署证书与私钥匹配"; else fail "HY2部署证书与私钥不匹配"; fi
  if [[ -r $live_cert && -r $DEPLOY_CERT ]] && [[ $(cert_fingerprint "$live_cert") == "$(cert_fingerprint "$DEPLOY_CERT")" ]]; then pass "Let’s Encrypt证书与HY2部署证书一致"; else fail "Let’s Encrypt证书与HY2部署证书不一致"; fi

  if systemctl is-enabled --quiet certbot.timer 2>/dev/null && systemctl is-active --quiet certbot.timer 2>/dev/null; then timer_state=active; pass "certbot.timer 已启用并运行"; else timer_state=failed; fail "certbot.timer 未同时处于 enabled/active"; fi
  next_run=$(systemctl show certbot.timer -p NextElapseUSecRealtime --value 2>/dev/null || true); [[ -n $next_run ]] && info "Certbot下次计划: $next_run"

  resolved=$(resolve_ipv4 "$DOMAIN")
  if [[ -z $EXPECTED_IPV4 ]]; then warn "未配置 EXPECTED_IPV4；当前解析：${resolved:-none}"
  elif grep -Fxq "$EXPECTED_IPV4" <<<"$resolved"; then pass "域名解析包含 $EXPECTED_IPV4"; else fail "域名未解析到 $EXPECTED_IPV4（当前：${resolved:-none}）"; fi
  check_challenge_access

  local unit enabled active service_summary=()
  local -A stopped_ports=()
  for unit in $SERVICES; do
    active=$(systemctl is-active "$unit" 2>/dev/null || true); enabled=$(systemctl is-enabled "$unit" 2>/dev/null || true)
    service_summary+=("$unit:$active/$enabled")
    if [[ $active == active ]]; then pass "$unit 正在运行"
    elif service_intentionally_stopped "$unit" "$active"; then
      pass "$unit 本次开机期间已主动停用"
      if [[ -n ${MANAGED_SERVICE_PORT[$unit]:-} ]]; then stopped_ports[${MANAGED_SERVICE_PORT[$unit]}]=1; fi
    else fail "$unit 未运行（$active）"; services_state=failed; fi
    case $enabled in enabled|enabled-runtime|static) pass "$unit 启动状态: $enabled" ;; *) warn "$unit 启动状态: ${enabled:-unknown}" ;; esac
  done
  listeners=$(ss -H -lun 2>/dev/null || true)
  local port
  for port in $UDP_PORTS; do
    [[ ${stopped_ports[$port]:-0} == 1 ]] && continue
    if awk -v p=":$port" '$4 ~ (p "$" ) {found=1} END{exit !found}' <<<"$listeners"; then pass "UDP $port 正在监听"; else fail "UDP $port 未监听"; services_state=failed; fi
  done

  local final=OK
  ((failures > 0)) && final=FAIL
  if ((failures == 0 && warnings > 0)); then final=WARN; fi
  write_result "$final" "$days" "$expiry" "$timer_state" "$services_state" "${service_summary[*]}" || return 1
  printf '\nPASS=%d WARN=%d FAIL=%d\n' "$passes" "$warnings" "$failures"
  printf '状态: %s；证书剩余: %s 天；到期: %s\n' "$final" "$days" "$expiry"
  ((failures == 0))
}

status_cmd() {
  if [[ ! -r $STATUS_FILE ]]; then printf '尚无状态记录，请运行：sudo hy2-cert-guard check\n'; return 1; fi
  # shellcheck disable=SC1090
  source "$STATUS_FILE"
  printf 'HY2证书：%s｜域名：%s｜剩余：%s天｜Certbot：%s｜检查：%s\n' "${STATE:-unknown}" "${DOMAIN:-unknown}" "${DAYS_LEFT:-unknown}" "${CERTBOT_TIMER:-unknown}" "${CHECKED_AT:-unknown}"
  [[ ${STATE:-FAIL} != FAIL ]]
}

# Refuse symlinked deployment targets/ancestors; ACME source symlinks remain valid.
deploy_path_safe() {
  local path=$1
  valid_path "$path" || return 1
  [[ ! -e $path || -f $path ]] || return 1
  while [[ $path != / ]]; do
    [[ ! -L $path ]] || return 1
    path=${path%/*}; [[ -n $path ]] || path=/
  done
}
deploy_cert() (
  require_root; load_config
  lineage=${RENEWED_LINEAGE:-${1:-$LIVE_DIR}}
  if [[ -n ${RENEWED_DOMAINS:-} ]]; then case " $RENEWED_DOMAINS " in *" $DOMAIN "*) ;; *) info "本次续期不包含 $DOMAIN，跳过。"; return 0 ;; esac; fi
  # A stale old-domain hook must never publish into a newly migrated manager.
  [[ $lineage == "$LIVE_DIR" ]] || { warn "续期 lineage 与当前域名不一致，未部署。"; return 1; }
  cert="$lineage/fullchain.pem"; key="$lineage/privkey.pem"
  [[ -r $cert && -r $key && $DEPLOY_CERT != "$DEPLOY_KEY" ]] || return 1
  if ! cert_has_domain "$cert" "$DOMAIN" || ! cert_pair_matches "$cert" "$key" ||
    ! openssl x509 -in "$cert" -noout -checkend 0 >/dev/null 2>&1; then
    warn "证书域名、有效期或密钥校验失败。"; return 1
  fi
  deploy_path_safe "$DEPLOY_CERT" && deploy_path_safe "$DEPLOY_KEY" || return 1
  backup=""; cert_tmp=""; key_tmp=""; changed=0; committed=0
  active_units=()
  # Snapshot exact runtime intent before any file publication.
  for unit in $SERVICES; do
    state=$(systemctl is-active "$unit" 2>/dev/null) || true
    case $state in active) active_units+=("$unit") ;; inactive|failed) ;; *) warn "服务状态不稳定：$unit ($state)"; return 1 ;; esac
  done
  install -d -o root -g root -m 700 "$STATE_DIR/deploy-backups" || return 1
  backup=$(mktemp -d "$STATE_DIR/deploy-backups/deploy.XXXXXXXX") || return 1
  # Trap state is subshell-scoped, so it survives return/errexit unwinding.
  # shellcheck disable=SC2317
  deploy_cleanup() {
    local rc=$? restored=1 target name unit
    trap - EXIT; trap '' INT TERM
    if ((changed && !committed)); then
      for name in fullchain privkey; do
        if [[ $name == fullchain ]]; then target=$DEPLOY_CERT; else target=$DEPLOY_KEY; fi
        if [[ -f $backup/$name.before ]]; then
          cp -p -- "$backup/$name.before" "$target" || restored=0
        elif [[ -f $backup/$name.absent ]]; then
          rm -f -- "$target" || restored=0
        else restored=0; fi
      done
      for unit in "${active_units[@]}"; do
        systemctl restart "$unit" >/dev/null 2>&1 || restored=0
        systemctl is-active --quiet "$unit" >/dev/null 2>&1 || restored=0
      done
      if ((restored)); then warn "证书部署失败，已恢复原证书和原运行节点。"
      else warn "证书回滚未完全成功，恢复材料保留在：$backup"; fi
      ((rc != 0)) || rc=1
    fi
    [[ -z $cert_tmp ]] || rm -f -- "$cert_tmp"
    [[ -z $key_tmp ]] || rm -f -- "$key_tmp"
    exit "$rc"
  }
  trap deploy_cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  for name in fullchain privkey; do
    if [[ $name == fullchain ]]; then target=$DEPLOY_CERT; else target=$DEPLOY_KEY; fi
    if [[ -e $target ]]; then cp -p -- "$target" "$backup/$name.before" || return 1
    else : >"$backup/$name.absent" || return 1; fi
  done
  cert_dir=${DEPLOY_CERT%/*}; key_dir=${DEPLOY_KEY%/*}
  [[ -d $cert_dir ]] || install -d -o root -g hysteria -m 750 "$cert_dir" || return 1
  [[ -d $key_dir ]] || install -d -o root -g hysteria -m 750 "$key_dir" || return 1
  cert_tmp=$(mktemp "$cert_dir/.fullchain.XXXXXXXX") || return 1
  key_tmp=$(mktemp "$key_dir/.privkey.XXXXXXXX") || return 1
  install -o root -g hysteria -m 640 "$cert" "$cert_tmp" || return 1
  install -o root -g hysteria -m 640 "$key" "$key_tmp" || return 1
  cert_pair_matches "$cert_tmp" "$key_tmp" || return 1
  runuser -u hysteria -- test -r "$cert_tmp" && runuser -u hysteria -- test -r "$key_tmp" || return 1
  changed=1
  mv -f -- "$cert_tmp" "$DEPLOY_CERT" || return 1
  mv -f -- "$key_tmp" "$DEPLOY_KEY" || return 1
  for unit in "${active_units[@]}"; do
    systemctl try-restart "$unit" >/dev/null 2>&1 || return 1
  done
  for unit in "${active_units[@]}"; do
    healthy=0
    for ((attempt=0; attempt<20; attempt++)); do
      if systemctl is-active --quiet "$unit" >/dev/null 2>&1; then healthy=1; break; fi
      sleep 1
    done
    ((healthy)) || return 1
  done
  committed=1
  info "证书部署完成，原停止节点保持停止；备份：$backup"
)

# Atomic publication for generated unit/hook/profile files. The caller holds
# the shared lock; readers can only observe the complete old or new file.
publish_guard_file() {
  local mode=$1 target=$2 tmp
  deploy_path_safe "$target" || return 1
  tmp=$(mktemp "${target%/*}/.guard.XXXXXXXX") || return 1
  if ! cat >"$tmp" || ! chmod "$mode" "$tmp" || ! mv -f -- "$tmp" "$target"; then
    rm -f -- "$tmp"; return 1
  fi
}

install_system() {
  require_root; load_config
  install -d -o root -g root -m 755 "$STATE_DIR" "${HOOK_FILE%/*}" || return 1
  publish_guard_file 644 "$SERVICE_FILE" <<EOF || return 1
[Unit]
Description=HY2 certificate and renewal health check
After=network-online.target certbot.timer
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hy2-cert-guard check
EOF
  publish_guard_file 644 "$TIMER_FILE" <<'EOF' || return 1
[Unit]
Description=Daily HY2 certificate health check

[Timer]
OnCalendar=daily
RandomizedDelaySec=2h
Persistent=true
Unit=hy2-cert-guard.service

[Install]
WantedBy=timers.target
EOF
  publish_guard_file 755 "$HOOK_FILE" <<'EOF' || return 1
#!/usr/bin/env bash
set -Eeuo pipefail
exec /usr/local/sbin/hy2-cert-guard deploy
EOF
  publish_guard_file 644 "$PROFILE_FILE" <<'EOF' || return 1
#!/usr/bin/env bash
[[ $- == *i* && -r /var/lib/hy2-cert-guard/status ]] || return 0
# shellcheck disable=SC1091
source /var/lib/hy2-cert-guard/status
if [[ ${STATE:-FAIL} == FAIL ]]; then
  printf '\033[1;31mHY2证书：异常｜剩余：%s天｜运行 sudo hy2-cert-guard check\033[0m\n' "${DAYS_LEFT:-unknown}"
else
  printf 'HY2证书：%s｜剩余：%s天｜自动续期：%s｜服务：%s\n' "${STATE:-unknown}" "${DAYS_LEFT:-unknown}" "${CERTBOT_TIMER:-unknown}" "${SERVICES_STATE:-unknown}"
fi
EOF
  systemctl daemon-reload || return 1
  systemctl enable --now hy2-cert-guard.timer >/dev/null || return 1
  if ! check_all; then warn "首次证书健康检查失败，请运行 hy2-cert-guard check。"; return 1; fi
  info "已安装每日检查、Certbot部署钩子和SSH登录提示。"
}

dry_run() { require_root; load_config; command -v certbot >/dev/null 2>&1 || die "缺少 certbot"; info "使用Let’s Encrypt staging执行续期演练，不运行生产部署钩子。"; certbot renew --cert-name "$DOMAIN" --dry-run; }
logs_cmd() { journalctl -u hy2-cert-guard.service -u certbot.service --no-pager -n "${1:-100}"; }

uninstall_system() {
  require_root
  systemctl disable --now hy2-cert-guard.timer >/dev/null 2>&1 || true
  rm -f "$SERVICE_FILE" "$TIMER_FILE" "$HOOK_FILE" "$PROFILE_FILE"
  systemctl daemon-reload
  info "已卸载定时器、部署钩子和登录提示；配置、状态、告警及证书备份被保留。"
}

usage() {
  cat <<EOF
HY2 Certificate Guard $APP_VERSION
用法：
  sudo hy2-cert-guard check
  hy2-cert-guard status
  sudo hy2-cert-guard deploy [lineage]
  sudo hy2-cert-guard dry-run
  sudo hy2-cert-guard install-system
  hy2-cert-guard logs [lines]
  sudo hy2-cert-guard uninstall-system
EOF
}

main() {
  case ${1:-status} in
    check) with_mutation_lock --wait check_all ;; status) status_cmd ;; deploy) shift; with_mutation_lock --wait deploy_cert "${1:-}" ;; dry-run) dry_run ;; install-system) with_mutation_lock install_system ;; logs) logs_cmd "${2:-100}" ;; uninstall-system) with_mutation_lock uninstall_system ;; version|--version) printf '%s\n' "$APP_VERSION" ;; help|-h|--help) usage ;; *) usage; exit 2 ;;
  esac
}

if [[ ${HY2CG_SOURCE_ONLY:-0} != 1 ]]; then main "$@"; fi
